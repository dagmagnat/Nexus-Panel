function setupMobileDashboardTabs() {
  const source = document.querySelector('.desktop-page-tabs[data-page-tabs="dashboard"]');
  const mobile = document.getElementById('mobileDashboardTabs');
  if (!source || !mobile) return;
  const mobileButtons = new Map(Array.from(mobile.querySelectorAll('[data-mobile-dashboard-tab]')).map(btn => [btn.dataset.mobileDashboardTab, btn]));
  Array.from(source.querySelectorAll('[data-tab-target]')).forEach(sourceButton => {
    const mobileButton = mobileButtons.get(sourceButton.dataset.tabTarget);
    if (mobileButton) mobile.appendChild(mobileButton);
  });
  const sync = () => {
    Array.from(source.querySelectorAll('[data-tab-target]')).forEach(sourceButton => {
      const mobileButton = mobileButtons.get(sourceButton.dataset.tabTarget);
      if (mobileButton) mobile.appendChild(mobileButton);
    });
    const active = source.querySelector('[data-tab-target].is-active')?.dataset.tabTarget || '';
    mobile.querySelectorAll('[data-mobile-dashboard-tab]').forEach(btn => {
      const selected = btn.dataset.mobileDashboardTab === active;
      btn.classList.toggle('is-active', selected);
      btn.setAttribute('aria-pressed', selected ? 'true' : 'false');
    });
  };
  mobile.addEventListener('click', event => {
    const button = event.target.closest('[data-mobile-dashboard-tab]');
    if (!button) return;
    event.preventDefault();
    const target = button.dataset.mobileDashboardTab || '';
    const sourceButton = Array.from(source.querySelectorAll('[data-tab-target]')).find(btn => btn.dataset.tabTarget === target);
    if (sourceButton) sourceButton.click();
    sync();
  });
  new MutationObserver(sync).observe(source, { subtree: true, childList: true, attributes: true, attributeFilter: ['class'] });
  setTimeout(sync, 0);
}

