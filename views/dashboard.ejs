let onlineClientsRefreshPending = false;
let onlineClientsAutoTimer = null;
let dashboardNodeRefreshPending = false;
let dashboardLastHealthNotice = '';

function notifyDashboardHealthOnce(message){
  const text = String(message || '').trim();
  if (!text || text === dashboardLastHealthNotice) return;
  dashboardLastHealthNotice = text;
  if (typeof window.showNexusNotice === 'function') window.showNexusNotice(text, 'err');
}

function renderDashboardHealth(data){
  const checks = Array.isArray(data.checks) ? data.checks : [];
  const failed = checks.filter(item => item.status === 'offline');
  const online = checks.filter(item => item.status === 'online').length;
  const offline = failed.length;
  const onlineBox = document.getElementById('dashboardNodesOnlineCount');
  const offlineBox = document.getElementById('dashboardNodesOfflineCount');
  if (onlineBox) onlineBox.textContent = String(online);
  if (offlineBox) offlineBox.textContent = String(offline);

  const nodeHealth = document.getElementById('dashboardNodesHealth');
  const nodeLabel = document.getElementById('dashboardNodesHealthLabel');
  const nodeSummary = document.getElementById('dashboardNodesHealthSummary');
  const nodeIssues = document.getElementById('dashboardNodeIssues');
  if (nodeHealth) nodeHealth.dataset.state = failed.length ? 'error' : 'ok';
  if (nodeLabel) nodeLabel.textContent = failed.length ? 'Ошибка' : 'Работают';
  if (nodeSummary) nodeSummary.textContent = failed.length ? `Не отвечают: ${failed.length}` : `В сети: ${online}`;
  if (nodeIssues) {
    nodeIssues.hidden = failed.length === 0;
    nodeIssues.innerHTML = failed.slice(0, 4).map(item => {
      const error = typeof window.nexusHumanizeError === 'function' ? window.nexusHumanizeError(item.error || '') : String(item.error || 'Узел не отвечает');
      return `<a href="${escapeHtml(item.editUrl || '/nodes')}" title="${escapeHtml(error)}"><b>${escapeHtml(item.title || 'Узел')}</b><span>${escapeHtml(error)}</span></a>`;
    }).join('');
  }

  const redirect = data.redirect || {};
  const redirectHealth = document.getElementById('dashboardRedirectHealth');
  const redirectLabel = document.getElementById('dashboardRedirectHealthLabel');
  const redirectSummary = document.getElementById('dashboardRedirectHealthSummary');
  const redirectError = redirect.configured && redirect.ok === false;
  if (redirectHealth) redirectHealth.dataset.state = redirectError ? 'error' : (redirect.configured ? 'ok' : 'idle');
  if (redirectLabel) redirectLabel.textContent = redirect.statusLabel || (redirectError ? 'Ошибка' : 'Работает');
  if (redirectSummary) redirectSummary.textContent = redirect.message || 'Активных правил нет';

  const noticeParts = failed.map(item => `${item.title}: ${item.error || 'узел не отвечает'}`);
  if (redirectError) noticeParts.push(`Перенаправление: ${redirect.message || 'helper не подтвердил правила'}`);
  if (noticeParts.length) notifyDashboardHealthOnce(noticeParts.join(' · '));
  else dashboardLastHealthNotice = '';
}

async function refreshDashboardNodeCounts() {
  if (dashboardNodeRefreshPending || document.hidden) return;
  dashboardNodeRefreshPending = true;
  try {
    const response = await fetch('/dashboard/node-status.json', { headers: { Accept: 'application/json' }, cache: 'no-store' });
    const data = await response.json();
    if (!response.ok || !data.ok) throw new Error(data.error || 'Ошибка проверки узлов');
    renderDashboardHealth(data);
  } catch (err) {
    console.warn('Автопроверка узлов на главной:', err);
    const message = typeof window.nexusHumanizeError === 'function' ? window.nexusHumanizeError(err) : String(err.message || err);
    const nodeHealth = document.getElementById('dashboardNodesHealth');
    const nodeLabel = document.getElementById('dashboardNodesHealthLabel');
    const nodeSummary = document.getElementById('dashboardNodesHealthSummary');
    if (nodeHealth) nodeHealth.dataset.state = 'error';
    if (nodeLabel) nodeLabel.textContent = 'Ошибка';
    if (nodeSummary) nodeSummary.textContent = message;
    notifyDashboardHealthOnce(message);
  } finally {
    dashboardNodeRefreshPending = false;
  }
}

async function refreshOnlineClients() {
  const btn = document.getElementById('onlineRefreshBtn');
  const status = document.getElementById('onlineClientsStatus');
  if (onlineClientsRefreshPending) return;
  onlineClientsRefreshPending = true;
  try {
    if (btn) btn.disabled = true;
    if (status) status.textContent = 'Обновляю онлайн-клиентов...';
    const response = await fetch('/dashboard/online-clients.json', { headers: { 'Accept': 'application/json' } });
    const data = await response.json();
    if (!response.ok || !data.ok) throw new Error(data.error || 'Ошибка загрузки онлайн-клиентов');
    renderOnlineClients(data);
    const onlineCount = document.getElementById('dashboardOnlineNowCount');
    if (onlineCount) onlineCount.textContent = String(Array.isArray(data.clients) ? data.clients.length : 0);
  } catch (err) {
    const message = typeof window.nexusHumanizeError === 'function' ? window.nexusHumanizeError(err) : String(err.message || err);
    if (status) status.textContent = 'Ошибка: ' + message;
    if (typeof window.showNexusNotice === 'function') window.showNexusNotice(message, 'err');
  } finally {
    if (btn) btn.disabled = false;
    onlineClientsRefreshPending = false;
  }
}

function configureOnlineClientsAutoRefresh() {
  const toggle = document.getElementById('onlineAutoRefresh');
  const select = document.getElementById('onlineRefreshInterval');
  if (!toggle || !select) return;
  if (onlineClientsAutoTimer) window.clearInterval(onlineClientsAutoTimer);
  onlineClientsAutoTimer = null;
  select.disabled = !toggle.checked;
  try {
    localStorage.setItem('nexus.dashboard.onlineAuto', toggle.checked ? '1' : '0');
    localStorage.setItem('nexus.dashboard.onlineInterval', String(select.value || '10'));
  } catch (_) {}
  if (!toggle.checked) return;
  const seconds = [10, 30, 60].includes(Number(select.value)) ? Number(select.value) : 10;
  onlineClientsAutoTimer = window.setInterval(() => {
    if (!document.hidden) refreshOnlineClients();
  }, seconds * 1000);
