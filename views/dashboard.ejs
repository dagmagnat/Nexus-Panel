  fetch('/dashboard/traffic-series.json?days=' + days, { headers: { 'Accept': 'application/json' } })
    .then(r => r.json())
    .then(data => {
      if (!data || !data.ok || !Array.isArray(data.series)) throw new Error('bad data');
      if (totalEl && data.totalText) totalEl.textContent = data.totalText;
      const series = data.series;
      const values = series.map(p => Math.max(0, Number(p.gb || 0)));
      const nonZero = values.filter(v => v > 0).length;
      if (series.length < 2 || nonZero < 2) { if (emptyEl) emptyEl.hidden = false; return; }
      const W = 640, chartH = 140, padT = 8, svgH = 160, axisY = 156;
      const maxV = Math.max.apply(null, values) || 1;
      const stepX = W / (series.length - 1);
      const y = v => padT + (chartH - padT) * (1 - v / maxV);
      let line = '';
      series.forEach((p, i) => { line += (i ? ' ' : '') + (i * stepX).toFixed(1) + ',' + y(values[i]).toFixed(1); });
      const area = '0,' + chartH + ' ' + line + ' ' + W + ',' + chartH;
      const lastX = ((series.length - 1) * stepX).toFixed(1);
      const lastY = y(values[values.length - 1]).toFixed(1);
      const midY = (padT + (chartH - padT) / 2).toFixed(1);
      function fmtDay(d) { const m = String(d || '').split('-'); return m.length === 3 ? (m[2] + '.' + m[1]) : ''; }
      const midIdx = Math.floor((series.length - 1) / 2);
      box.innerHTML = '<svg viewBox="0 0 ' + W + ' ' + svgH + '" role="img" aria-label="Скачанный трафик по дням">' +
        '<line class="agg-gline" x1="0" y1="' + midY + '" x2="' + W + '" y2="' + midY + '"/>' +
        '<line class="agg-gline" x1="0" y1="' + chartH + '" x2="' + W + '" y2="' + chartH + '"/>' +
        '<polygon class="agg-area" points="' + area + '"/>' +
        '<polyline class="agg-line" points="' + line + '"/>' +
        '<circle class="agg-dot" r="3.4" cx="' + lastX + '" cy="' + lastY + '"/>' +
        '<text class="agg-ax" x="0" y="' + axisY + '">' + fmtDay(series[0].d) + '</text>' +
        '<text class="agg-ax" x="' + (midIdx * stepX).toFixed(1) + '" y="' + axisY + '" text-anchor="middle">' + fmtDay(series[midIdx].d) + '</text>' +
        '<text class="agg-ax" x="' + W + '" y="' + axisY + '" text-anchor="end">' + fmtDay(series[series.length - 1].d) + '</text>' +
        '</svg>';
    })
    .catch(() => { if (emptyEl) emptyEl.hidden = false; });
})();

</script>

<script>
/* Resilient dashboard search.
 * Runs in its OWN <script> so any error in the main dashboard script above
 * cannot stop it. Live-filters on typing; the single custom × resets the
 * field and shows everyone again. */
(function () {
  function norm(v) {
    return String(v || '').toLocaleLowerCase('ru-RU').replace(/ё/g, 'е').replace(/\s+/g, ' ').trim();
  }
  function wire(inputId, clearId, itemSel, countId) {
    try {
      var input = document.getElementById(inputId);
      if (!input) return;
      var clearBtn = document.getElementById(clearId);
      var countEl = countId ? document.getElementById(countId) : null;
      function apply() {
        var q = norm(input.value);
        var items = document.querySelectorAll(itemSel);
        var shown = 0;
        items.forEach(function (row) {
          var match = !q || norm(row.getAttribute('data-search-text') || row.dataset.searchText || '').indexOf(q) !== -1;
          row.classList.toggle('is-dashboard-search-hidden', !match);
          row.hidden = !match;
          row.setAttribute('aria-hidden', match ? 'false' : 'true');
          if (match) shown++;
        });
        if (countEl) countEl.textContent = String(shown);
        if (clearBtn) clearBtn.hidden = !q;
      }
      function reset() { input.value = ''; apply(); input.focus(); }
      input.addEventListener('input', apply);
      if (clearBtn) clearBtn.addEventListener('click', function (e) { e.preventDefault(); reset(); });
      apply();
    } catch (_) { /* never let search break the page */ }
  }
  function init() {
    wire('expiryClientSearch', 'expiryClientSearchClear', '#expiryList [data-dashboard-search-item]', 'expiryVisibleCount');
    wire('limitClientSearch', 'limitClientSearchClear', '[data-limit-search-item]', null);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>

