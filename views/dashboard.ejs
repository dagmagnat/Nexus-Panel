<%- include('partials_header', { pageTitle: 'Главная', pageSubtitle: 'Клиенты, сроки, онлайн и лимиты', activePage: 'dashboard' }) %>
<%
  function daysLeft(ts) {
    const n = Number(ts || 0);
    if (!Number.isFinite(n) || n <= 0) return '∞';
    const diff = n - now;
    if (diff <= 0) return '0';
    return String(Math.ceil(diff / 86400000));
  }

  function daysLeftNumber(ts) {
    const raw = daysLeft(ts);
    const n = Number(raw);
    return Number.isFinite(n) ? n : null;
  }
  // Точное число дней со знаком: >0 ещё активен, 0 истекает сегодня, <0 просрочен на N дней.
  // Нужно для честной сортировки «сначала истёкшие» и «сначала меньше дней».
  function daysLeftExact(ts) {
    const n = Number(ts || 0);
    if (!Number.isFinite(n) || n <= 0) return null;
    return Math.ceil((n - now) / 86400000);
  }
  function termText(client) {
    const left = Number(daysLeft(client.expiry_time));
    const total = Number(client.duration_days || 0);
    if (!Number.isFinite(left)) return '∞';
    if (total > 0 && total > left) return `${left}/${total} дн.`;
    return `${left} дн.`;
  }
  function dateText(ts) {
    const n = Number(ts || 0);
    if (!Number.isFinite(n) || n <= 0) return '∞';
    return new Date(n).toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }
  function gbText(bytes, digits = 1) {
    const n = Math.max(0, Number(bytes || 0));
    const gb = n / 1024 / 1024 / 1024;
    const maxDigits = gb >= 10 ? 0 : digits;
    return new Intl.NumberFormat('ru-RU', { maximumFractionDigits: maxDigits }).format(gb) + ' ГБ';
  }
  function dateTimeShort(ms) {
    const n = Number(ms || 0);
    if (!Number.isFinite(n) || n <= 0) return 'нет данных';
    return new Date(n).toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }
  const trafficPeriod = trafficReport && trafficReport.period ? trafficReport.period : 'this_month';
  const trafficMetric = trafficReport && trafficReport.metric ? trafficReport.metric : 'download';
  function nodeTitle(row) {
    const rawSuffix = String(row.label_suffix || '').trim();
    const suffix = rawSuffix.replace(/^\/+\s*/, '').trim();
    const base = row.country_name_ru || row.name || 'Узел';
    if (!suffix) return base;
    return /^\d+$/.test(suffix) ? `${base}-${suffix}` : `${base} / ${suffix}`;
  }
  function flagEmojiFromCode(code) {
    const cc = String(code || '').trim().toUpperCase();
    if (!/^[A-Z]{2}$/.test(cc) || ['ZZ','XX'].includes(cc)) return '';
    return Array.from(cc).map(ch => String.fromCodePoint(0x1F1E6 + ch.charCodeAt(0) - 65)).join('');
  }
  function nodeFallbackIcon(nodeType) {
    const kind = String(nodeType || '') === 'remnawave' ? 'remnawave' : '3xui';
    const label = kind === 'remnawave' ? 'Remnawave' : '3x-ui';
    const glyph = kind === 'remnawave'
      ? '<circle cx="12" cy="12" r="2.2"/><path d="M7.8 16.2a6 6 0 0 1 0-8.4M16.2 7.8a6 6 0 0 1 0 8.4M5 19a10 10 0 0 1 0-14M19 5a10 10 0 0 1 0 14"/>'
      : '<rect x="4" y="5" width="16" height="5.5" rx="1.6"/><rect x="4" y="13.5" width="16" height="5.5" rx="1.6"/><path d="M7 7.8h.01M7 16.2h.01"/>';
    return `<span class="flag-badge node-type-fallback node-type-${kind}" aria-label="${label}" title="${label}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${glyph}</svg></span>`;
  }
  function flagImg(code, fallback, name, nodeType) {
    const rawCode = String(code || '').trim().toLowerCase();
    const fb = String(fallback || '').trim();
    const nameText = String(name || '').trim();
    const codeFromName = (typeof countryCodeByName === 'function') ? String(countryCodeByName(nameText) || '').trim().toLowerCase() : '';
    const code2 = (/^[a-z]{2}$/i.test(rawCode) ? rawCode : (/^[a-z]{2}$/i.test(fb) ? fb.toLowerCase() : codeFromName));
    if (code2 && !['zz','xx'].includes(code2)) return '<img class="flag-badge flag-img" src="/flags/' + code2 + '.svg" alt="' + code2.toUpperCase() + '" loading="lazy" onerror="this.style.display=\'none\'">';
    const emoji = (typeof countryFlagText === 'function') ? countryFlagText(code, fb, nameText) : ((fb && fb !== '🌐' && !/^[a-z]{2}$/i.test(fb)) ? fb : flagEmojiFromCode(code || fb));
    return emoji && emoji !== '🌐'
      ? '<span class="flag-badge emoji-fallback">' + emoji + '</span>'
      : nodeFallbackIcon(nodeType);
  }
  const expiringSevenCount = (expiringClients || []).filter(client => {
    const remaining = daysLeftExact(client.expiry_time);
    return remaining !== null && remaining <= 7;
  }).length;
  const initialNodeProblemCount = (pulseNodes || []).filter(node => Number(node.enabled) === 1 && String(node.last_status || '') === 'offline').length;
  const initialRedirectOk = !redirectStatus || redirectStatus.ok !== false;
  const initialRedirectRuleCount = Array.isArray(redirectStatus && redirectStatus.rules) ? redirectStatus.rules.length : 0;
  const initialRedirectMbps = Math.max(0, Number(redirectStatus && redirectStatus.systemNetwork && redirectStatus.systemNetwork.totalMbps || 0));
  const initialRedirectSummary = initialRedirectRuleCount
    ? `${initialRedirectRuleCount} прав. · ${initialRedirectMbps.toFixed(2)} Мбит/с`
    : (redirectStatus && redirectStatus.message ? humanizeError(redirectStatus.message) : 'Активных правил нет');
%>

<% if (message) { %><div class="alert ok"><%= message %></div><% } %>
<% if (error) { %><div class="alert err"><%= error %></div><% } %>

<div class="desktop-page-tabs" data-page-tabs="dashboard">
  <button type="button" class="is-active" data-tab-target="expiry"><span class="agg-tab-ico"><svg class="agg-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.4"/><path d="M12 7.6V12l2.9 1.9"/></svg></span>Сроки</button>
  <button type="button" data-tab-target="traffic"><span class="agg-tab-ico"><svg class="agg-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v9.5"/><path d="m7.5 10 4.5 4.5L16.5 10"/><path d="M5 19.5h14"/></svg></span>Скачано</button>
  <button type="button" data-tab-target="top"><span class="agg-tab-ico"><svg class="agg-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="7.8" r="3.3"/><path d="M3.4 20c.6-3.3 2.9-5.1 5.6-5.1s5 1.8 5.6 5.1"/><path d="M15.4 5.4a3.3 3.3 0 0 1 0 4.8M17.6 15.3c1.7.9 2.7 2.5 3 4.7"/></svg></span>Кто больше потратил</button>
</div>


<div class="grid dashboard-grid">
  <button type="button" class="stats-card span-6 dashboard-primary-stat dashboard-online-stat" id="openOnlineClientsFromStat">
    <div class="stats-label">Клиентов в сети</div>
    <div class="stats-number" id="dashboardOnlineNowCount">—</div>
    <small>Открыть список онлайн</small>
  </button>
  <button type="button" class="stats-card span-6 dashboard-primary-stat dashboard-expiry-stat" id="openExpiryFromStat">
    <div class="stats-label">Заканчиваются за 7 дней</div>
    <div class="stats-number" id="dashboardExpiryNowCount"><%= expiringSevenCount %></div>
    <small>Открыть сроки 7 / 14 / 30 дней</small>
  </button>

  <section class="card span-12 dashboard-health-overview" aria-label="Состояние инфраструктуры">
    <div class="dashboard-health-item" id="dashboardNodesHealth" data-state="<%= initialNodeProblemCount ? 'error' : 'ok' %>">
      <a href="/nodes" class="dashboard-health-link">
        <span class="dashboard-health-icon" aria-hidden="true">◫</span>
        <span><b>Узлы</b><small id="dashboardNodesHealthSummary"><%= initialNodeProblemCount ? `Проблем: ${initialNodeProblemCount}` : 'Все доступные узлы отвечают' %></small></span>
        <strong id="dashboardNodesHealthLabel"><%= initialNodeProblemCount ? 'Ошибка' : 'Работают' %></strong>
      </a>
      <div class="dashboard-health-issues" id="dashboardNodeIssues" <%= initialNodeProblemCount ? '' : 'hidden' %>></div>
    </div>
    <div class="dashboard-health-item" id="dashboardRedirectHealth" data-state="<%= initialRedirectOk ? 'ok' : 'error' %>">
      <a href="/redirects" class="dashboard-health-link">
        <span class="dashboard-health-icon" aria-hidden="true">⇄</span>
        <span><b>Перенаправление</b><small id="dashboardRedirectHealthSummary"><%= initialRedirectSummary %></small></span>
        <strong id="dashboardRedirectHealthLabel"><%= initialRedirectOk ? 'Работает' : 'Ошибка' %></strong>
      </a>
    </div>
  </section>

  <section class="dashboard-secondary-stats span-12" aria-label="Общая статистика">
    <span><small>Клиентов</small><strong><%= stats.clients %></strong></span>
    <span><small>Узлов</small><strong><%= stats.nodes %></strong></span>
    <span><small>Узлов онлайн</small><strong id="dashboardNodesOnlineCount"><%= stats.online %></strong></span>
    <span><small>Узлов оффлайн</small><strong id="dashboardNodesOfflineCount"><%= stats.offline %></strong></span>
  </section>

  <nav class="mobile-dashboard-tabs span-12" id="mobileDashboardTabs" aria-label="Разделы главной страницы">
    <button type="button" data-mobile-dashboard-tab="expiry"><span class="mobile-dashboard-tab-icon"><svg class="agg-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.4"/><path d="M12 7.6V12l2.9 1.9"/></svg></span><span class="mobile-dashboard-tab-label">Сроки</span></button>
    <button type="button" data-mobile-dashboard-tab="traffic"><span class="mobile-dashboard-tab-icon"><svg class="agg-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v9.5"/><path d="m7.5 10 4.5 4.5L16.5 10"/><path d="M5 19.5h14"/></svg></span><span class="mobile-dashboard-tab-label">Скачано</span></button>
    <button type="button" data-mobile-dashboard-tab="top"><span class="mobile-dashboard-tab-icon"><svg class="agg-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="7.8" r="3.3"/><path d="M3.4 20c.6-3.3 2.9-5.1 5.6-5.1s5 1.8 5.6 5.1"/><path d="M15.4 5.4a3.3 3.3 0 0 1 0 4.8M17.6 15.3c1.7.9 2.7 2.5 3 4.7"/></svg></span><span class="mobile-dashboard-tab-label">Кто больше потратил</span></button>
  </nav>

  <section class="card span-12 dashboard-actions-card dashboard-priority-actions">
    <a href="/clients" class="link-btn secondary">Клиенты</a>
    <button type="button" class="btn-secondary" onclick="openDashboardModal('limitsModal')">Лимиты</button>
    <button type="button" class="btn-secondary" onclick="runPanelCheck()">Проверка панели</button>
  </section>


  <section class="card span-12 traffic-report-card tab-panel" data-tab-panel="traffic">
    <div class="section-title-row traffic-report-title">
      <div>
        <h2>Сколько было скачано</h2>
        <p class="muted">Для лимита хостера обычно смотри <strong>«Скачано клиентами»</strong>: это downlink Xray, то есть исходящий трафик сервера к клиентам. Если хостер считает вход+выход вместе — смотри «Всего».</p>
      </div>
      <span class="count-chip"><%= trafficReport ? trafficReport.periodLabel : '' %></span>
    </div>

    <div class="agg-chart-wrap" id="aggChartWrap" data-days="30">
      <div class="agg-chart-top">
        <span>Скачано по дням за 30 дней</span>
        <strong class="agg-chart-total" id="aggChartTotal">—</strong>
      </div>
      <div id="aggChartBox"></div>
      <div class="agg-chart-empty" id="aggChartEmpty" hidden>Пока мало данных: график наполнится по мере накопления снимков трафика.</div>
    </div>

    <div class="traffic-toolbar">
      <form method="get" action="/dashboard" class="traffic-filter-form">
        <label>
          <span>Период</span>
          <select name="traffic_period">
            <option value="day" <%= trafficPeriod === 'day' ? 'selected' : '' %>>День / 24 часа</option>
            <option value="week" <%= trafficPeriod === 'week' ? 'selected' : '' %>>Неделя / 7 дней</option>
            <option value="month" <%= trafficPeriod === 'month' ? 'selected' : '' %>>Месяц / 30 дней</option>
            <option value="this_month" <%= trafficPeriod === 'this_month' ? 'selected' : '' %>>В этом месяце</option>
            <option value="all" <%= trafficPeriod === 'all' ? 'selected' : '' %>>Всё время наблюдений</option>
          </select>
        </label>
        <label>
          <span>Показатель</span>
          <select name="traffic_metric">
            <option value="download" <%= trafficMetric === 'download' ? 'selected' : '' %>>Скачано клиентами</option>
            <option value="upload" <%= trafficMetric === 'upload' ? 'selected' : '' %>>Загружено клиентами</option>
            <option value="total" <%= trafficMetric === 'total' ? 'selected' : '' %>>Всего вход+выход</option>
          </select>
        </label>
        <div class="traffic-button-slot"><button type="submit" class="btn-secondary traffic-action-btn">Показать</button></div>
      </form>
      <form method="post" action="/dashboard/traffic-refresh" class="traffic-refresh-form js-long-action" data-loading-title="Обновляю трафик" data-loading-text="Читаю текущие счётчики клиентов из 3x-ui и сохраняю новый снимок.">
        <input type="hidden" name="traffic_period" value="<%= trafficPeriod %>" />
        <input type="hidden" name="traffic_metric" value="<%= trafficMetric %>" />
        <button type="submit" class="btn-main traffic-refresh-btn">Обновить снимок</button>
      </form>
    </div>

    <% if (trafficReport) { %>
      <div class="traffic-selected-card">
        <small><%= trafficReport.selected.label %> · <%= trafficReport.periodLabel %></small>
        <strong><%= trafficReport.selected.text %></strong>
      </div>

      <div class="traffic-grid">
        <div class="traffic-metric"><span>Скачано клиентами</span><strong><%= trafficReport.downloadText %></strong><small>down / исходящий трафик сервера</small></div>
        <div class="traffic-metric"><span>Загружено клиентами</span><strong><%= trafficReport.uploadText %></strong><small>up / входящий трафик сервера</small></div>
        <div class="traffic-metric"><span>Всего</span><strong><%= trafficReport.totalText %></strong><small>up + down</small></div>
        <div class="traffic-metric"><span>Снимки</span><strong><%= trafficReport.snapshotCount %></strong><small>последний: <%= dateTimeShort(trafficReport.latestSnapshotAt) %></small></div>
      </div>

      <div class="traffic-grid traffic-grid-secondary">
        <div class="traffic-metric"><span>Текущий счётчик down</span><strong><%= trafficReport.currentDownloadText %></strong><small>накоплено в 3x-ui</small></div>
        <div class="traffic-metric"><span>Текущий счётчик всего</span><strong><%= trafficReport.currentTotalText %></strong><small>накоплено в 3x-ui</small></div>
        <div class="traffic-metric"><span>Текущий счётчик up</span><strong><%= trafficReport.currentUploadText %></strong><small>накоплено в 3x-ui</small></div>
        <div class="traffic-metric"><span>Последний снимок</span><strong><%= trafficReport.snapshotCount %></strong><small>данные обновляются кнопкой «Обновить снимок»</small></div>
      </div>

      <% if (!trafficReport.hasBaseline && trafficReport.period !== 'all') { %>
        <div class="alert ok traffic-note">Для выбранного периода ещё нет снимка на начало периода, поэтому расчёт начинается с первого доступного снимка: <%= dateTimeShort(trafficReport.firstSnapshotAt) %>. Дальше точность будет расти автоматически по мере накопления снимков.</div>
      <% } %>
    <% } %>
  </section>

  <section class="card span-12 top-usage-card tab-panel" data-tab-panel="top">
    <div class="section-title-row traffic-report-title">
      <div>
        <h2>Кто больше всего потратил трафика</h2>
        <p class="muted">Помогает найти подозрительного или слишком активного клиента. Это общий накопленный расход по данным 3x-ui/Xray, сгруппированный по клиенту и узлам.</p>
      </div>
      <span class="count-chip"><%= topClientUsageRows ? topClientUsageRows.length : 0 %></span>
    </div>
    <% if (!topClientUsageRows || !topClientUsageRows.length) { %>
      <p class="muted">Пока нет данных по расходу клиентов.</p>
    <% } else { %>
      <div class="top-usage-list paged-list" data-page-size="6">
        <% topClientUsageRows.forEach(item => { %>
          <div class="top-usage-item <%= Number(item.enabled) === 1 ? '' : 'muted-row' %>">
            <div class="top-usage-head">
              <div>
                <strong><button type="button" class="client-inline-link" data-client-quick="<%= item.clientId %>"><%= item.displayName || item.login %></button></strong>
                <small><%= item.comment && item.comment !== item.displayName ? item.comment : item.login %></small>
              </div>
              <span class="count-chip"><%= item.totalText %></span>
            </div>
            <div class="top-usage-grid">
              <div><span>Скачано</span><strong><%= item.downloadText %></strong></div>
              <div><span>Загружено</span><strong><%= item.uploadText %></strong></div>
              <div><span>Всего</span><strong><%= item.totalText %></strong></div>
              <div><span>Узлов</span><strong><%= item.nodeCount %></strong></div>
            </div>
            <% if (item.nodes && item.nodes.length) { %>
              <div class="live-node-tags">
                <% item.nodes.forEach(n => { %>
                  <span><%- flagImg(n.country_code, n.country_flag, n.country_name_ru || n.name, n.node_type) %><%= n.title %> · <%= n.totalText %></span>
                <% }) %>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>

  <section class="card span-12 tab-panel is-active" data-tab-panel="expiry">
    <div class="section-title-row expiry-title-row">
      <div>
        <h2 id="expiryRangeTitle">Сроки заканчиваются в ближайшие 7 дней</h2>
        <div class="dashboard-inline-search">
          <span aria-hidden="true">⌕</span>
          <input id="expiryClientSearch" type="text" placeholder="Поиск по имени, логину или ID" autocomplete="off" />
          <button type="button" class="dashboard-search-clear" id="expiryClientSearchClear" aria-label="Очистить поиск">×</button>
        </div>
      </div>
      <div class="expiry-tools">
        <label class="expiry-range-control"><span>Период</span><select id="expiryRangeDays"><option value="7">7 дней</option><option value="14">14 дней</option><option value="30">30 дней</option></select></label>
        <button type="button" class="secondary expiry-sort-btn" id="expirySortBtn" data-sort-mode="soon">↕ Сортировка</button>
        <span class="count-chip" id="expiryVisibleCount"><%= expiringClients ? expiringClients.length : 0 %></span>
      </div>
    </div>

    <% if (!expiringClients || !expiringClients.length) { %>
      <p class="muted">На ближайшие 30 дней клиентов с истекающим сроком нет.</p>
    <% } else { %>
      <div class="dashboard-client-list expiry-list" id="expiryList">
        <% expiringClients.forEach(client => { const _left = daysLeftNumber(client.expiry_time); const _exact = daysLeftExact(client.expiry_time); %>
          <div class="dashboard-client-card warning" data-dashboard-search-item data-search-text="<%= [client.id, client.login, client.display_name, client.comment].filter(Boolean).join(' ') %>" data-days-left="<%= _left === null ? 999999 : _left %>" data-days-exact="<%= _exact === null ? 999999 : _exact %>" data-expired="<%= (_exact !== null && _exact <= 0) ? 1 : 0 %>">
            <div class="dashboard-client-main">
              <strong><button type="button" class="client-inline-link" data-client-quick="<%= client.id %>"><%= client.login %></button></strong>
              <small><%= client.comment || client.display_name || '-' %></small>
            </div>
            <div class="dashboard-client-meta">
              <span>Осталось: <%= termText(client) %></span>
              <span>Истекает: <%= dateText(client.expiry_time) %></span>
            </div>
            <form method="post" action="/clients/<%= client.id %>/extend" class="mini-extend-form js-long-action" data-loading-title="Продлеваю клиента" data-loading-text="Применяю новый срок на узлах клиента.">
              <input name="days" type="number" min="1" value="30" />
              <button type="submit" class="btn-secondary">Продлить</button>
            </form>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>
</div>


<div id="onlineClientsModal" class="modal hidden" onclick="closeDashboardModal(event, 'onlineClientsModal')">
  <div class="modal-card editor-modal online-modal-card dashboard-scroll-modal" onclick="event.stopPropagation()">
    <button type="button" class="modal-close" onclick="hideDashboardModal('onlineClientsModal')">×</button>
    <div class="section-title-row">
      <div>
        <h2>Онлайн клиенты</h2>
        <p class="muted">Компактный список с активных узлов. Открыв карточку клиента, закрой её — список останется на прежнем месте.</p>
      </div>
    </div>
    <div class="online-modal-controls">
      <button type="button" class="btn-main" id="onlineRefreshBtn">Обновить</button>
      <label class="online-auto-toggle"><input type="checkbox" id="onlineAutoRefresh" checked /><span>Автообновление</span></label>
      <label class="online-auto-interval"><span>Каждые</span><select id="onlineRefreshInterval"><option value="10">10 сек.</option><option value="30">30 сек.</option><option value="60">60 сек.</option></select></label>
    </div>
    <div id="onlineClientsStatus" class="hint">Загружаю онлайн-клиентов…</div>
    <div id="onlineClientsList" class="dashboard-client-list online-list"></div>
  </div>
</div>

<div id="onlineClientDetailModal" class="modal hidden online-client-detail-modal" onclick="closeDashboardModal(event, 'onlineClientDetailModal')">
  <div class="modal-card editor-modal online-client-detail-card" onclick="event.stopPropagation()">
    <button type="button" class="modal-close" onclick="hideDashboardModal('onlineClientDetailModal')">×</button>
    <div id="onlineClientDetailBody"></div>
  </div>
</div>

<div id="limitsModal" class="modal hidden" onclick="closeDashboardModal(event, 'limitsModal')">
  <div class="modal-card editor-modal dashboard-scroll-modal" onclick="event.stopPropagation()">
    <button type="button" class="modal-close" onclick="hideDashboardModal('limitsModal')">×</button>
    <h2>Лимиты трафика</h2>
    <p class="muted">Показываются только узлы, где задан лимит ГБ.</p>
    <div class="dashboard-inline-search dashboard-modal-search">
      <span aria-hidden="true">⌕</span>
      <input id="limitClientSearch" type="text" placeholder="Поиск по клиенту, ID или узлу" autocomplete="off" />
      <button type="button" class="dashboard-search-clear" id="limitClientSearchClear" aria-label="Очистить поиск">×</button>
    </div>
    <% if (!limitedClients || !limitedClients.length) { %>
      <p class="muted">Лимитов ГБ на узлах пока нет.</p>
    <% } else { %>
      <div class="limit-dashboard-list dashboard-scroll-list" id="limitDashboardList">
        <% limitedClients.forEach(row => { %>
          <div class="limit-dashboard-row" data-limit-search-item data-search-text="<%= [row.client_id || row.clientId || row.id, row.login, row.comment, nodeTitle(row)].filter(Boolean).join(' ') %>">
            <div>
              <strong><%= row.login %></strong>
              <small><%= row.comment || '-' %> · <%= nodeTitle(row) %></small>
            </div>
            <div class="limit-dashboard-values">
              <span><%= gbText(row.used_bytes) %> / <%= row.traffic_gb %> ГБ</span>
              <strong>Осталось: <%= gbText(row.remaining_bytes) %></strong>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>


<div id="panelCheckModal" class="modal hidden" onclick="closeDashboardModal(event, 'panelCheckModal')">
  <div class="modal-card editor-modal" onclick="event.stopPropagation()">
    <button type="button" class="modal-close" onclick="hideDashboardModal('panelCheckModal')">×</button>
    <h2>Проверка панели</h2>
    <p class="muted">Агрегатор проверит узлы, базовые настройки маршрутизации, helper перенаправления и состояние клиентов.</p>
    <div id="panelCheckResult" class="kv-list"><div class="kv-item"><strong>Ожидание</strong><div class="muted">Нажми «Запустить проверку».</div></div></div>
    <div class="actions" style="margin-top:12px;"><button type="button" class="btn-main" onclick="runPanelCheck(true)">Запустить проверку</button></div>
  </div>
</div>

<div id="loadingModal" class="modal hidden loading-modal" aria-live="polite">
  <div class="modal-card loading-card">
    <div class="loader-ring"></div>
    <h2 id="loadingTitle">Загрузка</h2>
    <p class="muted" id="loadingText">Операция выполняется. Не закрывайте страницу.</p>
  </div>
</div>

<script>
function syncDashboardModalState() {
  const hasOpenModal = Array.from(document.querySelectorAll('.modal')).some(modal => !modal.classList.contains('hidden'));
  document.body.classList.toggle('dashboard-modal-open', hasOpenModal);
}
function openDashboardModal(id) {
  document.getElementById(id)?.classList.remove('hidden');
  syncDashboardModalState();
}
function hideDashboardModal(id) {
  document.getElementById(id)?.classList.add('hidden');
  syncDashboardModalState();
}
function closeDashboardModal(e, id) { if (e.target.id === id) hideDashboardModal(id); }
async function runPanelCheck(skipOpen) {
  if (!skipOpen) openDashboardModal('panelCheckModal');
  const box = document.getElementById('panelCheckResult');
  if (box) box.innerHTML = '<div class="kv-item"><strong>Проверяю...</strong><div class="muted">Это может занять несколько секунд.</div></div>';
  try {
    const response = await fetch('/dashboard/panel-check.json', { headers: { 'Accept': 'application/json' } });
    const data = await response.json();
    if (!response.ok) throw new Error(data.error || 'Ошибка проверки');
    if (box) box.innerHTML = (data.checks || []).map(item => `
      <div class="kv-item ${item.ok ? '' : 'warn-box'}">
        <strong>${item.ok ? '✅' : '⚠️'} ${escapeHtml(item.name)}</strong>
        <div class="muted">${escapeHtml(item.message)}</div>
      </div>
    `).join('') + `<div class="kv-item"><strong>Итог</strong><div class="muted">${data.ok ? 'Критичных проблем не найдено' : 'Есть предупреждения'} · ${data.durationMs || 0} мс</div></div>`;
  } catch (err) {
    if (box) box.innerHTML = `<div class="kv-item warn-box"><strong>Ошибка</strong><div class="muted">${escapeHtml(err.message || err)}</div></div>`;
  }
}
function escapeHtml(value) { return String(value ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch])); }
function escapeAttrJson(value) { return escapeHtml(JSON.stringify(value || {})); }

function flagEmojiFromCodeJs(code) {
  const cc = String(code || '').trim().toUpperCase();
  if (!/^[A-Z]{2}$/.test(cc) || ['ZZ','XX'].includes(cc)) return '';
  return Array.from(cc).map(ch => String.fromCodePoint(0x1F1E6 + ch.charCodeAt(0) - 65)).join('');
}
function nodeFallbackIconHtml(nodeType) {
  const kind = String(nodeType || '') === 'remnawave' ? 'remnawave' : '3xui';
  const label = kind === 'remnawave' ? 'Remnawave' : '3x-ui';
  const glyph = kind === 'remnawave'
    ? '<circle cx="12" cy="12" r="2.2"/><path d="M7.8 16.2a6 6 0 0 1 0-8.4M16.2 7.8a6 6 0 0 1 0 8.4M5 19a10 10 0 0 1 0-14M19 5a10 10 0 0 1 0 14"/>'
    : '<rect x="4" y="5" width="16" height="5.5" rx="1.6"/><rect x="4" y="13.5" width="16" height="5.5" rx="1.6"/><path d="M7 7.8h.01M7 16.2h.01"/>';
  return `<span class="flag-badge node-type-fallback node-type-${kind}" aria-label="${label}" title="${label}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${glyph}</svg></span>`;
}
function renderFlag(code, fallback, nodeType) {
  const cc = String(code || '').trim().toLowerCase();
  if (/^[a-z]{2}$/.test(cc) && !['zz','xx'].includes(cc)) {
    return `<img class="flag-badge flag-img" src="/flags/${cc}.svg" alt="${cc.toUpperCase()}" loading="lazy" onerror="this.style.display='none'">`;
  }
  const fb = String(fallback || '').trim();
  const emoji = (fb && fb !== '🌐' && !/^[a-z]{2}$/i.test(fb)) ? fb : flagEmojiFromCodeJs(code || fb);
  return emoji && emoji !== '🌐'
    ? `<span class="flag-badge emoji-fallback">${escapeHtml(emoji)}</span>`
    : nodeFallbackIconHtml(nodeType);
}
function renderNodeTitle(row) {
  const suffixRaw = String(row.label_suffix || '').trim().replace(/^\/+\s*/, '').trim();
  const base = row.country_name_ru || row.nodeName || row.node_name || 'Узел';
  if (!suffixRaw) return base;
  return /^\d+$/.test(suffixRaw) ? `${base}-${suffixRaw}` : `${base} / ${suffixRaw}`;
}
function renderLiveTraffic(data) {
  const list = document.getElementById('liveTrafficList');
  const status = document.getElementById('liveTrafficStatus');
  if (!list) return;
  const clients = Array.isArray(data.clients) ? data.clients : [];
  const generated = data.generatedAt ? new Date(data.generatedAt).toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) : '';
  const errors = Array.isArray(data.errors) && data.errors.length ? ' · ошибки: ' + data.errors.slice(0, 2).map(escapeHtml).join(' | ') : '';
  const duration = data.durationSeconds ? ' · интервал: ' + escapeHtml(data.durationSeconds) + ' сек.' : '';
  if (status) status.innerHTML = `${clients.length ? 'Активных клиентов: ' + clients.length : 'Активной нагрузки не найдено'}${duration}${generated ? ' · обновлено: ' + generated : ''}${errors}`;
  const topNodes = Array.isArray(data.topNodes) ? data.topNodes : [];
  if (!clients.length && !topNodes.length) {
    list.innerHTML = '<div class="empty-state live-empty">Активной нагрузки пока нет. Подключи клиента, запусти скачивание/Speedtest и нажми «Начать проверку».</div>';
    return;
  }
  const nodeHtml = topNodes.length ? `<div class="live-node-summary"><h3>Нагрузка по узлам за интервал</h3><div class="live-node-summary-grid">${topNodes.slice(0, 8).map(n => `<div><strong>${renderFlag(n.country_code, n.country_flag, n.node_type)}${escapeHtml(renderNodeTitle(n))}</strong><span>${escapeHtml(n.totalText || '0 Мбит/с')}</span><small>↓ ${escapeHtml(n.downloadText || '0 Мбит/с')} · ↑ ${escapeHtml(n.uploadText || '0 Мбит/с')}</small></div>`).join('')}</div></div>` : '';
  const clientHtml = clients.map(item => `
    <div class="live-client-card" data-client-id="${escapeHtml(item.clientId)}">
      <div class="live-client-head">
        <div>
          <strong>${escapeHtml(item.displayName || item.login || '-')}</strong>
          ${item.comment && item.comment !== item.displayName ? `<small>${escapeHtml(item.comment)}</small>` : ''}
        </div>
        <span class="count-chip">${escapeHtml(item.totalText || '0 Мбит/с')}</span>
      </div>
      <div class="live-speed-grid">
        <div><span>Скачивает</span><strong>${escapeHtml(item.downloadText || '0 Мбит/с')}</strong></div>
        <div><span>Загружает</span><strong>${escapeHtml(item.uploadText || '0 Мбит/с')}</strong></div>
        <div><span>Всего</span><strong>${escapeHtml(item.totalText || '0 Мбит/с')}</strong></div>
        <div><span>За последний интервал</span><strong>${escapeHtml(item.recentText || '0 Б')}</strong></div>
      </div>
      ${Array.isArray(item.nodes) && item.nodes.length ? `<div class="live-node-tags">${item.nodes.slice(0, 4).map(n => `<span>${renderFlag(n.country_code, n.country_flag, n.node_type)}${escapeHtml(renderNodeTitle(n))} · ${escapeHtml(n.totalText || '0 Мбит/с')}</span>`).join('')}</div>` : ''}
    </div>
  `).join('');
  list.innerHTML = nodeHtml + clientHtml;
}
async function probeLiveTraffic() {
  const btn = document.getElementById('liveTrafficProbe');
  const secondsSelect = document.getElementById('liveTrafficProbeSeconds');
  const status = document.getElementById('liveTrafficStatus');
  const seconds = Math.max(5, Math.min(15, Number(secondsSelect?.value || 5)));
  let countdownTimer = null;
  try {
    if (btn) btn.disabled = true;
    if (secondsSelect) secondsSelect.disabled = true;
    let left = seconds;
    if (status) status.textContent = `Проверка началась: снят первый снимок, жду ${left} сек...`;
    countdownTimer = setInterval(() => {
      left -= 1;
      if (status && left > 0) status.textContent = `Проверка идёт: осталось ${left} сек...`;
    }, 1000);
    const response = await fetch(`/dashboard/live-client-traffic-probe.json?seconds=${encodeURIComponent(seconds)}&limit=30&min_mbps=0.05`, { headers: { 'Accept': 'application/json' } });
    const data = await response.json();
    if (!response.ok || !data.ok) throw new Error(data.error || 'Ошибка проверки нагрузки');
    renderLiveTraffic(data);
  } catch (err) {
    if (status) status.textContent = 'Ошибка проверки: ' + (err.message || err);
  } finally {
    if (countdownTimer) clearInterval(countdownTimer);
    if (btn) btn.disabled = false;
    if (secondsSelect) secondsSelect.disabled = false;
  }
}


function onlineNodeBadgesHtml(client) {
  const nodes = Array.isArray(client.nodes) ? client.nodes : [];
  return nodes.map(n => {
    const title = renderNodeTitle({
      country_code: n.countryCode || n.country_code,
      country_name_ru: n.countryNameRu || n.country_name_ru,
      nodeName: n.publicName || n.name,
      node_name: n.publicName || n.name,
      label_suffix: n.labelSuffix || n.label_suffix || ''
    });
    const flag = renderFlag(n.countryCode || n.country_code, n.countryFlag || n.country_flag || n.flag, n.nodeType || n.node_type);
    const transport = n.transportLabel ? ` · ${escapeHtml(n.transportLabel)}` : '';
    return `<span class="node-badge" title="${escapeHtml(title + transport)}">${flag}<span>${escapeHtml(title)}${transport}</span></span>`;
  }).join('') || '<span class="node-badge muted">узел не определён</span>';
}
function onlineNodePreviewHtml(client) {
  const nodes = Array.isArray(client.nodes) ? client.nodes : [];
  const visible = nodes.slice(0, 3).map(n => {
    const title = renderNodeTitle({
      country_code: n.countryCode || n.country_code,
      country_name_ru: n.countryNameRu || n.country_name_ru,
      nodeName: n.publicName || n.name,
      node_name: n.publicName || n.name,
      label_suffix: n.labelSuffix || n.label_suffix || ''
    });
    const flag = renderFlag(n.countryCode || n.country_code, n.countryFlag || n.country_flag || n.flag, n.nodeType || n.node_type);
    return `<span class="online-node-preview" title="${escapeHtml(title)}">${flag || '<span aria-hidden="true">●</span>'}</span>`;
  });
  if (nodes.length > visible.length) visible.push(`<span class="online-node-more" title="Ещё узлов: ${nodes.length - visible.length}">+${nodes.length - visible.length}</span>`);
  return visible.join('') || '<span class="online-node-none">—</span>';
}
function onlineClientUntil(client) {
  return client.expiry_time && Number(client.expiry_time) > 0
    ? new Date(Number(client.expiry_time)).toLocaleString('ru-RU', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' })
    : '∞';
}
const onlineClientDetailsById = new Map();
function renderOnlineClients(data) {
  const list = document.getElementById('onlineClientsList');
  const status = document.getElementById('onlineClientsStatus');
  if (!list) return;
  const clients = Array.isArray(data.clients) ? data.clients : [];
  onlineClientDetailsById.clear();
  clients.forEach(client => {
    const key = String(client.id || client.clientId || client.client_id || '').trim();
    if (key) onlineClientDetailsById.set(key, client);
  });
  const errors = Array.isArray(data.errors) && data.errors.length ? ' · ошибки: ' + data.errors.slice(0, 2).map(escapeHtml).join(' | ') : '';
  const generated = data.generatedAt ? new Date(data.generatedAt).toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) : '';
  if (status) status.innerHTML = `Показано ${clients.length} онлайн-клиентов${generated ? ' · обновлено: ' + generated : ''}${errors}`;
  if (!clients.length) {
    list.innerHTML = '<div class="empty-state">Онлайн-клиентов не найдено или узлы не вернули список.</div>';
    return;
  }
  list.innerHTML = clients.map((client, index) => {
    const comment = client.comment || ((client.display_name && client.display_name !== client.login) ? client.display_name : '');
    const clientId = client.id || client.clientId || client.client_id || '';
    const until = onlineClientUntil(client);
    return `
      <div class="dashboard-client-card online-client-card online-client-row online-client-card-v2">
        <span class="online-client-live-dot" title="Сейчас в сети" aria-label="Сейчас в сети"></span>
        <div class="online-client-main-v4"><strong class="online-client-login-v4">${escapeHtml(client.login || client.display_name || '-')}</strong><small class="online-client-comment-v4">${escapeHtml(comment || 'Без комментария')}</small></div>
        <span class="online-client-expiry-v4">до ${escapeHtml(until)}</span>
        <div class="online-node-preview-list" aria-label="Узлы клиента">${onlineNodePreviewHtml(client)}</div>
        <button type="button" class="online-details-toggle online-details-toggle-v4" data-online-client-index="${index}" ${clientId ? `data-open-online-client="${escapeHtml(clientId)}" data-online-client-id="${escapeHtml(clientId)}"` : `data-open-online-client-fallback="1" data-online-client-detail="${escapeAttrJson(client)}"`}>Подробнее</button>
      </div>`;
  }).join('');
  bindOnlineDetailsButtons();
}

function bindOnlineDetailsButtons() {
  const list = document.getElementById('onlineClientsList');
  if (!list) return;
  list.querySelectorAll('[data-open-online-client]').forEach(btn => {
    if (btn.dataset.boundOnlineDetails === '1') return;
    btn.dataset.boundOnlineDetails = '1';
    btn.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      const id = btn.getAttribute('data-open-online-client') || btn.getAttribute('data-online-client-id') || '';
      if (!id) return;
      openOnlineClientById(id, event);
    }, { passive: false });
  });
  list.querySelectorAll('[data-open-online-client-fallback]').forEach(btn => {
    if (btn.dataset.boundOnlineDetails === '1') return;
    btn.dataset.boundOnlineDetails = '1';
    btn.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      try {
        const raw = btn.getAttribute('data-online-client-detail') || '{}';
        openOnlineClientDetail(JSON.parse(raw));
      } catch (err) {
        alert('Не удалось открыть детали клиента');
      }
    }, { passive: false });
  });
}

function nodeFlagForClientQuick(n) {
  const raw = n || {};
  const fb = String(raw.countryFlag || raw.country_flag || raw.flag || '').trim();
  const code = String(raw.countryCode || raw.country_code || '').trim();
  return renderFlag(code, fb, raw.nodeType || raw.node_type);
}
function nodeLabelForClientQuick(n) {
  if (typeof n === 'string') return String(n || '').replace(/^🌐\s*/u, '').trim();
  const name = String((n && (n.title || n.name || n.label)) || '').replace(/^🌐\s*/u, '').trim();
  const country = String((n && (n.countryName || n.countryNameRu)) || '').trim();
  const label = (name && name !== 'Узел') ? name : country;
  return String(label || '').replace(/^🌐\s*/u, '').trim();
}
function renderClientQuickBody(c) {
  const nodes = Array.isArray(c.nodes) ? c.nodes.filter(n => {
    const label = nodeLabelForClientQuick(n);
    return label && label !== 'Узел';
  }) : [];
  const nodesHtml = nodes.length ? nodes.map(n => {
    const flag = nodeFlagForClientQuick(n);
    const trafficGb = Math.max(0, Number(n && n.trafficGb || 0));
    const usage = String(n && (n.usageText || (n.usedText ? `${n.usedText} / ${n.limitText || (trafficGb ? `${trafficGb} ГБ` : '∞')}` : '')) || '');
    return `<span class="client-quick-node-chip">${flag ? `<span class="client-quick-node-flag">${flag}</span>` : ''}<span><b>${escapeHtml(nodeLabelForClientQuick(n))}</b>${usage ? `<small>${escapeHtml(usage)}</small>` : ''}</span></span>`;
  }).join('') : '<span class="client-quick-node-chip empty">Узлы не назначены</span>';
  const subLink = c.links && c.links.sub ? String(c.links.sub) : '';
  const jsonLink = c.links && c.links.json ? String(c.links.json) : '';
  const openLink = c.links && c.links.open ? String(c.links.open) : '#';
  const editorLink = c.links && c.links.editor ? String(c.links.editor) : (c.links && c.links.search ? String(c.links.search) : '/clients');
  const clientId = String(c.id || '').trim();
  const trafficText = c.trafficGb && Number(c.trafficGb) > 0 ? c.trafficGb + ' ГБ' : '∞';
  const limitIpText = c.limitIp && Number(c.limitIp) > 0 ? String(c.limitIp) : '∞';
  const avatarLetter = String(c.login || c.title || 'U').trim().slice(0,1).toUpperCase() || 'U';
  return `
    <div class="client-quick-hero">
      <div class="client-quick-avatar">${escapeHtml(avatarLetter)}</div>
      <div class="client-quick-title"><h2>${escapeHtml(c.title || c.login || 'Клиент')}</h2><p>@${escapeHtml(c.login || '-')}</p></div>
    </div>
    <div class="client-quick-status-row"><button type="button" class="client-quick-status-strip quick-status ${escapeHtml(c.statusKey || 'online')}" data-status-label="${escapeHtml(c.statusLabel || 'Статус')}" data-status-text="${escapeHtml(c.statusText || '')}">${escapeHtml(c.statusLabel || 'Статус')}</button></div>
    ${c.comment ? `<div class="client-quick-comment">${escapeHtml(c.comment)}</div>` : ''}
    <div class="client-quick-note ${escapeHtml(c.statusKey || '')}">${escapeHtml(c.statusText || '')}</div>
    <div class="client-quick-primary-actions">
      <a class="btn-main" href="${escapeHtml(editorLink)}">Перейти к клиенту</a>
      ${clientId ? `<form method="post" action="/clients/${encodeURIComponent(clientId)}/extend" class="client-quick-renew-form js-long-action" data-loading-title="Продлеваю клиента" data-loading-text="Срок продлевается на узлах клиента.">
        <input type="hidden" name="back" value="/dashboard" />
        <input name="days" type="number" min="1" value="30" inputmode="numeric" aria-label="Количество дней продления" />
        <button type="submit" class="btn-secondary">Продлить</button>
      </form>` : ''}
    </div>
    <div class="client-quick-section-title">Общая информация</div>
    <div class="client-quick-info-grid">
      <div><span>ID клиента</span><strong>#${escapeHtml(c.id || '-')}</strong></div>
      <div><span>Логин</span><strong>${escapeHtml(c.login || '-')}</strong></div>
      <div><span>Статус</span><strong>${escapeHtml(c.statusLabel || '-')}</strong></div>
      <div><span>Тип</span><strong>Основной</strong></div>
      <div><span>Сейчас в сети</span><strong>${c.connectedNow ? 'Да' : 'Нет'}</strong></div>
      <div><span>Последний раз в сети</span><strong>${escapeHtml(c.lastOnlineText || 'Нет данных')}</strong></div>
      <div><span>Действует до</span><strong>${escapeHtml(c.expiryText || '∞')}</strong></div>
      <div><span>Осталось</span><strong>${escapeHtml(c.daysLeft)} дн.</strong></div>
      <div><span>Трафик</span><strong>${escapeHtml(trafficText)}</strong></div>
      <div><span>Лимит дней</span><strong>${escapeHtml(c.durationDays || '∞')}</strong></div>
      <div><span>Лимит IP</span><strong>${escapeHtml(limitIpText)}</strong></div>
      <div><span>Узлов</span><strong>${escapeHtml(c.nodeCount || nodes.length || 0)}</strong></div>
      <div><span>Создан</span><strong>${escapeHtml(c.createdText || c.createdAt || '—')}</strong></div>
      <div><span>UUID</span><strong>${escapeHtml(c.uuid || '—')}</strong></div>
    </div>
    <div class="client-quick-section-title">${c.onlineNodesContext ? 'Узлы, где клиент онлайн сейчас' : 'Узлы'}</div>
    <div class="client-quick-nodes-grid">${nodesHtml}</div>
    <div class="client-quick-actions modern">
