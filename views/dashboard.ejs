  render();
})();


(function aggPulse(){
  const btn = document.getElementById('aggPulseCheckBtn');
  const list = document.getElementById('aggPulseList');
  const updatedAt = document.getElementById('aggPulseUpdatedAt');
  if (!btn || !list) return;
  let running = false;
  let timer = null;

  async function refreshNodeStatus() {
    if (running || document.hidden) return;
    running = true;
    const items = Array.from(list.querySelectorAll('.agg-pulse-item'));
    items.forEach(it => {
      if (it.dataset.state !== 'disabled') {
        it.dataset.state = 'checking';
        const ms = it.querySelector('[data-pulse-ms]');
        if (ms) ms.textContent = '…';
      }
    });
    btn.disabled = true;
    const oldText = btn.textContent;
    btn.textContent = 'Проверяю…';
    try {
      const res = await fetch('/dashboard/node-status.json', {
        headers: { 'Accept': 'application/json' },
        cache: 'no-store'
      });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || 'Не удалось проверить узлы');
      const byId = new Map((data.checks || []).map(check => [String(check.nodeId), check]));
      items.forEach(it => {
        if (it.dataset.state === 'disabled') return;
        const c = byId.get(String(it.dataset.nodeId));
        const ms = it.querySelector('[data-pulse-ms]');
        if (!c) { it.dataset.state = 'unknown'; if (ms) ms.textContent = ''; return; }
        it.dataset.state = c.status === 'disabled' ? 'disabled' : (c.ok ? 'online' : 'offline');
        if (ms) ms.textContent = c.ok
          ? (c.ms ? Math.round(c.ms) + ' мс' : '')
          : 'нет ответа';
      });
      if (updatedAt) {
        const stamp = data.generatedAt ? new Date(data.generatedAt) : new Date();
        updatedAt.textContent = 'Последняя проверка: ' + stamp.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) + '.';
      }
    } catch (_) {
      items.forEach(it => { if (it.dataset.state === 'checking') it.dataset.state = 'unknown'; });
      if (updatedAt) updatedAt.textContent = 'Проверка временно недоступна.';
    } finally {
      running = false;
      btn.disabled = false;
      btn.textContent = oldText;
    }
  }

  btn.addEventListener('click', refreshNodeStatus);
  timer = window.setInterval(refreshNodeStatus, 10000);
  window.setTimeout(refreshNodeStatus, 500);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) refreshNodeStatus();
  });
  window.addEventListener('pagehide', () => {
    if (timer) window.clearInterval(timer);
    timer = null;
  }, { once: true });
})();

(function aggTrafficChart(){
  const wrap = document.getElementById('aggChartWrap');
