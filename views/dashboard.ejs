function normalizeDashboardSearchText(value) {
  return String(value || '').toLocaleLowerCase('ru-RU').replace(/ё/g, 'е').replace(/\s+/g, ' ').trim();
}

(function setupExpiryDirectory(){
  const btn = document.getElementById('expirySortBtn');
  const list = document.getElementById('expiryList');
  const input = document.getElementById('expiryClientSearch');
  const clear = document.getElementById('expiryClientSearchClear');
  const count = document.getElementById('expiryVisibleCount');
  const range = document.getElementById('expiryRangeDays');
  const rangeTitle = document.getElementById('expiryRangeTitle');
  if (!btn || !list) return;
  const modes = ['soon', 'late', 'expired'];
  const labels = { soon: 'Сначала меньше дней', late: 'Сначала больше дней', expired: 'Сначала истёкшие' };
  let idx = 0;
  function exactDays(row){
    // data-days-exact со знаком: <=0 — просрочен/истекает сегодня, >0 — сколько дней осталось.
    const v = Number(row.dataset.daysExact);
    return Number.isFinite(v) ? v : 999999;
  }
  function render(){
    const mode = modes[idx % modes.length];
    const query = normalizeDashboardSearchText(input?.value || '');
    const rangeDays = [7, 14, 30].includes(Number(range?.value)) ? Number(range.value) : 7;
    const rows = Array.from(list.children).filter(el => el.classList && el.classList.contains('dashboard-client-card'));
    rows.forEach(row => {
      const dayValue = exactDays(row);
      const searchMatches = (!query || normalizeDashboardSearchText(row.dataset.searchText || '').includes(query)) && dayValue <= rangeDays;
      // У старых слоёв CSS у карточки есть display с !important, поэтому одного
      // inline-style недостаточно: используем отдельный класс и hidden.
      row.classList.toggle('is-expiry-search-hidden', !searchMatches);
      row.hidden = !searchMatches;
      row.setAttribute('aria-hidden', searchMatches ? 'false' : 'true');
    });
    rows.sort((a,b) => {
      const ad = exactDays(a), bd = exactDays(b);
      // «Сначала истёкшие» — самые просроченные вверху (наименьшее, вплоть до отрицательных).
      if (mode === 'expired') return ad - bd;
      // «Сначала больше дней» — у кого срок дальше, тот выше.
      if (mode === 'late') return bd - ad;
      // «Сначала меньше дней» — у кого срок ближе к концу (но ещё не истёк), тот выше;
      // истёкшие уходят в конец, чтобы список читался как «кому продлевать в первую очередь».
      const aActive = ad > 0 ? 0 : 1;
      const bActive = bd > 0 ? 0 : 1;
      if (aActive !== bActive) return aActive - bActive;
      return ad - bd;
    });
    rows.forEach(row => list.appendChild(row));
    const shown = rows.filter(row => !row.classList.contains('is-expiry-search-hidden')).length;
    btn.textContent = '↕ ' + labels[mode];
    if (count) count.textContent = String(shown);
    if (clear) clear.hidden = !query;
    if (rangeTitle) rangeTitle.textContent = `Сроки заканчиваются в ближайшие ${rangeDays} дней`;
    try { localStorage.setItem('nexus.dashboard.expiryRange', String(rangeDays)); } catch (_) {}
  }
  try {
    const savedRange = localStorage.getItem('nexus.dashboard.expiryRange');
    if (range && ['7', '14', '30'].includes(savedRange)) range.value = savedRange;
  } catch (_) {}
  btn.addEventListener('click', () => { idx += 1; render(); });
  input?.addEventListener('input', render);
  range?.addEventListener('change', render);
  clear?.addEventListener('click', () => { if (input) { input.value = ''; input.focus(); } render(); });
  render();
})();

(function setupLimitSearch(){
  const input = document.getElementById('limitClientSearch');
  const clear = document.getElementById('limitClientSearchClear');
  const rows = Array.from(document.querySelectorAll('[data-limit-search-item]'));
