    const entries = [
      { label: 'JSON', description: 'JSON/Xray — для Happ и совместимых клиентов', url: element.dataset.jsonLink || '' },
      { label: 'SUB', description: 'Универсальная подписка — для Hiddify, v2rayNG и других', url: element.dataset.subLink || '' },
      { label: 'HAPP', description: 'Отдельная HAPP-ссылка панели', url: element.dataset.happLink || '' }
    ].filter(function(item){ return String(item.url || '').trim(); });
    if (!entries.length) return false;

    const modal = ensureClientLinkPickerModal();
    const clientTitle = String(element.dataset.clientLinkTitle || '').trim();
    modal.querySelector('#clientLinkPickerTitle').textContent = clientTitle ? ('Ссылки: ' + clientTitle) : 'Ссылки клиента';
    modal.querySelector('[data-client-link-list]').innerHTML = entries.map(function(item){
      const url = htmlEscapeClientModal(item.url);
      const label = htmlEscapeClientModal(item.label);
      return '<article class="client-link-option-card">' +
