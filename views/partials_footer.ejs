  function orderConfigs(){ return [
    { root: function(){ return document.querySelector('.desktop-modern-nav'); }, selector: ':scope > a', key: 'agg.order.sidebar.v1', id: function(el){ return el.getAttribute('href') || el.textContent.trim(); } },
    { root: function(){ return document.querySelector('.desktop-page-tabs[data-page-tabs]'); }, selector: ':scope > button[data-tab-target]', key: function(){ return 'agg.order.tabs.' + (document.querySelector('.desktop-page-tabs[data-page-tabs]')?.dataset.pageTabs || 'page') + '.v1'; }, id: function(el){ return el.dataset.tabTarget || el.textContent.trim(); } },
    { root: function(){ return document.querySelector('.settings-tabs'); }, selector: ':scope > button[data-settings-tab]', key: 'agg.order.settings.tabs.v1', id: function(el){ return el.dataset.settingsTab || el.textContent.trim(); } }
  ]; }
  function orderKey(cfg){ return typeof cfg.key === 'function' ? cfg.key() : cfg.key; }
  function orderItems(cfg){ const root = cfg.root(); return root ? Array.from(root.querySelectorAll(cfg.selector)) : []; }
  function applyOneOrder(cfg){
    const root = cfg.root(); if (!root) return;
    let order=[]; try { order = JSON.parse(localStorage.getItem(orderKey(cfg)) || '[]'); } catch(_){}
    if (!Array.isArray(order) || !order.length) return;
    const map = new Map(orderItems(cfg).map(function(el){ return [cfg.id(el), el]; }));
    order.forEach(function(id){ const el = map.get(id); if (el) root.appendChild(el); });
  }
  window.__stage59OrderMove = function(btn, dir){
    const row = btn && btn.closest && btn.closest('.order-modal-row'); if (!row || !row.parentNode) return;
    if (dir < 0 && row.previousElementSibling) row.parentNode.insertBefore(row, row.previousElementSibling);
    if (dir > 0 && row.nextElementSibling) row.parentNode.insertBefore(row.nextElementSibling, row);
  };
  window.__stage59OrderSave = function(){
    const configs = orderConfigs();
    document.querySelectorAll('#orderEditorModal .order-modal-section').forEach(function(section){
      const cfg = configs[Number(section.dataset.cfgIndex)]; if (!cfg) return;
      const ids = Array.from(section.querySelectorAll('.order-modal-row')).map(function(row){ return row.dataset.orderId; }).filter(Boolean);
      localStorage.setItem(orderKey(cfg), JSON.stringify(ids));
      applyOneOrder(cfg);
    });
    document.getElementById('orderEditorModal')?.classList.add('hidden');
  };
  window.__stage59OrderReset = function(){ orderConfigs().forEach(function(cfg){ localStorage.removeItem(orderKey(cfg)); }); location.reload(); };
  function setupStage59Order(){
    orderConfigs().forEach(applyOneOrder);
    // direct robust handlers for modal controls
    document.addEventListener('click', function(e){
      const up = e.target.closest('[data-order-up]'); if (up) { e.preventDefault(); window.__stage59OrderMove(up, -1); return; }
      const down = e.target.closest('[data-order-down]'); if (down) { e.preventDefault(); window.__stage59OrderMove(down, 1); return; }
      if (e.target.closest('[data-order-save-all]')) { e.preventDefault(); window.__stage59OrderSave(); return; }
      if (e.target.closest('[data-order-reset-all]')) { e.preventDefault(); window.__stage59OrderReset(); return; }
    }, true);
  }

  function boot(){ setupStage59Auth(); setupStage59Order(); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();
</script>


<script>
(function(){
  if (document.body.classList.contains('nexus-spectrum')) return;
  // stage60: strict final UI guards for tabs/order/dirty-save after all older handlers.
  function formDataString(form){
    try {
      return Array.from(new FormData(form).entries())
        .filter(function(p){ return !String(p[0] || '').startsWith('_'); })
        .map(function(p){ return String(p[0]) + '=' + String(p[1]); })
        .sort().join('&');
    } catch(_) { return ''; }
  }
  function safeSubmit(form){
    if (!form) return null;
    return Array.from(form.querySelectorAll('button[type="submit"],input[type="submit"]')).find(function(btn){
      const label = String(btn.textContent || btn.value || '').toLowerCase();
      const action = String(btn.getAttribute('formaction') || form.getAttribute('action') || '').toLowerCase();
      if (btn.disabled || btn.classList.contains('danger') || btn.classList.contains('btn-danger')) return false;
      if (/delete|remove|logout|toggle|check|test|refresh|sync|import|extend|reorder/.test(action)) return false;
      if (/удал|выйти|отключ|включ|провер|тест|обнов|импорт|синхрон|продл|создать|отправить|привязать/.test(label)) return false;
      return true;
    }) || null;
  }
  function trackableForms(){
    if (!/\/(routing|redirects|settings|telegram-bot|nodes|clients|diagnostics)/.test(location.pathname)) return [];
    return Array.from(document.querySelectorAll('main form[method="post"]')).filter(function(form){
      if (form.matches('.logout-form,.sidebar-logout,.bulk-delete-form,.inline-form,.mini-extend-form,.extend-form')) return false;
      if (form.dataset.globalFloatingSave === 'off') return false;
      if (!form.querySelector('input,select,textarea')) return false;
      return !!safeSubmit(form);
    });
  }
  function ensureBar(){
    document.querySelectorAll('.global-floating-save').forEach(function(bar){
      if (bar.dataset.stage60 !== '1') bar.remove();
    });
    let bar = document.querySelector('.global-floating-save[data-stage60="1"]');
    if (!bar) {
      bar = document.createElement('div');
      bar.className = 'global-floating-save';
      bar.dataset.stage60 = '1';
      bar.innerHTML = '<div><strong>Есть несохранённые изменения</strong><small>Сохрани или отмени правки</small></div><button type="button" class="btn-secondary" data-stage60-reset>Отменить изменения</button><button type="button" class="btn-main" data-stage60-submit>Сохранить</button>';
      document.body.appendChild(bar);
    }
    return bar;
  }
  function setupStrictDirty(){
    const forms = trackableForms();
    if (!forms.length) return;
    const bar = ensureBar();
    const baseline = new Map();
    let active = null;
    function snapshot(){ forms.forEach(function(f){ baseline.set(f, formDataString(f)); }); update(null, true); }
    function dirtyForms(){ return forms.filter(function(f){ return baseline.has(f) && formDataString(f) !== baseline.get(f); }); }
    function setVisible(on){
      document.querySelectorAll('.global-floating-save').forEach(function(b){
        b.classList.toggle('is-visible', !!on && b === bar);
      });
      document.body.classList.toggle('has-global-floating-save', !!on);
    }
    function update(form){
      const dirty = dirtyForms();
      active = form && dirty.includes(form) ? form : dirty[dirty.length - 1] || null;
      setVisible(dirty.length > 0);
      const small = bar.querySelector('small');
      if (small) small.textContent = dirty.length > 1 ? ('Несохранённых форм: ' + dirty.length) : 'Сохрани или отмени правки';
    }
    forms.forEach(function(form){
      if (form.dataset.stage60DirtyBound === '1') return;
      form.dataset.stage60DirtyBound = '1';
      form.addEventListener('input', function(){ setTimeout(function(){ update(form); }, 30); }, true);
      form.addEventListener('change', function(){ setTimeout(function(){ update(form); }, 80); }, true);
      form.addEventListener('submit', function(){ setVisible(false); }, true);
    });
    bar.querySelector('[data-stage60-reset]').onclick = function(){ location.reload(); };
    bar.querySelector('[data-stage60-submit]').onclick = function(){ const btn = active && safeSubmit(active); if (btn) btn.click(); else if (active) active.submit(); };
    // Snapshot after page scripts finish tab hiding, API auth sync and DOM reordering.
    snapshot();
    setTimeout(snapshot, 900);
    setTimeout(snapshot, 1800);
    setTimeout(snapshot, 2600);
    document.addEventListener('click', function(e){
      if (e.target.closest('[data-settings-tab], [data-tab-target], .settings-tabs, .desktop-page-tabs, .order-modal-row, [data-order-up], [data-order-down]')) {
        setTimeout(function(){ update(null); }, 120);
      }
    }, true);
    setInterval(function(){ if (!dirtyForms().length) setVisible(false); }, 700);
  }

  function activateFirstOrderedTabs(){
    document.querySelectorAll('.desktop-page-tabs[data-page-tabs]').forEach(function(tabbar){
      let requested = '';
      try { requested = new URL(location.href).searchParams.get('tab') || ''; } catch(_) {}
      const buttons = Array.from(tabbar.querySelectorAll('[data-tab-target]'));
      const target = requested || (buttons[0] && buttons[0].dataset.tabTarget) || '';
      if (!target) return;
      const scope = tabbar.parentElement || document;
      buttons.forEach(function(btn){ btn.classList.toggle('is-active', btn.dataset.tabTarget === target); });
      scope.querySelectorAll('[data-tab-panel]').forEach(function(panel){ panel.classList.toggle('is-active', panel.dataset.tabPanel === target); });
    });
    const settingsTabs = document.querySelector('.settings-tabs');
    if (settingsTabs) {
      let requested = '';
      try { requested = new URL(location.href).searchParams.get('settings_tab') || ''; } catch(_) {}
      const buttons = Array.from(settingsTabs.querySelectorAll('[data-settings-tab]'));
      const target = requested || (buttons[0] && buttons[0].dataset.settingsTab) || '';
      if (target) {
        buttons.forEach(function(btn){ btn.classList.toggle('is-active', btn.dataset.settingsTab === target); });
        document.querySelectorAll('.settings-tab-panel').forEach(function(panel){
          const active = panel.dataset.settingsTab === target || panel.id === target;
          panel.classList.toggle('is-active', active);
          panel.classList.toggle('settings-tab-hidden', !active);
        });
      }
    }
  }

  function setupOrderModalHardening(){
    document.addEventListener('click', function(e){
      const up = e.target.closest('#orderEditorModal [data-order-up]');
      const down = e.target.closest('#orderEditorModal [data-order-down]');
      const save = e.target.closest('#orderEditorModal [data-order-save-all]');
      const reset = e.target.closest('#orderEditorModal [data-order-reset-all]');
      if (up || down) {
        e.preventDefault(); e.stopPropagation();
        const row = (up || down).closest('.order-modal-row');
        if (row && row.parentNode) {
          if (up && row.previousElementSibling) row.parentNode.insertBefore(row, row.previousElementSibling);
          if (down && row.nextElementSibling) row.parentNode.insertBefore(row.nextElementSibling, row);
        }
      }
      if (save) { e.preventDefault(); e.stopPropagation(); if (window.__stage59OrderSave) window.__stage59OrderSave(); }
      if (reset) { e.preventDefault(); e.stopPropagation(); if (window.__stage59OrderReset) window.__stage59OrderReset(); }
    }, true);
  }

  function boot(){
    setupOrderModalHardening();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();
</script>

<script>
(function(){
  // stage63: synchronous order activation + strict dirty tracking based only on real user edits.
  const pageTabDefaults = { dashboard:'traffic', nodes:'list', diagnostics:'health' };

  function readOrder(key){
    try { const value = JSON.parse(localStorage.getItem(key) || '[]'); return Array.isArray(value) ? value : []; }
    catch (_) { return []; }
  }
  function applyOrder(root, selector, order, idOf){
    if (!root || !order.length) return;
    const items = Array.from(root.querySelectorAll(selector));
    const map = new Map(items.map(el => [idOf(el), el]));
    order.forEach(id => { const el = map.get(String(id)); if (el) root.appendChild(el); });
  }
  function activatePageOrder(){
    const sidebar = document.querySelector('.desktop-modern-nav');
    applyOrder(sidebar, ':scope > a', readOrder('agg.order.sidebar.v1'), el => el.getAttribute('href') || '');

    const tabbar = document.querySelector('.desktop-page-tabs[data-page-tabs]');
    if (tabbar) {
      const page = tabbar.dataset.pageTabs || 'page';
      const order = readOrder('agg.order.tabs.' + page + '.v1');
      applyOrder(tabbar, ':scope > button[data-tab-target]', order, el => el.dataset.tabTarget || '');
      let requested = '';
      try { requested = new URL(location.href).searchParams.get('tab') || ''; } catch (_) {}
      const buttons = Array.from(tabbar.querySelectorAll('[data-tab-target]'));
      const target = requested || (buttons[0] && buttons[0].dataset.tabTarget) || pageTabDefaults[page] || '';
      if (target) {
        buttons.forEach(btn => btn.classList.toggle('is-active', btn.dataset.tabTarget === target));
        document.querySelectorAll('[data-tab-panel]').forEach(panel => panel.classList.toggle('is-active', panel.dataset.tabPanel === target));
      }
    }

    const settings = document.querySelector('.settings-tabs');
    if (settings) {
      const order = readOrder('agg.order.settings.tabs.v1');
      applyOrder(settings, ':scope > button[data-settings-tab]', order, el => el.dataset.settingsTab || '');
      let requested = '';
      try { requested = new URL(location.href).searchParams.get('settings_tab') || ''; } catch (_) {}
      const buttons = Array.from(settings.querySelectorAll('[data-settings-tab]'));
      const target = requested || (buttons[0] && buttons[0].dataset.settingsTab) || '';
      if (target) {
        buttons.forEach(btn => btn.classList.toggle('is-active', btn.dataset.settingsTab === target));
        document.querySelectorAll('.settings-tab-panel').forEach(panel => {
          const active = panel.dataset.settingsTab === target || panel.id === target;
          panel.classList.toggle('is-active', active);
          panel.classList.toggle('settings-tab-hidden', !active);
        });
      }
    }
    document.documentElement.classList.remove('ui-order-preload');
  }

  function serialise(form){
    try {
      const fields = Array.from(form.elements || []).filter(el => {
        if (!el.name || el.disabled) return false;
        if (['submit','button','reset','image','file'].includes(String(el.type || '').toLowerCase())) return false;
        return true;
      });
      return fields.map(el => {
        const type = String(el.type || '').toLowerCase();
        const value = (type === 'checkbox' || type === 'radio') ? (el.checked ? '1:' + String(el.value || 'on') : '0') : String(el.value ?? '');
        return String(el.name) + '=' + value;
      }).sort().join('&');
    } catch (_) { return ''; }
  }
  function safeSubmit(form){
    return Array.from(form.querySelectorAll('button[type="submit"],input[type="submit"]')).find(btn => {
      const label = String(btn.textContent || btn.value || '').toLowerCase();
      const action = String(btn.getAttribute('formaction') || form.getAttribute('action') || '').toLowerCase();
      if (btn.disabled || btn.classList.contains('danger') || btn.classList.contains('btn-danger')) return false;
      if (/delete|remove|logout|toggle|check|test|refresh|sync|import|extend|create|reorder/.test(action)) return false;
      if (/удал|выйти|отключ|включ|провер|тест|обнов|импорт|синхрон|продл|создать|отправить|привязать/.test(label)) return false;
      return true;
    }) || null;
  }
  function trackableForms(){
    if (!/\/(routing|redirects|settings|telegram-bot|nodes|clients|diagnostics)/.test(location.pathname)) return [];
    return Array.from(document.querySelectorAll('main form[method="post"]')).filter(form => {
      if (form.matches('.logout-form,.sidebar-logout,.bulk-delete-form,.inline-form,.mini-extend-form,.extend-form')) return false;
      if (form.dataset.globalFloatingSave === 'off') return false;
      return !!form.querySelector('input:not([type="hidden"]),select,textarea') && !!safeSubmit(form);
    });
  }
  function setupStrictDirty(){
    document.querySelectorAll('.global-floating-save,.mobile-floating-save').forEach(el => el.remove());
    document.body.classList.remove('has-global-floating-save');
    const forms = trackableForms();
    if (!forms.length) return;

    const bar = document.createElement('div');
    bar.className = 'global-floating-save';
    bar.dataset.stage63 = '1';
    bar.innerHTML = '<div><strong>Есть несохранённые изменения</strong><small>Сохрани или отмени правки</small></div><button type="button" class="btn-secondary" data-stage63-reset>Отменить изменения</button><button type="button" class="btn-main" data-stage63-submit>Сохранить</button>';
    document.body.appendChild(bar);
    const baseline = new Map();
    const explicitlyDirty = new Set();
    let active = null;
    let ready = false;

    // Важно: состояние «изменено» устанавливается только после доверенного
    // input/change от реального поля. Программные переключения вкладок,
    // автозаполнение и обычные клики больше не могут открыть эту панель.
    function snapshot(){
      forms.forEach(form => baseline.set(form, serialise(form)));
      explicitlyDirty.clear();
      ready = true;
      render();
    }
    function dirtyForms(){
      if (!ready) return [];
      return forms.filter(form => explicitlyDirty.has(form) && serialise(form) !== baseline.get(form));
    }
    function render(preferred){
      // Если пользователь вернул исходное значение — форма снова чистая.
      explicitlyDirty.forEach(form => {
        if (!baseline.has(form) || serialise(form) === baseline.get(form)) explicitlyDirty.delete(form);
      });
      const dirty = dirtyForms();
      active = preferred && dirty.includes(preferred) ? preferred : (dirty[dirty.length - 1] || null);
      const visible = dirty.length > 0;
      bar.classList.toggle('is-visible', visible);
      document.body.classList.toggle('has-global-floating-save', visible);
      const small = bar.querySelector('small');
      if (small) small.textContent = dirty.length > 1 ? `Несохранённых форм: ${dirty.length}` : 'Сохрани или отмени правки';
    }
    let lastIntentField = null;
    let lastIntentAt = 0;
    function resolveIntentField(target){
      if (!target) return null;
      if (target.matches && target.matches('input,select,textarea')) return target;
      const label = target.closest && target.closest('label');
      return label && label.control && label.control.matches('input,select,textarea') ? label.control : null;
    }
    document.addEventListener('pointerdown', event => {
      lastIntentField = resolveIntentField(event.target);
      lastIntentAt = lastIntentField ? Date.now() : 0;
    }, true);
    document.addEventListener('keydown', () => {
      const activeField = document.activeElement && document.activeElement.matches && document.activeElement.matches('input,select,textarea') ? document.activeElement : null;
      lastIntentField = activeField;
      lastIntentAt = activeField ? Date.now() : 0;
    }, true);

    function onRealEdit(event){
      if (!event.isTrusted || !ready) return;
      const target = event.target;
      if (!target || !target.matches('input,select,textarea')) return;
      // Панель появляется только после прямого действия пользователя именно
      // с этим полем. Клик по вкладке, пустому месту или программное событие
      // больше не могут пометить форму изменённой.
      if (lastIntentField !== target || Date.now() - lastIntentAt > 15000) return;
      const form = target.closest('form');
      if (!form || !baseline.has(form)) return;
      // Для input значение уже обновлено; небольшой defer нужен только для
      // select/checkbox и зависимых полей, которые меняются тем же действием.
      setTimeout(() => {
        if (serialise(form) !== baseline.get(form)) explicitlyDirty.add(form);
        else explicitlyDirty.delete(form);
        render(form);
      }, 0);
    }
    forms.forEach(form => {
      form.addEventListener('input', onRealEdit, true);
      form.addEventListener('change', onRealEdit, true);
      form.addEventListener('submit', () => { bar.classList.remove('is-visible'); document.body.classList.remove('has-global-floating-save'); }, true);
    });
    bar.querySelector('[data-stage63-reset]').addEventListener('click', () => location.reload());
    bar.querySelector('[data-stage63-submit]').addEventListener('click', () => {
      const button = active && safeSubmit(active);
      if (button) button.click(); else if (active) active.requestSubmit ? active.requestSubmit() : active.submit();
    });

    const cleanup = new MutationObserver(() => {
      document.querySelectorAll('.global-floating-save:not([data-stage63="1"]),.mobile-floating-save').forEach(el => el.remove());
    });
    cleanup.observe(document.body, { childList:true, subtree:false });

    snapshot();
    // Один отложенный снимок поглощает только стартовую программную
    // инициализацию. После первого реального изменения эталон не переписывается.
    setTimeout(() => { if (!explicitlyDirty.size) snapshot(); }, 950);
  }

  activatePageOrder();
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setupStrictDirty, { once:true });
  else setupStrictDirty();
  requestAnimationFrame(() => document.documentElement.classList.remove('ui-order-preload'));
})();
</script>
<script>
(function aggToasts(){
  // stage87 — превращаем полосы-алерты вверху страницы во всплывающие уведомления.
  const main = document.querySelector('.main');
  if (!main) return;
  const alerts = Array.from(main.querySelectorAll(':scope > .alert, .spectrum-page-content > .alert')).filter(el => el.classList && (el.classList.contains('ok') || el.classList.contains('err')));
  if (!alerts.length) return;
  const stack = document.createElement('div');
  stack.className = 'agg-toast-stack';
  const hasError = alerts.some(alert => alert.classList.contains('err'));
  stack.setAttribute('role', hasError ? 'alert' : 'status');
  stack.setAttribute('aria-live', hasError ? 'assertive' : 'polite');
  document.body.appendChild(stack);
  alerts.forEach(alert => {
    stack.appendChild(alert);
    const close = document.createElement('button');
    close.type = 'button';
    close.className = 'agg-toast-close';
    close.setAttribute('aria-label', 'Закрыть уведомление');
    close.textContent = '×';
    alert.appendChild(close);
    let hideTimer = 0;
    function hide(){
      if (!alert.parentNode) return;
      alert.classList.add('agg-toast-out');
      setTimeout(() => { if (alert.parentNode) alert.parentNode.removeChild(alert); }, 260);
    }
    close.addEventListener('click', hide);
    const isError = alert.classList.contains('err');
    hideTimer = setTimeout(hide, isError ? 15000 : 5000);
    alert.addEventListener('mouseenter', () => clearTimeout(hideTimer), { once: true });
  });
})();
</script>

