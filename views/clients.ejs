    <p class="muted" id="applySelectedNames"></p>
    <form id="applySelectedForm" method="post" action="/clients/apply-to-node" class="js-long-action" data-loading-title="Применяю выбранных клиентов" data-loading-text="На выбранном узле создаются или обновляются только явно отмеченные клиенты." onsubmit="return prepareApplySelectedSubmit(event)">
      <div class="form-grid clean-form">
        <div class="field">
          <label>Узел, куда добавить или обновить клиентов</label>
          <select name="node_id" required>
            <% nodes.forEach(node => { %>
              <option value="<%= node.id %>" data-node-type="<%= String(node.node_type || '3xui') %>"><%= flagText(node.country_code, node.country_flag, node.country_name_ru || node.name) %> <%= nodeName(node) %> (<%= nodeEndpointLabel(node) %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="field half">
          <label>Лимит IP</label>
          <input name="limit_ip" type="number" min="0" placeholder="сохранить текущий" />
        </div>
        <div class="field half">
          <label>Лимит ГБ</label>
          <input name="traffic_gb" type="number" min="0" step="1" placeholder="сохранить текущий" />
        </div>
      </div>
      <div class="modal-actions">
        <button type="submit" class="btn-main">Применить к выбранным</button>
      </div>
    </form>
