            <div class="field half">
              <label>VPN-сервис</label>
              <select id="clientsVpnService" required>
                <% vpnServices.forEach(service => { %>
                  <option value="<%= service.id %>"><%= vpnProtocolLabels[service.protocol] || service.protocol %> · <%= service.name %> · <%= service.host_name %></option>
                <% }) %>
              </select>
            </div>
            <div class="field half">
              <label>Имя клиента</label>
              <input name="name" required placeholder="Например: iphone-alex" autocomplete="off" />
            </div>
            <div class="field half">
              <label>Связать с основным клиентом</label>
              <select name="aggregator_client_id">
                <option value="">Не связывать</option>
                <% vpnAggregatorClients.forEach(item => { %><option value="<%= item.id %>"><%= item.display_name || item.login %> · <%= item.login %></option><% }) %>
              </select>
            </div>
            <div class="field half">
              <label>Срок доступа, дней</label>
              <input name="duration_days" type="number" min="0" max="3650" value="30" required />
