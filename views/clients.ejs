<% clients.forEach(client => {
  const clientEnabled = client.enabled !== 0;
  const clientReturnPath = '/clients?' + new URLSearchParams({ ...(q ? { q } : {}), edit: String(client.id) }).toString();
  const canShowSubInEditor = Boolean(showSubLinks);
%>
  <div id="clientEditor-<%= client.id %>" class="modal hidden client-editor-shell" onclick="closeClientEditor(event, <%= client.id %>)">
    <div class="modal-card editor-modal client-editor-modal existing-client-editor-modal" onclick="event.stopPropagation()">
      <button type="button" class="modal-close" onclick="event.preventDefault(); event.stopPropagation(); hideClientEditor(<%= client.id %>); return false;">×</button>
      <h2>Клиент: <%= compactTitle(client) %></h2>
      <p class="muted">Подробная информация и редактор клиента в одном окне.</p>
      <div class="client-detail-summary client-editor-summary">
        <div class="client-summary-id"><span>ID</span><strong><%= client.id %></strong></div>
        <div><span>Статус</span><strong class="badge <%= clientStatusMeta(client).key %>"><%= clientStatusMeta(client).label %></strong></div>
        <div><span>Срок</span><strong><%= termShort(client) %> дн.</strong><small>до <%= expiryDateTime(client.expiry_time) %></small></div>
        <div><span>Общий лимит</span><strong><%= client.traffic_gb && client.traffic_gb > 0 ? client.traffic_gb + ' ГБ' : '∞' %></strong></div>
        <div><span>Лимит IP</span><strong><%= client.limit_ip && Number(client.limit_ip) > 0 ? client.limit_ip : '∞' %></strong></div>
        <div><span>Узлов</span><strong><%= clientAssignedNodes(client).length %></strong></div>
        <div class="client-summary-uuid"><span>UUID</span><code><%= client.uuid %></code></div>
        <div>
          <span><%= canShowSubInEditor ? 'SUB / JSON' : 'JSON' %></span>
          <div class="client-summary-link-actions">
            <% if (canShowSubInEditor) { %><button type="button" class="btn-secondary compact-copy-btn" onclick="copySubLink('<%= baseUrl %>/sub-plain/<%= client.sub_slug %>', this)">SUB</button><% } %>
            <button type="button" class="btn-secondary compact-copy-btn" onclick="copySubLink('<%= baseUrl %>/json/<%= client.sub_slug %>?raw=1', this)"><%= canShowSubInEditor ? 'JSON' : 'Копировать JSON' %></button>
          </div>
        </div>
        <div>
          <span>QR</span>
          <div class="client-summary-link-actions">
            <% if (canShowSubInEditor) { %><button type="button" class="btn-secondary" onclick="showQr('<%= baseUrl %>/sub-plain/<%= client.sub_slug %>', '<%= client.login %> · Общая SUB')">SUB QR</button><% } %>
            <button type="button" class="btn-secondary" onclick="showQr('<%= baseUrl %>/json/<%= client.sub_slug %>?raw=1', '<%= client.login %> · JSON')"><%= canShowSubInEditor ? 'JSON QR' : 'Показать QR' %></button>
          </div>
        </div>
      </div>

      <form method="post" action="/clients/<%= client.id %>/edit" class="js-long-action client-editor-form" data-loading-title="Сохраняю клиента" data-loading-text="Изменения применяются на узлах клиента. Это может занять время.">
        <input type="hidden" name="back" value="<%= clientReturnPath %>" />
        <div class="form-grid clean-form client-editor-fields">
          <div class="field half">
            <label>Имя клиента</label>
            <input name="display_name" value="<%= client.display_name %>" required />
          </div>
          <div class="field half">
            <label>Логин / Email</label>
            <input name="login" value="<%= client.login %>" required />
          </div>
          <div class="field half client-editor-comment-field">
            <label>Комментарий</label>
            <input name="comment" value="<%= client.comment || '' %>" placeholder="Заметка для поиска" />
          </div>
          <div class="field half">
            <label>Группа</label>
            <select name="group_id"><option value="">Без группы</option><% clientGroups.forEach(group => { %><option value="<%= group.id %>" <%= Number(client.group_id) === Number(group.id) ? 'selected' : '' %>><%= group.name %></option><% }) %></select>
          </div>
          <div class="field half">
            <label>Метки</label>
            <div class="client-label-picker"><% if (!clientTags.length) { %><small class="hint">Метки ещё не созданы.</small><% } %><% clientTags.forEach(tag => { const selected = (client.tags || []).some(item => Number(item.id) === Number(tag.id)); %><label><input type="checkbox" name="tag_ids" value="<%= tag.id %>" <%= selected ? 'checked' : '' %>><span class="client-tag-chip" style="--chip-color:<%= tag.color %>"><%= tag.name %></span></label><% }) %></div>
          </div>
          <div class="field half">
            <label>Лимит IP</label>
            <input name="limit_ip" type="number" min="0" value="<%= client.limit_ip ?? 1 %>" />
          </div>
          <div class="field half">
            <label>Новый срок в днях</label>
            <input name="duration_days" type="number" min="0" value="" placeholder="не менять" />
            <small class="hint">Сейчас: <%= termShort(client) %> дн., до <%= expiryDateTime(client.expiry_time) %>. Пусто = не менять, 0 = убрать срок.</small>
          </div>
          <div class="field half">
            <label>Общий лимит трафика, ГБ</label>
            <input name="traffic_gb" type="number" min="0" step="1" value="<%= client.traffic_gb || 0 %>" />
          </div>
        </div>

        <div class="nodes-head node-bulk-head edit-node-bulk-head">
          <div>
            <h3>Узлы клиента</h3>
            <p class="muted">Снимите галочку, чтобы отключить клиенту конкретный узел. Поле ГБ задаёт лимит только для этого региона; пусто = общий лимит.</p>
          </div>
          <div class="node-select-actions" aria-label="Быстрый выбор узлов клиента">
            <button type="button" class="btn-secondary node-select-btn" data-node-check-set="all" aria-pressed="false" onclick="event.stopPropagation(); return setClientNodeSelection(this, true)">Выбрать все</button>
            <button type="button" class="btn-secondary node-select-btn" data-node-check-set="none" aria-pressed="false" onclick="event.stopPropagation(); return setClientNodeSelection(this, false)">Снять все</button>
          </div>
        </div>
        <div class="checkbox-list node-list">
          <% client.node_limits.forEach(row => {
            const nodeLabel = nodeName(row);
          %>
            <label class="node-item node-edit-row">
              <input class="inline" type="checkbox" name="node_enabled_<%= row.node_id %>" value="1" <%= row.client_node_id && row.enabled !== 0 ? 'checked' : '' %> />
              <span class="node-info"><strong><%- flagIcon(row.country_code, row.country_flag, row.country_name_ru || row.node_name || row.name, row.node_type) %><span><%= nodeLabel %></span></strong><small><%= row.client_node_id ? (row.enabled !== 0 ? 'узел включён' : 'узел отключён для клиента') : 'узел не назначен' %></small></span>
              <input class="node-gb-input" name="node_traffic_gb_<%= row.node_id %>" type="number" min="0" step="1" value="<%= row.traffic_gb || '' %>" placeholder="ГБ" />
            </label>
          <% }) %>
        </div>
        <div class="modal-actions">
          <button type="submit" class="btn-main">Сохранить</button>
        </div>
      </form>

      <hr class="soft-sep" />

      <form method="post" action="/clients/<%= client.id %>/extend" class="extend-form js-long-action" data-loading-title="Продлеваю клиента" data-loading-text="Срок продлевается на узлах клиента.">
        <input type="hidden" name="back" value="<%= clientReturnPath %>" />
        <label>Продлить срок</label>
        <div class="btn-row stretch-row">
          <input name="days" type="number" min="1" value="30" />
          <button type="submit" class="btn-main">Продлить</button>
        </div>
      </form>

      <form method="post" action="/clients/<%= client.id %>/toggle" class="modal-actions js-long-action" data-loading-title="Меняю статус" data-loading-text="Статус клиента применяется на узлах.">
        <input type="hidden" name="back" value="<%= clientReturnPath %>" />
        <button type="submit" class="<%= clientEnabled ? 'btn-danger' : 'btn-secondary' %>"><%= clientEnabled ? 'Отключить клиента' : 'Включить клиента' %></button>
      </form>
    </div>
  </div>
<% }) %>

<% clients.forEach(client => { %>
  <% const details = (client.node_limits || []).filter(nl => nl.client_node_id && ((nl.traffic_gb && nl.traffic_gb > 0) || nl.enabled === 0)); %>
  <% if (details.length) { %>
    <div id="limitDetails-<%= client.id %>" class="modal hidden" onclick="closeLimitDetails(event, <%= client.id %>)">
      <div class="modal-card limit-details-card" onclick="event.stopPropagation()">
        <button type="button" class="modal-close" onclick="hideLimitDetails(<%= client.id %>)">×</button>
        <h2>Лимиты узлов</h2>
        <p class="muted"><%= client.login %></p>
        <div class="limit-details-list">
          <% details.forEach(nl => { %>
            <div class="limit-details-row <%= nl.enabled === 0 ? 'disabled' : '' %>">
              <span><%= nodeName(nl) %><% if (nl.transport_label) { %> <em class="transport-chip"><%= nl.transport_label %></em><% } %></span>
              <strong><%= nodeLimitText(nl) %></strong>
              <% if (nl.enabled !== 0 && nl.traffic_gb > 0) { %><small>осталось <%= nodeRemainingText(nl) %></small><% } %>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  <% } %>
<% }) %>

<% } else { %>
  <div id="createVpnClientModal" class="modal hidden" onclick="closeModalById(event, 'createVpnClientModal')">
