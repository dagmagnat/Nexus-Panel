          </div>
          <div class="modal-actions"><button type="submit" class="btn-main">Создать конфигурацию</button></div>
        </form>
      <% } %>
    </div>
  </div>

  <% vpnClients.forEach(client => {
    const expires = Number(client.expires_at || 0);
    const returnPath = '/clients?type=' + encodeURIComponent(clientType) + (q ? '&q=' + encodeURIComponent(q) : '');
  %>
    <div id="vpnClientEditor-<%= client.id %>" class="modal hidden" onclick="closeModalById(event, 'vpnClientEditor-<%= client.id %>')">
      <div class="modal-card editor-modal client-editor-modal existing-client-editor-modal" onclick="event.stopPropagation()">
        <button type="button" class="modal-close" onclick="hideModalById('vpnClientEditor-<%= client.id %>')">×</button>
        <h2><%= client.name %></h2>
        <p class="muted"><%= vpnProtocolLabels[client.protocol] || client.protocol %> · <%= client.service_name %> · <%= client.host_name %></p>
        <div class="client-detail-summary vpn-client-detail-summary">
          <div><span>ID</span><strong><%= client.id %></strong></div>
          <div><span>Адрес</span><code><%= client.address || 'Outline key' %></code></div>
          <div><span>Статус</span><strong><%= client.enabled === 0 ? 'Отключён' : 'Активен' %></strong></div>
          <div><span>Действует до</span><strong><%= expires > 0 ? new Date(expires).toLocaleString('ru-RU') : 'Без ограничения' %></strong></div>
        </div>
        <div class="vpn-editor-downloads">
          <a class="link-btn" href="/vpn/clients/<%= client.id %>/config">Скачать конфигурацию</a>
          <button type="button" class="btn-secondary" data-vpn-qr-url="/vpn/clients/<%= client.id %>/qr" data-vpn-qr-title="<%= client.name %>" onclick="showVpnQr(this.dataset.vpnQrUrl, this.dataset.vpnQrTitle)">Показать QR-код</button>
        </div>
        <form method="post" action="/vpn/clients/<%= client.id %>/rename" class="form-grid vpn-client-rename-form">
          <input type="hidden" name="back" value="<%= returnPath %>" />
          <label>Имя клиента<input name="name" value="<%= client.name %>" required /></label>
          <div class="button-row"><button type="submit" class="btn-main">Сохранить имя</button></div>
        </form>
        <form method="post" action="/vpn/clients/<%= client.id %>/extend" class="vpn-editor-inline-form">
          <input type="hidden" name="back" value="<%= returnPath %>" />
          <label>Продлить<input name="days" type="number" min="0" max="3650" value="30" /></label>
          <button type="submit" class="btn-secondary">Продлить</button>
