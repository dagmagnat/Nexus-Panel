<div class="card danger-zone-card">
  <h2>Массовое удаление</h2>
  <form id="deleteAllClientsForm" method="post" action="/clients/delete-all" class="js-long-action" data-loading-title="Удаляю всех клиентов" data-loading-text="Недоступные и удалённые узлы будут пропущены; локальные связи будут очищены." onsubmit="return openDeleteAllClientsConfirm(event)">
    <input type="hidden" name="delete_all_confirmation" value="" id="deleteAllConfirmation" />
    <label>Режим удаления</label>
    <select name="delete_mode" id="deleteAllMode">
      <option value="aggregator">Только из агрегатора</option>
      <option value="secondary">Из агрегатора и вторичных узлов</option>
      <option value="all">Из агрегатора и всех узлов</option>
