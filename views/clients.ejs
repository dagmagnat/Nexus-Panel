let clientOnlineRefreshPending = false;
let clientOnlineInitialized = false;

function clientOnlineKey(value) {
  return normalizeClientDirectoryText(value || '');
}

async function refreshClientOnlineSummary() {
  const target = document.getElementById('clientOnlineNowCount');
  if (!target || clientOnlineRefreshPending) return;
  clientOnlineRefreshPending = true;
  const onlineCard = target.closest('[data-client-status-shortcut="online"]');
  const controller = new AbortController();
  const timeout = window.setTimeout(() => controller.abort(), 12000);
  try {
    const response = await fetch('/dashboard/online-clients.json?_=' + Date.now(), {
      headers: { Accept: 'application/json' },
      cache: 'no-store',
      signal: controller.signal
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.error || 'Ошибка проверки');

    const list = Array.isArray(data.clients) ? data.clients : [];
    const onlineIds = new Set();
    const onlineKeys = new Set();
    list.forEach(item => {
      const id = String(item.id || item.clientId || item.client_id || '').trim();
      if (id) onlineIds.add(id);
      [item.login, item.display_name, item.uuid, item.sub_slug].forEach(value => {
        const key = clientOnlineKey(value);
        if (key) onlineKeys.add(key);
      });
    });

    document.querySelectorAll('[data-client-entry][data-client-id-entry]').forEach(entry => {
      const id = String(entry.dataset.clientIdEntry || '').trim();
      const loginKey = clientOnlineKey(entry.dataset.clientLogin || '');
      const uuidKey = clientOnlineKey(entry.dataset.clientUuid || '');
      const isOnline = onlineIds.has(id) || (loginKey && onlineKeys.has(loginKey)) || (uuidKey && onlineKeys.has(uuidKey));
      const wasOnline = entry.dataset.clientOnline === '1';
      entry.dataset.clientOnline = isOnline ? '1' : '0';
      entry.classList.toggle('is-online-now', isOnline);
      if (clientOnlineInitialized && isOnline && !wasOnline && entry.dataset.clientView === 'modern') {
        entry.classList.remove('is-just-online');
        void entry.offsetWidth;
        entry.classList.add('is-just-online');
        window.setTimeout(() => entry.classList.remove('is-just-online'), 4500);
      }
    });

    target.textContent = String(onlineIds.size);
    target.title = data.errors?.length ? data.errors.join(' | ') : `Сейчас в сети: ${onlineIds.size}`;
    onlineCard?.classList.toggle('has-online', onlineIds.size > 0);
    onlineCard?.classList.remove('online-check-error');
    onlineCard?.setAttribute('aria-label', `Показать клиентов в сети: ${onlineIds.size}`);

    document.querySelectorAll('[data-modern-online-state]').forEach(state => {
      if (state.dataset.onlineEligible !== '1') return;
      const id = String(state.dataset.clientId || '').trim();
      const isOnline = onlineIds.has(id);
      state.classList.toggle('online', isOnline);
      state.classList.toggle('offline', !isOnline);
      state.setAttribute('aria-live', 'polite');
      const label = state.querySelector('b');
      if (label) label.textContent = isOnline ? 'В сети' : 'Не в сети';
      const onlineClient = list.find(item => String(item.id || item.clientId || item.client_id || '') === id);
      const nodeNames = isOnline && Array.isArray(onlineClient?.nodes)
        ? onlineClient.nodes.map(node => node.publicName || node.name || 'Узел').filter(Boolean)
        : [];
      state.title = isOnline
        ? `Клиент в сети${nodeNames.length ? ': ' + nodeNames.join(', ') : ''}`
        : 'Клиент сейчас не обнаружен на активных узлах';
    });

    clientOnlineInitialized = true;
    if (clientDirectoryState.sort === 'online') applyClientDirectoryFilters();
  } catch (err) {
    if (!clientOnlineInitialized) target.textContent = '—';
    target.title = err.name === 'AbortError' ? 'Проверка онлайн превысила 12 секунд' : (err.message || String(err));
    onlineCard?.classList.add('online-check-error');
  } finally {
    window.clearTimeout(timeout);
    clientOnlineRefreshPending = false;
  }
}

function setupClientOverviewShortcuts() {
  document.querySelectorAll('[data-client-status-shortcut]').forEach(button => {
    button.addEventListener('click', () => {
      const requested = button.dataset.clientStatusShortcut || 'all';
      const mode = requested === 'all' ? 'newest' : requested;
      const sort = document.getElementById('clientSortMode');
      if (!sort || !clientDirectorySortModes.includes(mode)) return;
      sort.value = mode;
      clientDirectoryState.sort = mode;
      applyClientDirectoryFilters();
      document.querySelectorAll('[data-client-status-shortcut]').forEach(item => item.classList.toggle('is-selected', item === button));
    });
  });
}

let clientOnlineAutoTimer = null;
function configureClientOnlineAutoRefresh() {
  const toggle = document.getElementById('clientOnlineAutoRefresh');
  const select = document.getElementById('clientOnlineRefreshInterval');
  if (!toggle || !select) return;
  if (clientOnlineAutoTimer) window.clearInterval(clientOnlineAutoTimer);
  clientOnlineAutoTimer = null;
  select.disabled = !toggle.checked;
  try {
    localStorage.setItem('nexus.clients.onlineAuto', toggle.checked ? '1' : '0');
    localStorage.setItem('nexus.clients.onlineInterval', String(select.value || '10'));
  } catch (_) {}
  if (!toggle.checked) return;
  const seconds = [10, 30, 60].includes(Number(select.value)) ? Number(select.value) : 10;
  clientOnlineAutoTimer = window.setInterval(() => {
    if (!document.hidden) refreshClientOnlineSummary();
  }, seconds * 1000);
}

function setupClientOnlineAutoRefresh() {
  const toggle = document.getElementById('clientOnlineAutoRefresh');
  const select = document.getElementById('clientOnlineRefreshInterval');
  try {
    if (toggle) toggle.checked = localStorage.getItem('nexus.clients.onlineAuto') !== '0';
    const storedInterval = localStorage.getItem('nexus.clients.onlineInterval');
    if (select && ['10', '30', '60'].includes(storedInterval)) select.value = storedInterval;
  } catch (_) {}
  toggle?.addEventListener('change', configureClientOnlineAutoRefresh);
  select?.addEventListener('change', configureClientOnlineAutoRefresh);
  document.getElementById('clientOnlineRefreshNow')?.addEventListener('click', refreshClientOnlineSummary);
  configureClientOnlineAutoRefresh();
}


document.addEventListener('DOMContentLoaded', () => {
  setupMobileClientFilters();
  setupClientOverviewShortcuts();
  setupClientOnlineAutoRefresh();
  refreshClientOnlineSummary();
  document.querySelectorAll('.client-check[data-client-id]').forEach(cb => {
    cb.addEventListener('change', () => {
      syncClientCheckboxCopies(cb);
      const selected = getUniqueClientSelection();
      const all = getAllClientIdsOnPage();
      document.querySelectorAll('.clients-table thead input[type="checkbox"]').forEach(master => {
        master.checked = all.size > 0 && selected.size === all.size;
        master.indeterminate = selected.size > 0 && selected.size < all.size;
      });
      updateBulkSelectionUi();
    });
  });
  document.querySelectorAll('[data-client-edit-card]').forEach(card => {
    card.addEventListener('click', event => {
      if (event.target.closest('button, a, input, select, textarea, label, form')) return;
      openClientEditor(card.dataset.clientEditCard);
    });
  });
  updateBulkSelectionUi();
  const editId = new URLSearchParams(window.location.search).get('edit');
  if (editId && document.getElementById('clientEditor-' + editId)) openClientEditor(editId);
  const vpnService = document.getElementById('clientsVpnService');
  const vpnForm = document.getElementById('clientsVpnCreateForm');
  if (vpnService && vpnForm) {
    const syncAction = () => { vpnForm.action = '/vpn/services/' + encodeURIComponent(vpnService.value) + '/clients'; };
    vpnService.addEventListener('change', syncAction);
    syncAction();
  }
  setupClientDirectory();
  if (!clientDirectoryMode) {
    document.querySelectorAll('form[data-live-client-search]').forEach(form => {
      const input = form.querySelector('input[name="q"]');
      if (!input) return;
      let timer = null;
      let lastSubmitted = String(input.value || '');
      input.addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(() => {
          const value = String(input.value || '');
          if (value === lastSubmitted) return;
          lastSubmitted = value;
          if (typeof form.requestSubmit === 'function') form.requestSubmit(); else form.submit();
        }, 650);
      });
    });
  }
});
function setOperationNodeSelection(button, name, checked) {
  const form = button && button.closest ? button.closest('form') : null;
  if (!form) return false;
  form.querySelectorAll('input[type="checkbox"][name="' + name + '"]').forEach(input => {
    if (!input.disabled) input.checked = Boolean(checked);
  });
  return false;
}

function syncImportTargetSource(form) {
  if (!form) return;
  const source = form.querySelector('[data-import-source]');
  const sourceId = String(source && source.value || '');
  form.querySelectorAll('input[name="target_node_ids"]').forEach(input => {
    const isSource = String(input.value) === sourceId;
    input.disabled = isSource;
    if (isSource) input.checked = false;
    const row = input.closest('.node-item');
    if (row) {
      row.classList.toggle('disabled', isSource);
      row.title = isSource ? 'Это узел-источник; он не перезаписывается при импорте.' : '';
    }
  });
}

function syncImportModeUi(form) {
  if (!form) return;
  const mode = form.querySelector('[data-import-mode]');
  const box = form.querySelector('[data-import-target-box]');
  const enabled = String(mode && mode.value || 'local') === 'selected';
  if (box) box.hidden = !enabled;
  form.querySelectorAll('input[name="target_node_ids"]').forEach(input => {
    if (!enabled) input.checked = false;
  });
  syncImportTargetSource(form);
}

function validateLongOperationSelection(event) {
  const form = event.target;
  if (!(form instanceof HTMLFormElement)) return;
  if (form.matches('form[action="/clients/import"]')) {
    const mode = String(form.querySelector('[name="import_mode"]')?.value || 'local');
    const selected = form.querySelectorAll('input[name="target_node_ids"]:checked:not(:disabled)').length;
    if (mode === 'selected' && selected === 0) {
      event.preventDefault();
      alert('Отметьте хотя бы один целевой узел. Узел-источник автоматически исключён.');
      return;
    }
    if (mode === 'selected' && !confirm('Импорт затронет только отмеченные целевые узлы: ' + selected + '. Продолжить?')) {
      event.preventDefault();
      return;
    }
  }
  if (form.matches('form[action="/clients/sync-nodes"]')) {
    const selected = form.querySelectorAll('input[name="node_ids"]:checked:not(:disabled)').length;
    if (selected === 0) {
      event.preventDefault();
      alert('Отметьте хотя бы один узел для синхронизации.');
      return;
    }
    if (!confirm('Будут созданы или обновлены клиенты на выбранных узлах: ' + selected + '. Продолжить?')) {
      event.preventDefault();
    }
  }
}
document.addEventListener('submit', validateLongOperationSelection, true);

function showLoading(title, text) {
  const modal = document.getElementById('loadingModal');
  if (!modal) return;
  document.getElementById('loadingTitle').textContent = title || 'Загрузка';
  document.getElementById('loadingText').textContent = text || 'Операция выполняется. Не закрывайте страницу.';
  modal.classList.remove('hidden');
}
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('form.import-sync-form').forEach(form => syncImportModeUi(form));
  document.querySelectorAll('form.js-long-action').forEach(form => {
    form.addEventListener('submit', (event) => {
      if (!event.defaultPrevented) showLoading(form.dataset.loadingTitle, form.dataset.loadingText);
    });
  });
  document.addEventListener('click', (event) => {
    const btn = event.target.closest('[data-node-check-set]');
    if (!btn || event.defaultPrevented) return;
    event.preventDefault();
    setClientNodeSelection(btn, btn.dataset.nodeCheckSet === 'all');
  });
});
document.addEventListener('keydown', (event) => {
  if (event.key !== 'Escape') return;
  const openModal = Array.from(document.querySelectorAll('#createClientModal, #createVpnClientModal, #clientTransferModal, [id^="clientEditor-"], [id^="vpnClientEditor-"]')).find(modal => !modal.classList.contains('hidden'));
  if (openModal) { openModal.classList.add('hidden'); syncClientModalScrollLock(); }
});
</script>

