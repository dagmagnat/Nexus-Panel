      <button type="button" class="modal-close" onclick="hideModalById('createVpnClientModal')">×</button>
      <h2>Создать клиента: <%= currentClientTypeLabel %></h2>
      <% if (!vpnServices.length) { %>
        <div class="alert err">Нет установленного сервиса этого типа. Сначала откройте «VPN-сервисы», создайте сервис и выполните установку.</div>
        <div class="modal-actions"><a class="link-btn" href="/vpn?tab=services">Перейти к сервисам</a></div>
      <% } else { %>
        <form method="post" action="/vpn/services/<%= vpnServices[0].id %>/clients" id="clientsVpnCreateForm" class="js-long-action" data-loading-title="Создаю VPN-клиента" data-loading-text="Панель создаёт ключи и добавляет клиента на выбранный VPS.">
          <input type="hidden" name="back" value="/clients?type=<%= clientType %>" />
