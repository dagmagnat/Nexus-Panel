<%- include('partials_header', { pageTitle: 'Клиенты', pageSubtitle: 'Xray / Reality, подписки, лимиты и управление доступом', activePage: 'clients' }) %>
<%
  function flagEmojiFromCode(code) {
    const cc = String(code || '').trim().toUpperCase();
    if (!/^[A-Z]{2}$/.test(cc) || ['ZZ','XX'].includes(cc)) return '';
    return Array.from(cc).map(ch => String.fromCodePoint(0x1F1E6 + ch.charCodeAt(0) - 65)).join('');
  }
  function nodeFallbackIcon(nodeType) {
    const kind = String(nodeType || '') === 'remnawave' ? 'remnawave' : '3xui';
    const label = kind === 'remnawave' ? 'Remnawave' : '3x-ui';
    const glyph = kind === 'remnawave'
      ? '<circle cx="12" cy="12" r="2.2"/><path d="M7.8 16.2a6 6 0 0 1 0-8.4M16.2 7.8a6 6 0 0 1 0 8.4M5 19a10 10 0 0 1 0-14M19 5a10 10 0 0 1 0 14"/>'
      : '<rect x="4" y="5" width="16" height="5.5" rx="1.6"/><rect x="4" y="13.5" width="16" height="5.5" rx="1.6"/><path d="M7 7.8h.01M7 16.2h.01"/>';
    return `<span class="node-flag node-type-fallback node-type-${kind}" aria-label="${label}" title="${label}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${glyph}</svg></span>`;
  }
  function flagIcon(code, fallback, name, nodeType) {
    const rawCode = String(code || '').trim().toUpperCase();
    const fb = String(fallback || '').trim();
    const nameText = String(name || '').trim();
    const emoji = (typeof countryFlagText === 'function')
      ? countryFlagText(rawCode, fb, nameText)
      : ((fb && fb !== '🌐' && !/^[a-z]{2}$/i.test(fb)) ? fb : flagEmojiFromCode(rawCode || fb));
    const cc2 = String(rawCode || (/^[a-z]{2}$/i.test(fb) ? fb : '')).trim().toLowerCase();
    if (/^[a-z]{2}$/.test(cc2) && !['zz','xx'].includes(cc2)) {
      return '<img class="node-flag flag-img" src="/flags/' + cc2 + '.svg" alt="' + cc2.toUpperCase() + '" loading="lazy" onerror="this.style.display=\'none\'">';
    }
    return emoji && emoji !== '🌐'
      ? '<span class="node-flag emoji-fallback" aria-label="' + rawCode + '">' + emoji + '</span>'
      : nodeFallbackIcon(nodeType);
  }
  function clientActionIcon(name) {
    const paths = {
      info: '<circle cx="12" cy="12" r="8.5"/><path d="M12 10.7v5.1"/><path d="M12 7.6h.01"/>',
      qr: '<rect x="3.5" y="3.5" width="6" height="6" rx=".8"/><rect x="14.5" y="3.5" width="6" height="6" rx=".8"/><rect x="3.5" y="14.5" width="6" height="6" rx=".8"/><path d="M14.5 14.5h2.2v2.2h-2.2zM18.3 14.5h2.2v2.2h-2.2zM14.5 18.3h2.2v2.2h-2.2zM18.3 18.3h2.2v2.2h-2.2z"/>',
      copy: '<rect x="8.3" y="8.3" width="11.2" height="11.2" rx="2"/><path d="M15.7 8.3V6.5a2 2 0 0 0-2-2H6.5a2 2 0 0 0-2 2v7.2a2 2 0 0 0 2 2h1.8"/>',
      edit: '<path d="M4.2 19.8 5 15.6 15.8 4.8a2.1 2.1 0 0 1 3 3L8 18.6l-3.8 1.2z"/><path d="m14.2 6.4 3.4 3.4M5 15.6l3 3"/>'
    };
    return `<svg class="client-action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${paths[name] || paths.info}</svg>`;
  }
  function flagText(code, fallback, name) {
    return (typeof countryFlagText === 'function') ? countryFlagText(code, fallback, name) : (String(fallback || '').trim() || flagEmojiFromCode(code) || '🌐');
  }
  function nodeName(node) {
    const rawSuffix = String(node.label_suffix || '').trim();
    const suffix = rawSuffix.replace(/^\/+\s*/, '').trim();
    const baseName = node.country_name_ru || node.name;
    return suffix ? (/^\d+$/.test(suffix) ? `${baseName}-${suffix}` : `${baseName} / ${suffix}`) : baseName;
  }
  function isRemnawaveNode(node) {
    return String(node.node_type || '3xui') === 'remnawave';
  }
  function nodeEndpointLabel(node) {
    if (isRemnawaveNode(node)) return 'Remnawave · Internal Squad';
    return 'inbound ' + (node.inbound_id || '—');
  }
  function daysLeftNumber(ts) {
    const n = Number(ts || 0);
    if (!Number.isFinite(n) || n <= 0) return null;
    const diff = n - Date.now();
    if (diff <= 0) return 0;
    return Math.ceil(diff / 86400000);
  }
  function daysLeftShort(ts) {
    const left = daysLeftNumber(ts);
    return left === null ? '∞' : String(left);
  }
  function termShort(client) {
    const left = daysLeftNumber(client.expiry_time);
    if (left === null) return '∞';
    const total = Number(client.duration_days || 0);
    if (total > 0 && total > left) return `${left}/${total}`;
    return String(left);
  }
  function expiryDateTime(ts) {
    const n = Number(ts || 0);
    if (!Number.isFinite(n) || n <= 0) return '∞';
    return new Date(n).toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }

  function clientDirectoryNodeIds(client) {
    return (client.node_limits || []).filter(row => row.client_node_id).map(row => String(row.node_id)).join(' ');
  }
  function clientDirectorySearch(client) {
    return [client.id, client.login, client.display_name, client.comment, client.uuid, client.sub_slug, client.group_name, ...(client.tags || []).map(tag => tag.name)]
      .filter(value => value !== null && value !== undefined)
      .join(' ');
  }
  function clientDirectoryTagIds(client) {
    return (client.tags || []).map(tag => String(tag.id)).join(' ');
  }
  function clientLimitedNodes(client) {
    return clientAssignedNodes(client).filter(row => Number(row.traffic_gb || 0) > 0);
  }
  function clientTrafficHeadline(client) {
    const globalLimit = Math.max(0, Number(client.traffic_gb || 0));
    if (globalLimit > 0) return `${formatClientBytes(clientUsedBytes(client))} / ${globalLimit} ГБ`;
    const limited = clientLimitedNodes(client);
    if (limited.length === 1) return nodeLimitText(limited[0]);
    if (limited.length > 1) return `${limited.length} лимита по узлам`;
    return '∞';
  }

  function clientStatusMeta(client) {
    const enabled = client.enabled !== 0;
    const left = daysLeftNumber(client.expiry_time);
    if (!enabled) return { key: 'offline', label: 'Отключён', text: 'Клиент отключён и не может подключаться.' };
    if (left === 0) return { key: 'expired', label: 'Срок истёк', text: 'Срок доступа закончился. Продли доступ или отключи клиента на узлах.' };
    if (left !== null && left <= 7) return { key: 'warning', label: 'Скоро закончится', text: 'Срок доступа скоро закончится: осталось ' + left + ' дн.' };
    return { key: 'online', label: 'Включён', text: 'Клиент активен и может подключаться.' };
  }
  function clientDirectoryStatusFilter(client) {
    const enabled = client.enabled !== 0;
    const left = daysLeftNumber(client.expiry_time);
    if (!enabled) return 'disabled';
    if (left === 0) return 'expired';
    if (left !== null && left <= 7) return 'expiring';
    return 'active';
  }
  function compactTitle(client) {
    return String(client.display_name || client.login || '').trim();
  }
  function secondaryClientText(client) {
    const comment = String(client.comment || '').trim();
    const display = String(client.display_name || '').trim();
    const login = String(client.login || '').trim();
    if (comment && comment !== display && comment !== login) return comment;
    if (display && login && display !== login) return login;
    return '';
  }
  function gbFromBytes(bytes, digits = 1) {
    const n = Math.max(0, Number(bytes || 0));
    const gb = n / 1024 / 1024 / 1024;
    const maxDigits = gb >= 10 ? 0 : digits;
    return new Intl.NumberFormat('ru-RU', { maximumFractionDigits: maxDigits }).format(gb);
  }
  function nodeLimitText(row) {
    if (row.enabled === 0) return 'выкл.';
    const gb = Number(row.traffic_gb || 0);
    if (!gb) return '∞';
    return `${gbFromBytes(row.used_bytes)}/${gb} ГБ`;
  }
  function nodeRemainingText(row) {
    const gb = Number(row.traffic_gb || 0);
    if (!gb || row.enabled === 0) return '∞';
    return gbFromBytes(row.remaining_bytes) + ' ГБ';
  }
  function clientAssignedNodes(client) {
    return (client.node_limits || []).filter(row => row.client_node_id && row.enabled !== 0);
  }
  function clientUsedBytes(client) {
    return clientAssignedNodes(client).reduce((sum, row) => sum + Math.max(0, Number(row.used_bytes || 0)), 0);
  }
  function formatClientBytes(bytes) {
    const n = Math.max(0, Number(bytes || 0));
    if (n >= 1024 ** 4) return new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 2 }).format(n / 1024 ** 4) + ' ТБ';
    if (n >= 1024 ** 3) return new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 2 }).format(n / 1024 ** 3) + ' ГБ';
    if (n >= 1024 ** 2) return new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 1 }).format(n / 1024 ** 2) + ' МБ';
    if (n >= 1024) return new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 1 }).format(n / 1024) + ' КБ';
    return new Intl.NumberFormat('ru-RU').format(n) + ' Б';
  }
  function clientTrafficPercent(client) {
    const limitGb = Math.max(0, Number(client.traffic_gb || 0));
    if (!limitGb) return clientUsedBytes(client) > 0 ? 100 : 0;
    return Math.max(0, Math.min(100, clientUsedBytes(client) / (limitGb * 1024 ** 3) * 100));
  }
  function clientRemainingMeta(client) {
    const expiry = Number(client.expiry_time || 0);
    if (!Number.isFinite(expiry) || expiry <= 0) return { text: '∞', key: 'unlimited' };
    const diff = expiry - Date.now();
    if (diff <= 0) {
      const daysAgo = Math.floor(Math.abs(diff) / 86400000);
      return { text: `${daysAgo} дн. назад`, key: 'expired' };
    }
    const days = Math.ceil(diff / 86400000);
    return { text: `через ${Math.max(1, days)} дн.`, key: days <= 7 ? 'warning' : 'active' };
  }
  const isVpnClientTab = clientType !== 'xray';
  const currentClientCount = isVpnClientTab ? vpnClients.length : clients.length;
  const currentClientTypeLabel = clientType === 'wireguard' ? 'WireGuard' : clientType === 'amneziawg' ? 'AmneziaWG' : clientType === 'outline' ? 'Outline' : 'Reality / Xray';
  const clientTypeQuery = clientType === 'xray' ? '' : ('?type=' + encodeURIComponent(clientType));
  const xrayExpiredCount = clients.filter(c => c.enabled !== 0 && daysLeftNumber(c.expiry_time) === 0).length;
  const xrayExpiringCount = clients.filter(c => c.enabled !== 0 && daysLeftNumber(c.expiry_time) !== null && daysLeftNumber(c.expiry_time) >= 1 && daysLeftNumber(c.expiry_time) <= 7).length;
  const xrayDisabledCount = clients.filter(c => c.enabled === 0).length;
  const xrayActiveCount = clients.filter(c => c.enabled !== 0 && daysLeftNumber(c.expiry_time) !== 0).length;
%>

<% if (message) { %><div class="alert ok"><%= message %></div><% } %>
<% if (error) { %><div class="alert err"><%= error %></div><% } %>

<div id="toast" class="toast">Скопировано</div>

<div class="card mobile-client-search-card" aria-label="Поиск клиентов">
  <form method="get" action="/clients" class="mobile-client-search-form <%= q ? 'has-reset' : '' %>" data-live-client-search data-client-directory-search>
    <input type="hidden" name="type" value="<%= clientType %>" />
    <label class="mobile-client-search-input">
      <span aria-hidden="true">⌕</span>
      <input name="q" value="<%= q || '' %>" placeholder="Поиск клиента: имя, логин, UUID или сервис" autocomplete="off" />
    </label>
    <button type="submit" class="mobile-client-search-submit" aria-label="Найти клиента">Найти</button>
    <% if (q) { %><a class="mobile-client-search-reset" href="/clients<%= clientTypeQuery %>" aria-label="Сбросить поиск">×</a><% } %>
  </form>
</div>

<div class="card clients-card">
  <% if (clientType === 'xray') { %>
  <div class="client-overview-strip" aria-label="Сводка по клиентам">
    <button type="button" class="client-overview-stat" data-client-status-shortcut="all"><span>Клиенты</span><strong><%= clients.length %></strong></button>
    <button type="button" class="client-overview-stat is-online" data-client-status-shortcut="online"><span>В сети</span><strong id="clientOnlineNowCount">—</strong></button>
    <button type="button" class="client-overview-stat is-danger" data-client-status-shortcut="expired"><span>Срок истёк</span><strong><%= xrayExpiredCount %></strong></button>
    <button type="button" class="client-overview-stat is-warning" data-client-status-shortcut="expiring"><span>Скоро закончатся</span><strong><%= xrayExpiringCount %></strong></button>
    <button type="button" class="client-overview-stat is-muted" data-client-status-shortcut="disabled"><span>Отключено</span><strong><%= xrayDisabledCount %></strong></button>
    <button type="button" class="client-overview-stat is-success" data-client-status-shortcut="active"><span>Активны</span><strong><%= xrayActiveCount %></strong></button>
  </div>
  <% } %>
  <div class="section-title-row">
    <h2><%= currentClientTypeLabel %> — клиенты</h2>
    <span class="count-chip"><%= currentClientCount %></span>
  </div>

  <div class="clients-toolbar clients-toolbar-inside client-protocol-toolbar">
    <div class="clients-toolbar-actions">
      <button type="button" class="btn-main" onclick="openModalById('<%= clientType === 'xray' ? 'createClientModal' : 'createVpnClientModal' %>')">Создать клиента</button>
      <% if (clientType === 'xray') { %>
        <button type="button" class="btn-secondary" onclick="openModalById('importSyncModal')">Импорт и синхронизация</button>
        <button type="button" class="btn-secondary" onclick="openModalById('clientTransferModal')">Перенос клиентов</button>
        <button type="button" class="btn-secondary" onclick="openModalById('clientLabelsModal')">Группы и метки</button>
        <button type="button" class="btn-secondary" id="applySelectedToolbarButton" onclick="return openApplySelectedModal()" disabled>Применить к выбранным</button>
      <% } %>
    </div>
    <form method="get" action="/clients" class="search-form compact-search" data-live-client-search data-client-directory-search>
      <input type="hidden" name="type" value="<%= clientType %>" />
      <input name="q" value="<%= q || '' %>" placeholder="Поиск: имя, логин, UUID или сервис" autocomplete="off" />
      <button type="submit" class="secondary">Найти</button>
      <% if (q) { %><a class="link-btn secondary" href="/clients<%= clientTypeQuery %>">Сбросить</a><% } %>
    </form>
  </div>

  <% if (clientType === 'xray') { %>
  <div class="client-directory-toolbar" id="clientDirectoryToolbar" aria-label="Фильтр и сортировка клиентов">
    <label class="client-directory-control">
      <span>Фильтр по узлу</span>
      <select id="clientNodeFilter">
        <option value="">Все узлы</option>
        <% nodes.forEach(node => { %>
          <option value="<%= node.id %>"><%= flagText(node.country_code, node.country_flag, node.country_name_ru || node.name) %> <%= nodeName(node) %></option>
        <% }) %>
      </select>
    </label>
    <label class="client-directory-control">
      <span>Группа</span>
      <select id="clientGroupFilter">
        <option value="">Все группы</option>
        <option value="none">Без группы</option>
        <% clientGroups.forEach(group => { %><option value="<%= group.id %>"><%= group.name %></option><% }) %>
      </select>
    </label>
    <label class="client-directory-control">
      <span>Метка</span>
      <select id="clientTagFilter">
        <option value="">Все метки</option>
        <option value="none">Без меток</option>
        <% clientTags.forEach(tag => { %><option value="<%= tag.id %>"><%= tag.name %></option><% }) %>
      </select>
    </label>
    <label class="client-directory-control">
      <span>Сортировка</span>
      <select id="clientSortMode">
        <option value="newest">Последние добавленные</option>
        <option value="oldest">Сначала добавленные ранее</option>
        <option value="name-asc">По алфавиту А–Я</option>
        <option value="name-desc">По алфавиту Я–А</option>
        <option value="expiring">Показать: скоро закончатся</option>
        <option value="expired">Показать: срок закончился</option>
        <option value="disabled">Показать: отключённые</option>
        <option value="active">Показать: активные</option>
        <option value="online">Показать: сейчас в сети</option>
      </select>
    </label>
    <div class="client-directory-toolbar-actions">
      <div class="client-online-refresh-controls" aria-label="Обновление статуса клиентов">
        <label class="client-online-auto"><input type="checkbox" id="clientOnlineAutoRefresh" checked /><span>Авто</span></label>
        <select id="clientOnlineRefreshInterval" aria-label="Интервал автообновления"><option value="10">10 сек.</option><option value="30">30 сек.</option><option value="60">60 сек.</option></select>
        <button type="button" class="btn-secondary" id="clientOnlineRefreshNow">Обновить</button>
      </div>
      <div class="client-directory-result">
        <span>Показано</span>
        <strong id="clientDirectoryCount"><%= clients.length %></strong>
      </div>
      <button type="button" class="btn-secondary client-directory-reset" id="clientDirectoryReset">Сбросить фильтры</button>
    </div>
  </div>
  <div class="client-directory-empty" id="clientDirectoryEmpty" hidden>
    <strong>Клиенты не найдены</strong>
    <span>Измените строку поиска или сбросьте фильтры.</span>
  </div>
  <form method="post" action="/clients/bulk-delete" class="bulk-delete-form js-long-action" data-loading-title="Выполняю массовое действие" data-loading-text="Операция может занять время, если требуется подключение к узлам." onsubmit="return confirmClientBulkAction(event)">
    <input type="hidden" name="bulk_confirmation" value="" data-bulk-confirmation />
    <input type="hidden" name="bulk_filter_node_id" value="" data-bulk-filter-node-id />
  <%
    function mobileClientFilterKeys(client) {
      const enabled = client.enabled !== 0;
      const left = daysLeftNumber(client.expiry_time);
      const keys = [];
      if (enabled && left !== 0) keys.push('active');
      if (enabled && left !== null && left >= 1 && left <= 7) keys.push('expiring');
      if (!enabled || left === 0) keys.push('disabled');
      return keys;
    }
    const activeCount = clients.filter(c => mobileClientFilterKeys(c).includes('active')).length;
    const warnCount = clients.filter(c => mobileClientFilterKeys(c).includes('expiring')).length;
    const offCount = clients.filter(c => mobileClientFilterKeys(c).includes('disabled')).length;
  %>
  <div class="mobile-client-tabs" aria-label="Фильтр клиентов">
    <button type="button" class="is-active" data-mobile-client-filter="all">Все <span><%= clients.length %></span></button>
    <button type="button" data-mobile-client-filter="active">Активные <span><%= activeCount %></span></button>
    <button type="button" data-mobile-client-filter="expiring">Истекают <span><%= warnCount %></span></button>
    <button type="button" data-mobile-client-filter="disabled">Отключены <span><%= offCount %></span></button>
  </div>

    <div class="bulk-selection-panel" id="bulkSelectionPanel" data-actions-open="0" aria-label="Массовые действия с клиентами">
      <div class="bulk-selection-head">
        <div class="bulk-selection-actions">
          <button type="button" class="btn-secondary" data-client-select-action="all" onclick="return setAllClientSelection(true)">Выбрать все</button>
          <button type="button" class="btn-secondary" data-client-select-action="none" onclick="return setAllClientSelection(false)">Снять выбор</button>
          <span class="bulk-selected-count" id="bulkSelectedCount">Выбрано: 0</span>
          <button type="button" class="btn-main bulk-actions-toggle" id="bulkActionsToggle" aria-controls="bulkActionDetails" aria-expanded="false" onclick="return toggleBulkActions()" hidden>Действия</button>
        </div>
        <small class="hint bulk-selection-hint">Выбор применяется только к клиентам текущего поиска и фильтра.</small>
      </div>

      <div class="bulk-action-details" id="bulkActionDetails" hidden>
        <div class="bulk-node-action-row">
          <div class="bulk-node-action-field">
            <label for="bulkRemoveNodeId" id="bulkRemoveNodeLabel">Удалить выбранных клиентов из узла</label>
            <select name="bulk_node_id" id="bulkRemoveNodeId">
              <option value="">Выберите узел</option>
              <% nodes.forEach(node => { %>
                <option value="<%= node.id %>" data-node-type="<%= String(node.node_type || '3xui') %>"><%= flagText(node.country_code, node.country_flag, node.country_name_ru || node.name) %> <%= nodeName(node) %> (<%= nodeEndpointLabel(node) %>)</option>
              <% }) %>
            </select>
            <small class="hint bulk-action-hint" id="bulkRemoveNodeHint">Сначала меняется удалённый узел, затем удаляется локальная связь. Сам клиент в Nexus сохраняется.</small>
          </div>
          <button class="danger bulk-node-remove-btn" id="bulkRemoveNodeButton" type="submit" formaction="/clients/bulk-remove-node" data-bulk-action="remove-node">Удалить из узла</button>
        </div>

        <div class="bulk-row compact-bulk-row">
          <div>
            <label>Режим удаления выбранных клиентов</label>
            <select name="delete_mode">
              <option value="aggregator">Только из агрегатора</option>
              <option value="secondary">Из агрегатора и вторичных узлов</option>
              <option value="all">Из агрегатора и всех узлов</option>
            </select>
          </div>
          <button class="danger" type="submit" data-bulk-action="delete-clients">Удалить выбранных клиентов</button>
        </div>
      </div>
    </div>

  <div class="mobile-client-cards">
    <% clients.forEach(client => {
      const subUrl = `${baseUrl}/sub-plain/${client.sub_slug}`;
      const jsonUrl = `${baseUrl}/json/${client.sub_slug}?raw=1`;
      const clientStatus = clientStatusMeta(client);
      const displayTitle = compactTitle(client);
      const secondaryText = secondaryClientText(client);
      const nodeLimitRows = (client.node_limits || []).filter(nl => nl.client_node_id);
      const nodeLimitTextShort = client.limit_ip && Number(client.limit_ip) > 0 ? '0/' + Number(client.limit_ip) : '∞';
      const filterKeys = mobileClientFilterKeys(client).join(' ');
      const canShowSub = Boolean(showSubLinks);
    %>
