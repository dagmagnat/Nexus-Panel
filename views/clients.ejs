<script>
const clientDirectoryMode = <%= clientType === 'xray' ? 'true' : 'false' %>;
const clientDirectoryInitialQuery = new URLSearchParams(window.location.search).get('q') || '';
let clientDirectoryState = { query: clientDirectoryInitialQuery, nodeId: '', groupId: '', tagId: '', sort: 'newest' };
const clientDirectorySortModes = ['newest','oldest','name-asc','name-desc','expiring','expired','disabled','active','online'];

function normalizeClientDirectoryText(value) {
  return String(value || '').toLocaleLowerCase('ru-RU').replace(/ё/g, 'е').replace(/\s+/g, ' ').trim();
}
function getClientDirectoryEntries(view) {
  const selector = view ? `[data-client-entry][data-client-view="${view}"]` : '[data-client-entry]';
  return Array.from(document.querySelectorAll(selector));
}
function getVisibleClientDirectoryIds() {
  const ids = new Set();
  getClientDirectoryEntries().forEach(entry => {
    if (!entry.classList.contains('is-directory-hidden')) {
      const id = String(entry.dataset.clientIdEntry || '');
      if (id) ids.add(id);
    }
  });
  return ids;
}
function compareClientDirectoryEntries(a, b) {
  const mode = clientDirectoryState.sort;
  const ai = Number(a.dataset.clientOrder || 0);
  const bi = Number(b.dataset.clientOrder || 0);
  const ae = Number(a.dataset.clientExpiryOrder || 0);
  const be = Number(b.dataset.clientExpiryOrder || 0);
  const an = normalizeClientDirectoryText(a.dataset.clientName || '');
  const bn = normalizeClientDirectoryText(b.dataset.clientName || '');
  if (mode === 'oldest') return ai - bi;
  if (mode === 'name-asc') return an.localeCompare(bn, 'ru', { numeric: true, sensitivity: 'base' }) || bi - ai;
  if (mode === 'name-desc') return bn.localeCompare(an, 'ru', { numeric: true, sensitivity: 'base' }) || bi - ai;
  if (mode === 'expiring') return (ae || Number.MAX_SAFE_INTEGER) - (be || Number.MAX_SAFE_INTEGER) || bi - ai;
  if (mode === 'expired') return be - ae || bi - ai;
  if (mode === 'disabled') return bi - ai;
  return bi - ai;
}
function reorderClientDirectory() {
  [
    ['.mobile-client-cards', 'mobile'],
    ['.desktop-client-split-list', 'desktop'],
    ['.clients-table tbody', 'table'],
    ['.clients-modern-table tbody', 'modern']
  ].forEach(([containerSelector, view]) => {
    const container = document.querySelector(containerSelector);
    if (!container) return;
    getClientDirectoryEntries(view).sort(compareClientDirectoryEntries).forEach(entry => container.appendChild(entry));
  });
}
function syncClientDirectorySearchInputs(source) {
  document.querySelectorAll('form[data-client-directory-search] input[name="q"]').forEach(input => {
    if (input !== source && input.value !== clientDirectoryState.query) input.value = clientDirectoryState.query;
  });
}
function updateClientDirectoryUrl() {
  if (!window.history || !window.history.replaceState) return;
  const url = new URL(window.location.href);
  if (clientDirectoryState.query) url.searchParams.set('q', clientDirectoryState.query); else url.searchParams.delete('q');
  if (clientDirectoryState.nodeId) url.searchParams.set('node_id', clientDirectoryState.nodeId); else url.searchParams.delete('node_id');
  if (clientDirectoryState.groupId) url.searchParams.set('group_id', clientDirectoryState.groupId); else url.searchParams.delete('group_id');
  if (clientDirectoryState.tagId) url.searchParams.set('tag_id', clientDirectoryState.tagId); else url.searchParams.delete('tag_id');
  if (clientDirectoryState.sort && clientDirectoryState.sort !== 'newest') url.searchParams.set('sort', clientDirectoryState.sort); else url.searchParams.delete('sort');
  url.searchParams.delete('edit');
  window.history.replaceState({}, '', url.pathname + (url.searchParams.toString() ? '?' + url.searchParams.toString() : ''));
}
function applyClientDirectoryFilters(options = {}) {
  if (!clientDirectoryMode) return;
  const query = normalizeClientDirectoryText(clientDirectoryState.query);
  const nodeId = String(clientDirectoryState.nodeId || '');
  const groupId = String(clientDirectoryState.groupId || '');
  const tagId = String(clientDirectoryState.tagId || '');
  const statusMode = ['expiring','expired','disabled','active'].includes(clientDirectoryState.sort) ? clientDirectoryState.sort : '';
  const onlineOnly = clientDirectoryState.sort === 'online';
  const visibleIds = new Set();
  const master = new Map();
  getClientDirectoryEntries().forEach(entry => {
    const id = String(entry.dataset.clientIdEntry || '');
    if (id && !master.has(id)) master.set(id, entry);
  });
  master.forEach((entry, id) => {
    const search = normalizeClientDirectoryText(entry.dataset.clientSearch || '');
    const nodes = String(entry.dataset.clientNodeIds || '').split(/\s+/).filter(Boolean);
    const entryGroupId = String(entry.dataset.clientGroupId || '');
    const tags = String(entry.dataset.clientTagIds || '').split(/\s+/).filter(Boolean);
    const groupMatches = !groupId || (groupId === 'none' ? !entryGroupId : entryGroupId === groupId);
    const tagMatches = !tagId || (tagId === 'none' ? tags.length === 0 : tags.includes(tagId));
    const status = String(entry.dataset.clientStatus || '');
    const statusMatches = !statusMode || status === statusMode || (statusMode === 'active' && status === 'expiring');
    const onlineMatches = !onlineOnly || entry.dataset.clientOnline === '1';
    if ((!query || search.includes(query)) && (!nodeId || nodes.includes(nodeId)) && groupMatches && tagMatches && statusMatches && onlineMatches) visibleIds.add(id);
  });
  getClientDirectoryEntries().forEach(entry => {
    const id = String(entry.dataset.clientIdEntry || '');
    const hidden = !visibleIds.has(id);
    entry.classList.toggle('is-directory-hidden', hidden);
    entry.hidden = hidden;
    entry.setAttribute('aria-hidden', hidden ? 'true' : 'false');
    if (hidden) entry.querySelectorAll('.client-check[data-client-id]').forEach(cb => { cb.checked = false; cb.indeterminate = false; });
  });
  reorderClientDirectory();
  const count = document.getElementById('clientDirectoryCount');
  if (count) count.textContent = String(visibleIds.size);
  const empty = document.getElementById('clientDirectoryEmpty');
  if (empty) empty.hidden = visibleIds.size !== 0;
  const titleCount = document.querySelector('.clients-card > .section-title-row .count-chip');
  if (titleCount) titleCount.textContent = String(visibleIds.size);
  syncClientDirectorySearchInputs(options.sourceInput || null);
  syncBulkNodeActionWithFilter();
  updateBulkSelectionUi();
  if (options.updateUrl !== false) updateClientDirectoryUrl();
}
function setupClientDirectory() {
  if (!clientDirectoryMode) return;
  const params = new URLSearchParams(window.location.search);
  clientDirectoryState.query = params.get('q') || clientDirectoryInitialQuery || '';
  clientDirectoryState.nodeId = params.get('node_id') || '';
  clientDirectoryState.groupId = params.get('group_id') || '';
  clientDirectoryState.tagId = params.get('tag_id') || '';
  clientDirectoryState.sort = clientDirectorySortModes.includes(params.get('sort')) ? params.get('sort') : 'newest';
  const nodeSelect = document.getElementById('clientNodeFilter');
  const groupSelect = document.getElementById('clientGroupFilter');
  const tagSelect = document.getElementById('clientTagFilter');
  const sortSelect = document.getElementById('clientSortMode');
  if (nodeSelect) nodeSelect.value = clientDirectoryState.nodeId;
  if (groupSelect) groupSelect.value = clientDirectoryState.groupId;
  if (tagSelect) tagSelect.value = clientDirectoryState.tagId;
  if (sortSelect) sortSelect.value = clientDirectoryState.sort;
  document.querySelectorAll('form[data-client-directory-search]').forEach(form => {
    const input = form.querySelector('input[name="q"]');
    if (!input) return;
    input.value = clientDirectoryState.query;
    input.addEventListener('input', () => {
      clientDirectoryState.query = input.value;
      applyClientDirectoryFilters({ sourceInput: input });
    });
    form.addEventListener('submit', event => {
      event.preventDefault();
      clientDirectoryState.query = input.value;
      applyClientDirectoryFilters({ sourceInput: input });
      input.focus({ preventScroll: true });
    });
  });
  nodeSelect?.addEventListener('change', () => {
    clientDirectoryState.nodeId = nodeSelect.value;
    applyClientDirectoryFilters();
  });
  groupSelect?.addEventListener('change', () => {
    clientDirectoryState.groupId = groupSelect.value;
    applyClientDirectoryFilters();
  });
  tagSelect?.addEventListener('change', () => {
    clientDirectoryState.tagId = tagSelect.value;
    applyClientDirectoryFilters();
  });
  document.getElementById('bulkRemoveNodeId')?.addEventListener('change', event => {
    if (!clientDirectoryState.nodeId) return;
    if (String(event.currentTarget.value || '') === String(clientDirectoryState.nodeId)) return;
    event.currentTarget.value = String(clientDirectoryState.nodeId);
    showToast('При активном фильтре удаление выполняется только из выбранного в фильтре узла');
  });
  sortSelect?.addEventListener('change', () => {
    clientDirectoryState.sort = sortSelect.value;
    applyClientDirectoryFilters();
  });
  document.getElementById('clientDirectoryReset')?.addEventListener('click', () => {
    clientDirectoryState = { query: '', nodeId: '', groupId: '', tagId: '', sort: 'newest' };
    if (nodeSelect) nodeSelect.value = '';
    if (groupSelect) groupSelect.value = '';
    if (tagSelect) tagSelect.value = '';
    if (sortSelect) sortSelect.value = 'newest';
    applyClientDirectoryFilters();
    const first = document.querySelector('form[data-client-directory-search] input[name="q"]');
    first?.focus({ preventScroll: true });
  });
  applyClientDirectoryFilters({ updateUrl: false });
}

function showToast(text) {
  const el = document.getElementById('toast');
  if (!el) return;
  el.textContent = text || 'Скопировано';
  el.classList.add('show');
  setTimeout(() => el.classList.remove('show'), 1300);
}
function markCopySuccess(btn) {
  if (!btn) return;
  btn.classList.remove('copy-success');
  void btn.offsetWidth;
  btn.classList.add('copy-success');
  clearTimeout(btn.__copySuccessTimer);
  btn.__copySuccessTimer = setTimeout(() => btn.classList.remove('copy-success'), 900);
}
async function writeClipboardText(text) {
  const value = String(text || '');
  if (!value) throw new Error('Пустая ссылка');
  if (navigator.clipboard && window.isSecureContext) {
    await navigator.clipboard.writeText(value);
    return;
  }
  const input = document.createElement('textarea');
  input.value = value;
  input.setAttribute('readonly', '');
  input.style.cssText = 'position:fixed;opacity:0;pointer-events:none';
  document.body.appendChild(input);
  input.select();
  const copied = document.execCommand('copy');
  input.remove();
  if (!copied) throw new Error('Не удалось скопировать');
}
function copySubLink(text, btn) {
  writeClipboardText(text)
    .then(() => markCopySuccess(btn))
    .catch(() => showToast('Не удалось скопировать'));
}
