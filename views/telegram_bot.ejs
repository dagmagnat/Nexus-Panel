<%- include('partials_header', { pageTitle: 'TG-бот', pageSubtitle: 'Клиентский бот-менеджер VPN, заявки, подписки, поддержка и объявления', activePage: 'telegram_bot' }) %>

<%
  function safe(v) { return String(v == null ? '' : v); }
  function statusLabel(status) {
    if (status === 'new') return 'новая';
    if (status === 'closed') return 'закрыто';
    if (status === 'open') return 'открыто';
    if (status === 'done') return 'готово';
    if (status === 'cancelled') return 'отменено';
    return status || '-';
  }
  const tokenMask = telegramBotToken ? telegramBotToken.slice(0, 8) + '...' + telegramBotToken.slice(-5) : '';
%>

<% if (message) { %><div class="alert ok"><%= message %></div><% } %>
<% if (error) { %><div class="alert err"><%= error %></div><% } %>

<div class="grid">
  <section class="card span-12">
    <div class="section-title-row">
      <div>
        <h2>Настройки Telegram-бота</h2>
        <p class="muted">BotFather только создаёт бота и выдаёт токен. Код бота запускается внутри этого агрегатора и работает с той же SQLite-базой.</p>
      </div>
      <span class="badge <%= botRuntimeStatus === 'running' ? 'online' : 'offline' %>"><%= botRuntimeStatus === 'running' ? 'работает' : 'остановлен' %></span>
    </div>

    <div class="alert ok">
      <strong>Как создать бота:</strong> откройте <code>@BotFather</code> → <code>/newbot</code> → получите API Token → вставьте его ниже. Admin IDs — это Telegram ID администраторов через запятую.
    </div>

    <form method="post" action="/telegram-bot/settings">
      <div class="form-grid clean-form">
        <div class="field half">
          <label class="switch-row compact">
            <input type="checkbox" name="telegram_manager_enabled" value="1" <%= telegramBotEnabled ? 'checked' : '' %> />
            <span><strong>Включить клиентского Telegram-бота</strong><small>После сохранения бот перезапустится в этом же процессе Node.js.</small></span>
          </label>
        </div>

        <div class="field half">
          <label>Текущее состояние</label>
          <input value="<%= botRuntimeStatus === 'running' ? 'polling запущен' : 'polling не запущен' %>" disabled />
          <% if (tokenMask) { %><small class="hint">Текущий токен: <code><%= tokenMask %></code></small><% } %>
        </div>

        <div class="field half">
          <label>BOT_TOKEN</label>
          <input name="telegram_manager_bot_token" value="<%= safe(telegramBotToken) %>" placeholder="1234567890:AA..." autocomplete="off" />
          <small class="hint">Если токен был опубликован — перевыпустите его в BotFather.</small>
        </div>

        <div class="field half">
          <label>Telegram Proxy URL</label>
          <input name="telegram_manager_proxy_url" value="<%= safe(telegramProxyUrl) %>" placeholder="socks5://user:pass@1.2.3.4:1080 или http://user:pass@1.2.3.4:3128" autocomplete="off" />
          <small class="hint">Пустое поле = без прокси. Используется только для Telegram API, если сервер панели не может подключиться к Telegram напрямую.</small>
        </div>

        <div class="field half">
          <label>Admin IDs</label>
          <input name="telegram_manager_admin_ids" value="<%= safe(telegramAdminIds) %>" placeholder="341361869,123456789" />
          <small class="hint">Админы видят админ-панель в боте. Остальные пользователи видят клиентское меню.</small>
        </div>

        <div class="field half">
          <label>Username поддержки / менеджера</label>
          <input name="telegram_manager_support_username" value="<%= safe(telegramSupportUsername) %>" placeholder="@username" />
          <small class="hint">Опционально. Пока поддержка работает через бота, но username можно использовать в текстах.</small>
        </div>

        <div class="field half">
          <label>Базовое количество устройств</label>
          <input type="number" min="0" name="telegram_manager_base_ip_limit" value="<%= safe(telegramBaseIpLimit) %>" />
          <small class="hint">Например, 2 устройства входят в базовую цену.</small>
        </div>

        <div class="field half">
          <label>Цена за дополнительное устройство, ₽</label>
          <input type="number" min="0" name="telegram_manager_extra_ip_price_rub" value="<%= safe(telegramExtraIpPriceRub) %>" />
          <small class="hint">Например, 80 ₽ за каждое устройство сверх базового лимита.</small>
        </div>

        <div class="field half">
          <label>Уведомлять об окончании за, дней</label>
          <input type="number" min="1" name="telegram_manager_expiry_notice_days" value="<%= safe(telegramExpiryNoticeDays) %>" />
          <small class="hint">Бот раз в сутки напомнит привязанному клиенту, если доступ заканчивается в ближайшие N дней.</small>
        </div>

        <div class="field half">
          <label>Приветствие</label>
          <textarea name="telegram_manager_welcome_text" rows="4"><%= safe(telegramWelcomeText) %></textarea>
        </div>

        <div class="field half">
          <label>Статус сервиса / последнее объявление</label>
          <textarea name="telegram_manager_status_text" rows="4"><%= safe(telegramStatusText) %></textarea>
          <small class="hint">Показывается клиентам в разделе «Статус сервиса».</small>
        </div>

        <div class="field half">
          <label>Инструкция клиенту</label>
          <textarea name="telegram_manager_instruction_text" rows="5"><%= safe(telegramInstructionText) %></textarea>
        </div>

        <div class="field half">
          <label>MTProto / резервная связь</label>
          <textarea name="telegram_manager_mtproto_text" rows="5"><%= safe(telegramMtprotoText) %></textarea>
          <small class="hint">Укажите ссылку MTProto-прокси или текст с инструкцией. Клиент получит это по кнопке «📡 Прокси для Telegram».</small>
        </div>

        <div class="field">
          <label>Тарифы JSON</label>
          <textarea name="telegram_manager_plans_json" rows="9" spellcheck="false"><%= safe(telegramPlansJson) %></textarea>
          <small class="hint">Формат: <code>[{"key":"1m","title":"1 месяц","days":30,"price":300}]</code>. Оплата пока ручная: бот создаёт заявку и уведомляет админа.</small>
        </div>
      </div>

      <div class="actions">
        <button type="submit">Сохранить и применить</button>
        <button type="submit" formaction="/telegram-bot/test" class="secondary">Проверить токен</button>
      </div>
    </form>
  </section>


  <section class="card span-12">
    <div class="section-title-row">
      <div>
        <h2>Telegram-уведомления агрегатора</h2>
        <p class="muted">Системные уведомления: offline-узлы, подозрительный трафик и будущие сервисные события.</p>
      </div>
      <span class="badge <%= telegramNotificationsEnabled ? 'online' : 'offline' %>"><%= telegramNotificationsEnabled ? 'включены' : 'выключены' %></span>
    </div>
    <form method="post" action="/settings/telegram?return=telegram-bot">
      <input type="hidden" name="return_to" value="telegram-bot" />
      <div class="form-grid clean-form">
        <div class="field half">
          <label class="switch-row compact">
            <input type="checkbox" name="telegram_notifications_enabled" value="1" <%= telegramNotificationsEnabled ? 'checked' : '' %> />
            <span><strong>Включить уведомления</strong><small>Используется для диагностик, offline-узлов и подозрительного расхода.</small></span>
          </label>
        </div>
        <div class="field half">
          <label>Bot Token для уведомлений</label>
          <input name="telegram_bot_token" value="<%= safe(telegramNotifyBotToken) %>" placeholder="123456789:AA..." autocomplete="off" />
        </div>
        <div class="field half">
          <label>Chat ID / канал</label>
          <input name="telegram_chat_id" value="<%= safe(telegramNotifyChatId) %>" placeholder="-1001234567890 или @channelname" />
        </div>
        <div class="field half">
          <label>Порог подозрительного расхода, ГБ/день</label>
          <input name="telegram_suspicious_daily_gb" type="number" min="0" step="1" value="<%= safe(telegramSuspiciousDailyGb) %>" />
        </div>
        <div class="field half">
          <label class="switch-row compact"><input type="checkbox" name="telegram_notify_offline_nodes" value="1" <%= telegramNotifyOfflineNodes ? 'checked' : '' %> /><span><strong>Узлы offline</strong><small>Сообщать, если узел недоступен.</small></span></label>
        </div>
        <div class="field half">
          <label class="switch-row compact"><input type="checkbox" name="telegram_notify_suspicious_clients" value="1" <%= telegramNotifySuspiciousClients ? 'checked' : '' %> /><span><strong>Подозрительный трафик</strong><small>Используется в диагностике и отчётах.</small></span></label>
        </div>
      </div>
      <div class="actions"><button type="submit">Сохранить уведомления</button></div>
    </form>
    <form method="post" action="/settings/telegram-test?return=telegram-bot" class="actions">
      <button type="submit" class="secondary">Проверить Telegram</button>
    </form>
  </section>

  <section class="card span-6">
    <h2>Быстрая привязка Telegram ID к клиенту</h2>
    <p class="muted">После привязки бот автоматически отправит пользователю ссылку подписки и инструкцию для Happ.</p>
    <form method="post" action="/telegram-bot/bind">
      <div class="form-grid clean-form">
        <div class="field">
          <label>Telegram ID клиента</label>
          <input name="telegram_id" placeholder="123456789" required />
        </div>
        <div class="field">
          <label>Клиент агрегатора</label>
          <select name="client_id" required>
            <option value="">Выберите клиента</option>
            <% clients.forEach(c => { %>
              <option value="<%= c.id %>">#<%= c.id %> · <%= c.login %> · <%= c.display_name || '' %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="actions"><button type="submit">Привязать и отправить доступ</button></div>
    </form>
  </section>

  <section class="card span-6">
    <h2>Объявление</h2>
    <p class="muted">Отправит сообщение всем пользователям, которые запускали бота. Также текст станет текущим статусом сервиса.</p>
    <form method="post" action="/telegram-bot/announcement">
      <div class="field">
        <label>Текст объявления</label>
        <textarea name="text" rows="7" placeholder="Сегодня возможны перебои из-за технических работ."></textarea>
      </div>
      <div class="actions"><button type="submit">Отправить объявление</button></div>
    </form>
  </section>

  <section class="card span-12">
    <div class="section-title-row">
      <h2>Пользователи бота</h2>
      <span class="count-chip"><%= users.length %></span>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Telegram ID</th><th>Username</th><th>Имя</th><th>Роль</th><th>Client ID</th><th>Последний раз</th></tr></thead>
        <tbody>
        <% users.forEach(u => { %>
          <tr>
            <td><code><%= u.telegram_id %></code></td>
            <td><%= u.username ? '@' + u.username : '-' %></td>
            <td><%= [u.first_name, u.last_name].filter(Boolean).join(' ') || '-' %></td>
            <td><%= u.role %></td>
            <td><%= u.client_id || '-' %></td>
            <td><%= u.last_seen_at || '-' %></td>
          </tr>
        <% }) %>
        <% if (!users.length) { %><tr><td colspan="6" class="muted">Пока никто не запускал бота.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="card span-6">
    <div class="section-title-row">
      <h2>Заявки</h2>
      <span class="count-chip"><%= orders.length %></span>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>ID</th><th>TG ID</th><th>Тариф</th><th>Устройств</th><th>Цена</th><th>Статус</th><th>Действия</th></tr></thead>
        <tbody>
        <% orders.forEach(o => { %>
          <tr>
            <td>#<%= o.id %></td>
            <td><code><%= o.telegram_id %></code></td>
            <td><%= o.plan_title %></td>
            <td><%= o.ip_limit %></td>
            <td><%= o.price_rub %> ₽</td>
            <td><%= statusLabel(o.status) %></td>
            <td>
              <form method="post" action="/telegram-bot/orders/<%= o.id %>/status" style="display:inline">
                <input type="hidden" name="status" value="done" />
                <button type="submit" class="secondary">Готово</button>
              </form>
              <form method="post" action="/telegram-bot/orders/<%= o.id %>/status" style="display:inline">
                <input type="hidden" name="status" value="cancelled" />
                <button type="submit" class="secondary">Отменить</button>
              </form>
              <form method="post" action="/telegram-bot/orders/<%= o.id %>/delete" style="display:inline" onsubmit="return confirm('Удалить заявку #<%= o.id %>?')">
                <button type="submit" class="danger">Удалить</button>
              </form>
            </td>
          </tr>
        <% }) %>
        <% if (!orders.length) { %><tr><td colspan="7" class="muted">Заявок пока нет.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="card span-6">
    <div class="section-title-row">
      <h2>Поддержка</h2>
      <span class="count-chip"><%= tickets.length %></span>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>ID</th><th>TG ID</th><th>Статус</th><th>Обновлено</th></tr></thead>
        <tbody>
        <% tickets.forEach(t => { %>
          <tr><td>#<%= t.id %></td><td><code><%= t.telegram_id %></code></td><td><%= statusLabel(t.status) %></td><td><%= t.updated_at %></td></tr>
        <% }) %>
        <% if (!tickets.length) { %><tr><td colspan="4" class="muted">Обращений пока нет.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </section>
</div>

<%- include('partials_footer') %>
