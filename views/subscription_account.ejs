<%
const cfg=billing.config, devices=billing.devices||[], nodes=account.nodes||[];
const limit=Number(portalClient.device_limit)||0, full=limit>0&&devices.length>=limit;
const expired=billing.button.expired, finite=Number(account.expiryTimeMs)>0;
const days=finite?Math.max(0,Math.ceil((account.expiryTimeMs-Date.now())/86400000)):0;
const date=finite?new Date(account.expiryTimeMs):null;
const formatBytes=n=>n>=1073741824?(n/1073741824).toLocaleString('ru-RU',{maximumFractionDigits:2})+' ГБ':(n/1048576).toLocaleString('ru-RU',{maximumFractionDigits:1})+' МБ';
const exhausted=nodes.filter(n=>n.totalBytes>0&&n.usedBytes>=n.totalBytes).length;
const help=typeof supportUrl==='string'&&/^(https?:\/\/|tg:\/\/)/i.test(supportUrl)?supportUrl:'';
const icon=(name,cls='')=>'<svg class="icon '+cls+'" aria-hidden="true"><use href="#i-'+name+'"></use></svg>';
%>
<!doctype html><html lang="ru"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="referrer" content="no-referrer"><meta name="robots" content="noindex,nofollow"><meta name="theme-color" content="#080e1b">
<title><%= subscriptionName %> — личный кабинет</title>
<link rel="icon" type="image/png" href="/img/nexus-panel-tab-32.png?v=3">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Личный кабинет">
<link rel="stylesheet" href="/css/subscription-account.css?v=20261126-1">
<script src="/js/subscription-account.js?v=20261127-1" defer></script>
</head><body data-expired="<%= expired?'1':'0' %>" style="--accent:<%= cfg.activeColor %>;--accent-text:<%= cfg.activeTextColor %>;--danger:<%= cfg.expiredColor %>;--danger-text:<%= cfg.expiredTextColor %>">
<svg class="svg-defs" xmlns="http://www.w3.org/2000/svg"><defs>
<symbol id="i-home" viewBox="0 0 24 24"><path d="m3 10 9-7 9 7v11h-6v-7H9v7H3Z"/></symbol>
<symbol id="i-chart" viewBox="0 0 24 24"><path d="M5 20V10m7 10V4m7 16v-7"/></symbol>
<symbol id="i-devices" viewBox="0 0 24 24"><rect x="7" y="2" width="11" height="20" rx="2"/><path d="M11 18h3M3 7v12"/></symbol>
<symbol id="i-bag" viewBox="0 0 24 24"><path d="M4 7h16l1 14H3ZM8 8V6a4 4 0 0 1 8 0v2"/></symbol>
<symbol id="i-arrow" viewBox="0 0 24 24"><path d="m9 5 7 7-7 7"/></symbol>
<symbol id="i-copy" viewBox="0 0 24 24"><rect x="8" y="8" width="12" height="13" rx="2"/><path d="M15 8V3H3v13h5"/></symbol>
<symbol id="i-share" viewBox="0 0 24 24"><path d="M12 15V2m-4 4 4-4 4 4M6 10H3v11h18V10h-3"/></symbol>
<symbol id="i-trash" viewBox="0 0 24 24"><path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7m4-7v7"/></symbol>
<symbol id="i-help" viewBox="0 0 24 24"><path d="m2 11 20-8-5 18-6-6-4 3 1-6 9-6-6 9Z"/></symbol>
<symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="17" rx="2"/><path d="M7 2v6m10-6v6M3 11h18"/></symbol>
<symbol id="i-download" viewBox="0 0 24 24"><path d="M12 3v12m-5-5 5 5 5-5M4 17v4h16v-4"/></symbol>
<symbol id="i-globe" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><ellipse cx="12" cy="12" rx="4" ry="10"/><path d="M2 12h20"/></symbol>
<symbol id="i-monitor" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M12 17v4m-5 0h10"/></symbol>
<symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol>
</defs></svg>
<div class="portal-shell">
<header class="portal-header"><a class="brand" href="#subscription" aria-label="На главную"><span class="brand-symbol">A</span><span><%= subscriptionName %></span></a><% if(help){ %><a class="help-button" href="<%= help %>" target="_blank" rel="noreferrer"><%- icon('help') %><span>Помощь</span></a><% }else{ %><span class="header-label">Личный кабинет</span><% } %></header>
<% if(notice){ %><div class="notice" role="status"><%- icon('check') %><span><%= notice %></span></div><% } %>
<main id="portal-main">
<section data-tab-panel="subscription" aria-label="Подписка">
<div class="page-heading"><div><span class="eyebrow"><%= portalClient.display_name || portalClient.login %></span><h1>Ваша подписка<span class="heading-dot">.</span></h1></div><span class="status-pill <%= expired?'is-expired':!account.enabled?'is-pending':'' %>"><span></span><%= account.statusText %></span></div>
<div class="home-layout"><div class="home-summary">
<% if(full||exhausted){ %><div class="card attention-card"><% if(exhausted){ %><div class="attention-row"><span class="tile-icon warning"><%- icon('chart') %></span><div><strong>Лимит на <%= exhausted %> узл. исчерпан</strong><small>Проверьте расход трафика</small></div><a href="#traffic" class="chip-button">Смотреть</a></div><% }if(full){ %><div class="attention-row"><span class="tile-icon warning"><%- icon('devices') %></span><div><strong>Все места устройств заняты</strong><small><%= devices.length %> из <%= limit %> · освободите или добавьте место</small></div><a href="#devices" class="chip-button">Открыть</a></div><% } %></div><% } %>
<div class="card expiry-card <%= expired?'expired-card':'' %>"><div class="expiry-top"><div class="calendar-tile"><span><%= date?date.toLocaleDateString('ru-RU',{month:'short',timeZone:'Europe/Moscow'}).replace('.',''):'∞' %></span><strong><%= date?date.toLocaleDateString('ru-RU',{day:'numeric',timeZone:'Europe/Moscow'}):'∞' %></strong></div><div class="expiry-copy"><small><%= expired?'Срок подписки истёк':'Действует до' %></small><strong><%= finite?date.toLocaleDateString('ru-RU',{day:'numeric',month:'long',year:'numeric',timeZone:'Europe/Moscow'}):account.expiryText %></strong><span><%= finite?(expired?'Продлите подписку, чтобы вернуться':('Ещё '+days+' дн.')):account.daysLeftText %></span></div></div>
<% if(finite){ %><div class="day-track" aria-label="Осталось <%= days %> дней"><% for(let i=0;i<14;i++){ %><i class="<%= i<Math.min(14,Math.ceil(days/30*14))?'filled':'' %>"></i><% } %></div><% } %>
<a class="renew-link" id="account-action" href="<%= expired?'#renew':'#devices' %>" style="color:<%= billing.button.color %>"><span><%= billing.button.label %></span><%- icon('arrow') %></a></div>
<div class="quick-stats"><a class="card stat-link" href="#traffic"><%- icon('chart') %><small>Трафик использован</small><strong><%= account.usedText %></strong><span>Подробнее <%- icon('arrow') %></span></a><a class="card stat-link" href="#devices"><%- icon('devices') %><small>Ваши устройства</small><strong><%= account.deviceLimitText %></strong><span>Управление <%- icon('arrow') %></span></a></div>
</div>
<div class="card connection-card"><div class="card-heading"><h2>Подключение</h2><span id="platform-hint">Выберите устройство</span></div>
<div class="platforms" role="group" aria-label="Ваше устройство"><button type="button" data-platform="ios"><%- icon('devices') %><span class="platform-name">iOS</span></button><button type="button" data-platform="android"><%- icon('monitor') %><span class="platform-name">Android</span></button><button type="button" data-platform="windows"><%- icon('monitor') %><span class="platform-name">Windows</span></button><button type="button" data-platform="mac"><span>⌘</span><span class="platform-name">macOS</span></button><button type="button" data-platform="linux"><span>⌨</span><span class="platform-name">Linux</span></button></div>
<div class="app-choices" role="group" aria-label="Приложение для подключения"><button class="app-choice selected" data-app="happ" aria-pressed="true" type="button"><span class="app-logo happ-logo">H</span><span><strong>Happ</strong><small>Выбрано</small></span><span class="choice-dot"></span></button><button class="app-choice" data-app="incy" aria-pressed="false" type="button"><span class="app-logo incy-logo">INCY</span><span><strong>INCY</strong><small>Доступно</small></span><span class="choice-dot"></span></button><% if (links.karing) { %><button class="app-choice" data-app="karing" aria-pressed="false" type="button"><span class="app-logo karing-logo">K</span><span><strong>Karing</strong><small>Доступно</small></span><span class="choice-dot"></span></button><% } %></div>
<a id="happ-link" class="sr-only" href="<%= links.happ %>" tabindex="-1" aria-hidden="true">Ключ Happ</a><a id="incy-link" class="sr-only" href="<%= links.incy %>" tabindex="-1" aria-hidden="true">Ключ INCY</a><% if (links.karing) { %><a id="karing-link" class="sr-only" href="<%= links.karing.open %>" data-import-url="<%= links.karing.url %>" tabindex="-1" aria-hidden="true">Подписка Karing</a><% } %>
<div class="other-device"><div class="qr-frame"><img id="connection-qr" src="/account/connection-qr?app=happ" width="136" height="136" alt="QR-код подписки Happ для другого устройства"><span id="qr-error" hidden>QR недоступен</span></div><div class="other-copy"><h3>Другое устройство</h3><p id="connection-qr-hint">Отсканируйте QR-код или отправьте ключ</p><button type="button" class="copy-button" id="copy-connection"><%- icon('copy') %>Скопировать ключ</button><button type="button" class="share-button" id="share-connection"><%- icon('share') %>Поделиться</button></div></div>
<details class="connection-help"><summary>Как подключиться?</summary><p>Установите выбранное приложение и нажмите «Подключиться». Если приложение не открылось, скопируйте ключ и импортируйте его вручную. Открывайте кабинет в Safari или Chrome.</p><p>При замене старой подписки сначала проверьте новую, затем удалите старую запись из приложения.</p></details>
</div></div>
<p class="support-line"><% if(help){ %>Не получается подключиться? <a href="<%= help %>" target="_blank" rel="noreferrer">Напишите нам</a><% }else{ %>Подключение и управление подпиской — в одном месте.<% } %></p>
</section>
<section data-tab-panel="traffic" aria-label="Трафик" id="traffic"><div class="page-heading"><div><span class="eyebrow">СТАТИСТИКА ПОДПИСКИ</span><h1>Трафик<span class="heading-dot">.</span></h1></div><span class="header-label">По вашим узлам</span></div>
<div class="card traffic-overview"><span class="tile-icon"><%- icon('globe') %></span><div><small>Общий расход</small><strong><%= account.usedText %><span><%= account.totalBytes>0?' из '+account.totalText:' · без общего лимита' %></span></strong></div><% if(account.totalBytes>0){ %><div class="progress"><span style="width:<%= account.progressPercent %>%"></span></div><div class="traffic-caption"><span>Осталось <%= account.remainingText %></span><span><%= account.progressPercent %>% использовано</span></div><% } %></div>
<h2 class="section-label">Расход по узлам</h2><div class="traffic-grid"><% for(const n of nodes){const limited=n.totalBytes>0,pct=limited?Math.min(100,Math.max(0,n.usedBytes/n.totalBytes*100)):0; %><article class="card node-traffic <%= limited&&pct>=100?'quota-empty':'' %>"><div class="node-heading"><span class="node-flag"><%= n.flag || '◉' %></span><h3><%= n.flag && n.name.startsWith(n.flag)?n.name.slice(n.flag.length).trim():n.name %></h3></div><div class="node-values"><span>Использовано</span><strong><%= n.usedText %><small> / <%= limited?n.totalText:'без лимита' %></small></strong></div><% if(limited){ %><div class="progress"><span style="width:<%= pct %>%"></span></div><p class="hint"><%= pct>=100?'Лимит исчерпан':'Осталось '+formatBytes(Math.max(0,n.totalBytes-n.usedBytes)) %></p><% }else{ %><p class="hint">Для этого узла лимит трафика не задан.</p><% } %></article><% }if(!nodes.length){ %><div class="card empty-state">Статистика появится после использования подписки.</div><% } %></div>
<p class="page-note">Расход обновляется по данным серверов.</p><% if(help){ %><a class="text-link" href="<%= help %>" target="_blank" rel="noreferrer">Нужен дополнительный трафик? Напишите нам <%- icon('arrow') %></a><% } %></section>
<%- include('subscription_account_controls',{icon,limit,full,help}) %>
</main></div>
<div class="portal-dock"><div class="connect-bar" id="connect-bar"><% if(expired){ %><a class="expired-connect" href="#renew"><%= cfg.expiredButtonText %><%- icon('arrow') %></a><% } %><a id="install-app" class="install-button" href="https://www.happ.su/main" target="_blank" rel="noreferrer" aria-label="Установить Happ"><%- icon('download') %></a><a class="connect-button" id="connect-app" href="<%= links.happ %>"><span class="app-logo happ-logo" id="connect-logo">H</span><span id="connect-label">Подключиться в Happ</span><%- icon('arrow') %></a></div><% if(cfg.enabled){ %><div class="shop-bar"><button class="button primary" form="renewal-form" type="submit">Перейти к оплате <span id="dock-price"></span><%- icon('arrow') %></button></div><% } %><nav class="bottom-nav" aria-label="Разделы кабинета"><a href="#subscription" data-tab="subscription" aria-current="page"><%- icon('home') %><span>Подписка</span></a><a href="#traffic" data-tab="traffic"><%- icon('chart') %><span>Трафик</span></a><a href="#devices" data-tab="devices"><%- icon('devices') %><span>Устройства</span></a><a href="#renew" data-tab="shop"><%- icon('bag') %><span>Магазин</span></a></nav></div>
<p class="toast" id="portal-status" role="status" aria-live="polite"></p>
</body></html>
