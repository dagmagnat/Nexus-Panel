<%- include('partials_header', { pageTitle: 'Настройки', pageSubtitle: 'Параметры подписки, админки, безопасности и резервных копий', activePage: 'settings' }) %>

<% if (message) { %><div class="alert ok"><%= message %></div><% } %>
<% if (error) { %><div class="alert err"><%= error %></div><% } %>

<form id="bumpSubRevisionForm" method="post" action="/settings/subscription-revision/bump"></form>

<div class="grid">
  <section class="card span-6 panel-settings-card" data-settings-key="panel">
    <h2><span class="section-icon" aria-hidden="true">🎛️</span>Настройка панели</h2>
    <p class="muted">Управляет внешним видом мобильной версии: размер интерфейса и тип навигации.</p>
    <form method="post" action="/settings/panel-ui" class="form-grid">
      <div class="field">
        <label>Вид интерфейса панели</label>
        <select name="panel_interface_theme">
          <option value="classic" <%= panelInterfaceTheme === 'classic' ? 'selected' : '' %>>Классический</option>
          <option value="mobile_lite" <%= panelInterfaceTheme === 'mobile_lite' ? 'selected' : '' %>>Mobile Lite</option>
        </select>
        <small class="hint">Mobile Lite применяется на телефоне, а на компьютере остаётся обычная панель.</small>
      </div>

      <div class="field">
        <label>Вид списка клиентов</label>
        <select name="clients_view_mode">
          <option value="modern" <%= clientsViewMode === 'modern' ? 'selected' : '' %>>Новый — таблица как в 3x-ui</option>
          <option value="classic" <%= clientsViewMode === 'classic' ? 'selected' : '' %>>Старый — карточки Aggregator</option>
        </select>
        <small class="hint">Новый вид включён по умолчанию. На телефоне в обоих режимах остаются удобные адаптивные карточки.</small>
      </div>

      <div class="field half">
        <label>Размер мобильного интерфейса</label>
        <select name="panel_mobile_ui_scale">
          <option value="compact" <%= panelMobileUiScale === 'compact' ? 'selected' : '' %>>Компактный</option>
          <option value="normal" <%= panelMobileUiScale === 'normal' ? 'selected' : '' %>>Обычный</option>
          <option value="large" <%= panelMobileUiScale === 'large' ? 'selected' : '' %>>Крупный</option>
        </select>
        <small class="hint">Компактный размер вмещает больше информации на экран телефона.</small>
      </div>

      <div class="field half">
        <label>Мобильное меню</label>
        <select name="panel_mobile_nav_mode">
          <option value="bottom" <%= panelMobileNavMode === 'bottom' ? 'selected' : '' %>>Нижнее меню</option>
          <option value="side" <%= panelMobileNavMode === 'side' ? 'selected' : '' %>>Боковое меню</option>
        </select>
        <small class="hint">Если выбрано нижнее меню, боковая панель на телефоне скрывается.</small>
      </div>

      <div class="field half">
        <label>Узлов на странице</label>
        <select name="nodes_page_size">
          <option value="10" <%= Number(nodesPageSize || 10) === 10 ? 'selected' : '' %>>10</option>
          <option value="12" <%= Number(nodesPageSize || 10) === 12 ? 'selected' : '' %>>12</option>
          <option value="15" <%= Number(nodesPageSize || 10) === 15 ? 'selected' : '' %>>15</option>
        </select>
        <small class="hint">Для страницы «Узлы»: лишние узлы уходят на страницу 2, 3 и далее.</small>
      </div>

      <div class="field half">
        <label>Автопроверка узлов</label>
        <select name="node_auto_refresh_seconds">
          <option value="10" <%= Number(nodeAutoRefreshSeconds) === 10 ? 'selected' : '' %>>Каждые 10 секунд</option>
          <option value="30" <%= Number(nodeAutoRefreshSeconds) === 30 ? 'selected' : '' %>>Каждые 30 секунд</option>
          <option value="60" <%= Number(nodeAutoRefreshSeconds) === 60 ? 'selected' : '' %>>Каждые 60 секунд</option>
          <option value="0" <%= Number(nodeAutoRefreshSeconds) === 0 ? 'selected' : '' %>>Выключить</option>
        </select>
        <small class="hint">Обновляет состояние узлов на странице «Узлы» и на главной.</small>
      </div>

      <div class="field half">
        <label>Онлайн-клиенты</label>
        <select name="client_auto_refresh_seconds">
          <option value="10" <%= Number(clientAutoRefreshSeconds) === 10 ? 'selected' : '' %>>Каждые 10 секунд</option>
          <option value="30" <%= Number(clientAutoRefreshSeconds) === 30 ? 'selected' : '' %>>Каждые 30 секунд</option>
          <option value="60" <%= Number(clientAutoRefreshSeconds) === 60 ? 'selected' : '' %>>Каждые 60 секунд</option>
          <option value="0" <%= Number(clientAutoRefreshSeconds) === 0 ? 'selected' : '' %>>Только вручную</option>
        </select>
        <small class="hint">Интервал списка онлайн-клиентов на дашборде.</small>
      </div>

      <div class="field half">
        <label class="switch-row compact">
          <input type="checkbox" name="panel_mobile_client_compact" value="1" <%= panelMobileClientCompact ? 'checked' : '' %> />
          <span><strong>Краткие карточки клиентов на телефоне</strong><small>Дополнительная экономия места в списке клиентов.</small></span>
        </label>
      </div>

      <div class="field panel-extra-links">
        <strong>Дополнительные разделы для нижнего меню</strong>
        <small class="hint">Когда выбрано нижнее меню, эти разделы доступны здесь.</small>
        <div class="panel-extra-link-grid">
          <a class="link-btn secondary" href="/redirects">🔀 Перенаправление</a>
          <a class="link-btn secondary" href="/diagnostics">🩺 Диагностика</a>
          <a class="link-btn secondary" href="/telegram-bot">✈️ TG-бот</a>
        </div>
      </div>

      <div class="actions">
        <button type="submit" class="icon-btn">💾 Сохранить настройку панели</button>
      </div>
    </form>
  </section>

  <section class="card span-12 happ-control-card" id="happ-control-app" data-settings-key="happ">
    <h2><span class="section-icon" aria-hidden="true">🧭</span>Подписки и приложения</h2>
    <p class="muted">Общие параметры для Happ, INCY, v2RayTun и совместимых клиентов: автообновление, HWID-устройства, ограничения, userinfo, support-url, announce/sub-info и JSON/Xray. Платный Happ Provider ID не используется.</p>

    <form method="post" action="/settings/happ-control" class="happ-control-form">
      <div class="happ-control-layout">
        <div class="happ-control-main">
          <div class="happ-section-title">1. Подписка и автообновление</div>
          <div class="happ-control-grid">
            <label class="switch-row compact happ-help-source" data-help-title="Показывать HAPP-ссылку" data-help-text="Добавляет кнопку и QR для /happ/:slug в списке клиентов. Сам маршрут остаётся доступен для старых ссылок даже если кнопку скрыть.">
              <input type="checkbox" name="show_happ_links" value="1" <%= showHappLinks ? 'checked' : '' %> />
              <span><strong>Показывать HAPP-подписку</strong><small>Кнопка /happ и QR-код в карточках клиентов.</small></span>
            </label>

            <label class="switch-row compact happ-help-source" data-help-title="Передавать автообновление" data-help-text="Отдаёт profile-update-interval / subscription-update-interval и включает subscription-auto-update-enable. Happ создаёт задачу обновления подписки с указанным интервалом.">
              <input type="checkbox" name="subscription_client_auto_update_enabled" value="1" <%= subscriptionClientAutoUpdateEnabled ? 'checked' : '' %> />
              <span><strong>Автообновление в подписке</strong><small>Бесплатный параметр Happ: обновлять профиль по интервалу.</small></span>
            </label>

            <div class="field half happ-help-source" data-help-title="Интервал автообновления" data-help-text="Значение в часах. Например 1 = примерно раз в час от последней задачи/обновления, а не строго в 14:00, 15:00. Если обновление пропущено, Happ выполнит его при следующем запуске приложения.">
              <label>Интервал автообновления, часов</label>
              <input name="subscription_update_interval_hours" type="number" min="1" max="168" step="1" value="<%= subscriptionUpdateIntervalHours || 1 %>" required />
              <small class="hint">1–168 часов.</small>
            </div>

            <label class="switch-row compact happ-help-source" data-help-title="Subscription-Userinfo" data-help-text="Передаёт upload/download/total/expire в HTTP-заголовке subscription-userinfo. Клиенты, которые понимают этот заголовок, показывают шкалу трафика и срок подписки.">
              <input type="checkbox" name="subscription_userinfo_header" value="1" <%= sendSubscriptionUserInfo ? 'checked' : '' %> />
              <span><strong>Полоса трафика и срок</strong><small>Заголовок Subscription-Userinfo.</small></span>
            </label>

            <label class="switch-row compact happ-help-source" data-help-title="Живой расход трафика" data-help-text="При обновлении подписки агрегатор коротко опрашивает 3x-ui узлы, чтобы обновить использованный трафик. Если узел недоступен, будет показан кэш.">
              <input type="checkbox" name="subscription_live_usage" value="1" <%= refreshSubscriptionUsage ? 'checked' : '' %> />
              <span><strong>Обновлять расход при обновлении подписки</strong><small>Обновляет лимиты и трафик перед выдачей подписки.</small></span>
            </label>
          </div>

          <div class="happ-section-title">2. Устройства и блокировки</div>
          <div class="alert ok subscription-limit-unified-note">
            Лимиты разделены: <strong>IP limit</strong> применяется на удалённых узлах, а <strong>лимит устройств</strong> — только к HWID-активациям подписки Nexus. Значение 0 в любом из полей означает безлимит.
          </div>
          <div class="happ-control-grid">
            <label class="switch-row compact happ-help-source" data-help-title="Учитывать HWID-устройства" data-help-text="При обновлении подписки Nexus сохраняет X-HWID и доступные данные устройства. Happ, INCY и v2RayTun поддерживают этот формат. HWID хранится только в виде одностороннего SHA-256 хеша и короткой подсказки.">
              <input type="checkbox" name="subscription_device_tracking_enabled" value="1" <%= subscriptionDeviceTrackingEnabled ? 'checked' : '' %> />
              <span><strong>Учитывать устройства по HWID</strong><small>Показывает 2/5, ОС, модель, приложение и последнее обновление.</small></span>
            </label>

            <label class="switch-row compact happ-help-source" data-help-title="Ограничивать устройства" data-help-text="Nexus использует отдельное поле «Лимит устройств» у клиента. Лимит IP на узлах на HWID-регистрацию больше не влияет. Если лимит уменьшить ниже числа старых HWID, лишние устройства блокируются при следующем обновлении.">
              <input type="checkbox" name="subscription_device_limit_enforced" value="1" <%= subscriptionDeviceLimitEnforced ? 'checked' : '' %> />
              <span><strong>Блокировать устройства сверх лимита</strong><small>Например, шестое устройство при лимите 5.</small></span>
            </label>

            <label class="switch-row compact happ-help-source" data-help-title="Требовать HWID" data-help-text="Если включить, клиент без X-HWID при заданном лимите устройств не получит реальные узлы. Оставьте выключенным для совместимости со старыми и неподдерживаемыми приложениями.">
              <input type="checkbox" name="subscription_device_require_hwid" value="1" <%= subscriptionDeviceRequireHwid ? 'checked' : '' %> />
              <span><strong>Требовать HWID при лимите</strong><small>Строгий режим. По умолчанию выключен для совместимости.</small></span>
            </label>

            <div class="field happ-help-source" data-help-title="Название при превышении лимита" data-help-text="Короткое название служебного VLESS-узла. После него можно отдать один или несколько выбранных служебных узлов.">
              <label>Сообщение при превышении лимита</label>
              <input name="subscription_device_limit_notice_title" maxlength="80" value="<%= subscriptionDeviceLimitNoticeTitle || '' %>" placeholder="⚠️ Превышен лимит устройств" />
            </div>

            <div class="field span-2 subscription-policy-field happ-help-source" data-help-title="Узлы при превышении лимита" data-help-text="Эти узлы скрываются из обычной активной подписки и появляются только устройству сверх лимита, сразу после служебного сообщения. Если клиента ещё нет на выбранном узле, Nexus создаст его там автоматически при первом таком обновлении.">
              <label>Узлы, доступные при превышении лимита устройств</label>
              <div class="subscription-policy-node-picker">
                <% if (!(subscriptionPolicyNodes || []).length) { %>
                  <small class="hint">Нет доступных узлов.</small>
                <% } %>
                <% (subscriptionPolicyNodes || []).forEach(node => { const selected = (subscriptionDeviceLimitNodeIds || []).map(Number).includes(Number(node.id)); %>
                  <label class="subscription-policy-node-option">
                    <input type="checkbox" name="subscription_device_limit_node_ids" value="<%= node.id %>" <%= selected ? 'checked' : '' %> />
                    <span><strong><%= nodeFlagText(node) || '' %> <%= node.country_name_ru || node.name %></strong><small><%= node.name %></small></span>
                  </label>
                <% }) %>
              </div>
              <small class="hint">Пусто = при превышении показывать только служебный узел-предупреждение. Для выбранных служебных узлов Nexus снимает IP/трафик-лимит, чтобы лишнее устройство могло открыть поддержку; ограничения должны задаваться маршрутизацией самого узла.</small>
            </div>

            <label class="switch-row compact happ-help-source" data-help-title="Скрывать узлы после окончания срока" data-help-text="После окончания срока обычные узлы не выдаются. Сначала показывается служебный узел с сообщением, а затем — только выбранные grace-узлы на 3 или 7 дней.">
              <input type="checkbox" name="subscription_expired_notice_enabled" value="1" <%= subscriptionExpiredNoticeEnabled ? 'checked' : '' %> />
              <span><strong>Заменять узлы после окончания подписки</strong><small>Обычные серверы скрываются после expiry.</small></span>
            </label>

            <div class="field happ-help-source" data-help-title="Название просроченного узла" data-help-text="Короткое название первого служебного узла после окончания срока. Следом будут выбранные grace-узлы.">
              <label>Сообщение после окончания срока</label>
              <input name="subscription_expired_notice_title" maxlength="80" value="<%= subscriptionExpiredNoticeTitle || '' %>" placeholder="⛔ Продлите подписку" />
            </div>

            <div class="field happ-help-source" data-help-title="Grace-период" data-help-text="На выбранных ниже узлах удалённый срок клиента временно продлевается только до конца grace-периода. Сам клиент в Nexus остаётся просроченным.">
              <label>Служебный доступ после окончания</label>
              <select name="subscription_expired_grace_days">
                <option value="3" <%= Number(subscriptionExpiredGraceDays) === 3 ? 'selected' : '' %>>3 дня</option>
                <option value="7" <%= Number(subscriptionExpiredGraceDays) !== 3 ? 'selected' : '' %>>7 дней</option>
              </select>
            </div>

            <div class="field span-2 subscription-policy-field happ-help-source" data-help-title="Grace-узлы после окончания" data-help-text="Выберите специальный узел, где серверная маршрутизация уже ограничена, например только Telegram и WhatsApp. Эти узлы скрыты из обычной подписки и появляются после expiry на выбранные 3/7 дней. Если клиента на таком узле ещё нет, Nexus создаст его автоматически при первом просроченном обновлении.">
              <label>Узлы, доступные после окончания подписки</label>
              <div class="subscription-policy-node-picker">
                <% if (!(subscriptionPolicyNodes || []).length) { %>
                  <small class="hint">Нет доступных узлов.</small>
                <% } %>
                <% (subscriptionPolicyNodes || []).forEach(node => { const selected = (subscriptionExpiredGraceNodeIds || []).map(Number).includes(Number(node.id)); %>
                  <label class="subscription-policy-node-option">
                    <input type="checkbox" name="subscription_expired_grace_node_ids" value="<%= node.id %>" <%= selected ? 'checked' : '' %> />
                    <span><strong><%= nodeFlagText(node) || '' %> <%= node.country_name_ru || node.name %></strong><small><%= node.name %></small></span>
                  </label>
                <% }) %>
              </div>
              <small class="hint">Важно: на выбранных grace-узлах Nexus временно снимает IP/трафик-лимит и продлевает только удалённую учётку до конца 3/7 дней. Узел обязательно должен быть ограничен серверной маршрутизацией. Если он разрешает весь интернет, просроченный клиент тоже получит весь интернет через него.</small>
            </div>
          </div>

          <div class="happ-section-title">3. Текст, поддержка и карточка подписки</div>
          <div class="happ-control-grid">
            <div class="field happ-help-source" data-help-title="Текст помощи" data-help-text="Короткое сообщение для клиента. Оно используется на странице подключения и может попадать в announce/sub-info, если включён инфо-блок Happ.">
              <label>Текст помощи для клиента</label>
              <textarea name="subscription_support_note" rows="3" placeholder="⚠️ Не работает? Обнови подписку, выбери другой сервер или напиши в поддержку."><%= subscriptionSupportNote || '' %></textarea>
            </div>

            <div class="field happ-help-source" data-help-title="Support URL" data-help-text="Передаётся как support-url и profile-web-page-url. Happ показывает кнопку поддержки рядом с подпиской; для Telegram обычно будет своя иконка.">
              <label>Ссылка поддержки</label>
              <input name="subscription_support_url" value="<%= subscriptionSupportUrl || '' %>" placeholder="https://t.me/... или https://site.example" />
            </div>

            <label class="switch-row compact happ-help-source" data-help-title="Happ sub-info / announce" data-help-text="Показывает логин, лимит устройств, расход трафика и текст помощи под подпиской. Для совместимости можно дублировать тот же текст в обычный announce.">
              <input type="checkbox" name="subscription_happ_info_enabled" value="1" <%= subscriptionHappInfoEnabled ? 'checked' : '' %> />
              <span><strong>Показывать Happ-инфо</strong><small>Логин, устройства, трафик и текст помощи.</small></span>
            </label>

            <label class="switch-row compact happ-help-source" data-help-title="Дублировать в announce" data-help-text="Рекомендуется включить: если конкретная версия Happ не показывает sub-info, клиент всё равно увидит текст через обычное объявление announce.">
              <input type="checkbox" name="subscription_happ_info_announce_fallback_enabled" value="1" <%= subscriptionHappInfoAnnounceFallbackEnabled ? 'checked' : '' %> />
              <span><strong>Дублировать в announce</strong><small>Больше совместимости между версиями Happ.</small></span>
            </label>

            <div class="field happ-help-source" data-help-title="Шаблон инфо-блока" data-help-text="Можно использовать {login}, {display_name}, {device_usage}, {device_count}, {device_limit}, {limit_ip}, {traffic_usage}, {days_left}, {expiry_date}, {support_note}. Старый {ip_usage} сохранён как синоним {device_usage}.">
              <label>Шаблон инфо-блока</label>
              <textarea name="subscription_happ_info_template" rows="4" placeholder="👤 Логин: {login}&#10;📱 Устройства: {device_usage}&#10;📊 Трафик: {traffic_usage}&#10;{support_note}"><%= subscriptionHappInfoTemplate || '' %></textarea>
            </div>

            <div class="field half happ-help-source" data-help-title="Цвет инфо-блока" data-help-text="Цвет карточки sub-info в Happ, если версия приложения поддерживает расширенный инфо-блок.">
              <label>Цвет инфо-блока</label>
              <select name="subscription_happ_info_color">
                <option value="blue" <%= subscriptionHappInfoColor === 'blue' ? 'selected' : '' %>>blue</option>
                <option value="green" <%= subscriptionHappInfoColor === 'green' ? 'selected' : '' %>>green</option>
                <option value="red" <%= subscriptionHappInfoColor === 'red' ? 'selected' : '' %>>red</option>
              </select>
            </div>

            <div class="field half happ-help-source" data-help-title="Кнопка Happ" data-help-text="Текст и ссылка кнопки в sub-info. Если ссылка кнопки пустая, будет использована ссылка поддержки.">
              <label>Текст кнопки Happ</label>
              <input name="subscription_happ_info_button_text" maxlength="25" value="<%= subscriptionHappInfoButtonText || '' %>" placeholder="Поддержка" />
            </div>

            <div class="field happ-help-source" data-help-title="Ссылка кнопки Happ" data-help-text="Отдельная ссылка для кнопки sub-info. Можно оставить пустой, тогда возьмётся Support URL.">
              <label>Ссылка кнопки Happ</label>
              <input name="subscription_happ_info_button_link" value="<%= subscriptionHappInfoButtonLink || '' %>" placeholder="https://t.me/..." />
            </div>

            <label class="switch-row compact happ-help-source" data-help-title="Server Description" data-help-text="Добавляет короткую подпись под каждой локацией: в VLESS как serverDescription, в JSON как meta.serverDescription. Ограничение около 30 символов.">
              <input type="checkbox" name="subscription_happ_server_description_enabled" value="1" <%= subscriptionHappServerDescriptionEnabled ? 'checked' : '' %> />
              <span><strong>Подпись под каждой локацией</strong><small>Например: VLESS / TCP / REALITY.</small></span>
            </label>

            <div class="field happ-help-source" data-help-title="Шаблон подписи сервера" data-help-text="Переменные: {protocol}, {network}, {security}, {node}, {country}. Слишком длинный текст Happ может обрезать.">
              <label>Шаблон подписи сервера</label>
              <input name="subscription_happ_server_description_template" value="<%= subscriptionHappServerDescriptionTemplate || '' %>" placeholder="VLESS / {network} / JSON" />
            </div>
          </div>

          <div class="happ-section-title">4. JSON/Xray и маршрутизация</div>
          <div class="happ-control-grid happ-json-toggle-grid">
            <% [['sniffing', jsonSniffingEnabled, jsonSniffingNodeIds, 'Sniffing в JSON', 'enabled: true · destOverride: [http, tls]'], ['mux', jsonMuxEnabled, jsonMuxNodeIds, 'MUX в JSON', '100 TCP · 200 XUDP · UDP/443 skip']].forEach(([key, enabled, selectedIds, title, detail]) => { %>
              <div class="json-node-policy <%= key === 'mux' ? 'danger-option' : '' %>" data-json-node-policy>
                <label class="switch-row compact happ-help-source" data-help-title="<%= title %>" data-help-text="Параметр добавляется только в JSON-конфиги отмеченных ниже узлов. Он не наследуется из inbound 3x-ui: серверный inbound и клиентский outbound JSON — разные конфигурации.">
                  <input type="checkbox" name="json_<%= key %>_enabled" value="1" <%= enabled ? 'checked' : '' %> data-json-policy-toggle />
                  <span><strong><%= title %></strong><small><code><%= detail %></code></small></span>
                </label>
                <div class="json-node-picker" data-json-node-picker <%= enabled ? '' : 'hidden' %>>
                  <div class="json-node-picker-head">
                    <strong>Применять к узлам</strong>
                    <span><button type="button" data-json-select-all>Все</button><button type="button" data-json-clear>Снять</button></span>
                  </div>
                  <div class="json-node-picker-list">
                    <% subscriptionPolicyNodes.forEach(node => { %>
                      <label><input type="checkbox" name="json_<%= key %>_node_ids" value="<%= node.id %>" <%= selectedIds.map(Number).includes(Number(node.id)) ? 'checked' : '' %> /><span><span class="json-node-flag" aria-hidden="true"><%= countryFlagText(node.country_code, node.country_flag, node.country_name_ru || node.name) || '🌐' %></span><%= node.country_name_ru || node.name %></span></label>
                    <% }) %>
                  </div>
                </div>
              </div>
            <% }) %>

            <label class="switch-row compact happ-help-source" data-help-title="Отдельный Happ routing-профиль" data-help-text="Добавляет в HAPP-подписку отдельный routing header и ссылку на профиль Happ. Не влияет на правила Xray, уже встроенные в обычную JSON-подписку.">
              <input type="checkbox" name="happ_routing_profile_enabled" value="1" <%= happRoutingProfileEnabled ? 'checked' : '' %> />
              <span><strong>Happ routing-профиль</strong><small>Отдельная функция · по умолчанию выключена.</small></span>
            </label>
          </div>

          <div class="alert ok happ-routing-link-note">
            Маршруты, GeoSite/GeoIP, DNS и блокировка из раздела <a href="/routing">«Маршрутизация»</a> встраиваются непосредственно в обычный JSON. Переключатель Happ выше управляет только отдельным routing-профилем приложения.
          </div>

          <div class="alert ok happ-free-only-note">
            Бесплатная сборка не отправляет Provider ID, autoconnect, ping-on-open/TCP ping, update-on-open, fragmentation/noises, Happ mux, no-limit и другие app-control параметры. Это сделано специально, чтобы Happ не получал платные/рискованные директивы.
          </div>

          <div class="actions">
            <button type="submit" class="icon-btn">💾 Сохранить подписки и приложения</button>
            <a class="link-btn secondary" href="/routing">Открыть расширенную маршрутизацию</a>
          </div>
        </div>

        <aside class="happ-help-panel" id="happ-help-panel" aria-live="polite">
          <div class="happ-help-kicker">Описание параметра</div>
          <h3 id="happ-help-title">Наведи мышкой на настройку</h3>
          <p id="happ-help-text">Справа будет показано, что делает выбранный параметр в Happ или JSON-подписке. На телефоне нажми на настройку, чтобы обновить описание.</p>
        </aside>
      </div>
    </form>
  </section>

  <section class="card span-6 settings-transfer-card" id="settings-transfer-card" data-settings-key="transfer">
    <h2><span class="section-icon" aria-hidden="true">📦</span>Перенос настроек</h2>
    <div class="kv-list">
      <div class="kv-item">
        <strong>Отдельный зашифрованный пакет</strong>
        <div class="muted">Переносит настройки подписок, Happ, routing, Telegram, узлы с паролями/API-токенами, SNI и редиректы. Клиенты в этот файл не входят.</div>
        <div class="alert ok" style="margin-top:10px;">IP/URL развертывания, ключ входа, разрешённые admin IP и учётная запись администратора новой панели сохраняются. Редиректы импортируются отключёнными до проверки.</div>
        <label style="margin-top:12px;">Парольная фраза экспорта (минимум 12 символов)</label>
        <input id="settings-transfer-export-passphrase" type="password" minlength="12" autocomplete="new-password" placeholder="Запиши её: без фразы файл не восстановить" />
        <label>Повтори парольную фразу</label>
        <input id="settings-transfer-export-confirm" type="password" minlength="12" autocomplete="new-password" />
        <div class="actions" style="margin-top:12px;">
          <button type="button" onclick="window.exportSettingsTransfer && window.exportSettingsTransfer(this)">Скачать .nxsettings</button>
        </div>
      </div>
      <div class="kv-item">
        <strong>Проверить или импортировать</strong>
        <input id="settings-transfer-file" type="file" accept=".nxsettings,application/json" style="margin-top:12px;" />
        <label style="margin-top:12px;">Парольная фраза файла</label>
        <input id="settings-transfer-import-passphrase" type="password" minlength="12" autocomplete="current-password" />
        <div class="actions" style="margin-top:12px;">
          <button type="button" class="secondary" onclick="window.importSettingsTransfer && window.importSettingsTransfer(this, true)">Проверить без записи</button>
          <button type="button" onclick="window.importSettingsTransfer && window.importSettingsTransfer(this, false)">Импортировать настройки</button>
        </div>
        <pre id="settings-transfer-status" class="muted" style="margin-top:10px;white-space:pre-wrap;max-height:300px;overflow:auto;"></pre>
        <small class="hint">Перед настоящим импортом создаётся <code>data/backups/settings-import-before-*.db</code>. После импорта перезапусти контейнер панели.</small>
      </div>
    </div>
  </section>

  <section class="card span-6" data-settings-key="general">
    <h2><span class="section-icon" aria-hidden="true">⚙️</span>Общие настройки</h2>
    <form method="post" action="/settings">
      <div class="form-grid">
        <div class="field">
          <label>Название подписки</label>
          <input name="subscription_name" value="<%= subscriptionName %>" placeholder="AMG" required />
          <small class="hint">Это имя VPN в приложении и на публичной странице клиента.</small>
        </div>

        <div class="field">
          <label>Подзаголовок страницы подписки</label>
          <input name="subscription_brand_tagline" value="<%= subscriptionBrandTagline %>" maxlength="80" placeholder="Безопасное подключение" />
          <small class="hint">Короткая фраза под названием. Логины, UUID и ссылки клиентов при смене бренда не меняются.</small>
        </div>


        <div class="field">
          <div class="kv-item">
            <strong>Ревизия подписок: <%= subscriptionRevision %></strong>
            <small class="hint">При изменении названия/надписи ревизия меняется автоматически. Старые ссылки /json, /sub и /happ перенаправляются на новую <code>?rev=...</code>, чтобы приложения меньше держали старый кэш.</small>
            <button type="submit" form="bumpSubRevisionForm" class="btn-secondary" style="margin-top:10px">Принудительно обновить ревизию подписок</button>
          </div>
        </div>

        <div class="field">
          <label class="switch-row compact">
            <input type="checkbox" name="show_sub_links" value="1" <%= showSubLinks ? 'checked' : '' %> />
            <span><strong>Показывать SUB-подписку клиентам</strong><small>Добавляет SUB в профиль, кнопку копирования и QR-код. Подходит для Hiddify и других приложений, которые не импортируют JSON-ссылку.</small></span>
          </label>
        </div>

        <div class="field">
          <label class="switch-row compact">
            <input type="checkbox" name="show_json_links" value="1" <%= showJsonLinks ? 'checked' : '' %> />
            <span><strong>Показывать JSON-подписку клиентам</strong><small>Добавляет JSON в профиль, кнопку копирования и QR-код. Если JSON и SUB включены вместе, панель предложит оба варианта.</small></span>
          </label>
        </div>

        <div class="field">
          <h3 style="margin:10px 0 0;">Адреса панели и подписок</h3>
          <small class="hint">Админка может открываться по одной ссылке, а клиентские JSON/SUB-ссылки могут выдаваться с другого публичного адреса.</small>
        </div>

        <div class="field">
          <label>Адрес входа в панель</label>
          <input name="panel_public_url" value="<%= panelPublicUrl || '' %>" placeholder="https://panel.example.com:3001" />
          <small class="hint">Используется для показа адреса входа. Сам порт сервера меняется через <code>agg</code>, потому что после смены порта нужен перезапуск Docker/Caddy.</small>
        </div>

        <div class="field">
          <label>Режим ссылок подписок</label>
          <select name="sub_url_mode">
            <option value="custom" <%= subUrlMode === 'custom' ? 'selected' : '' %>>Свой публичный адрес подписок</option>
            <option value="panel_without_port" <%= subUrlMode === 'panel_without_port' ? 'selected' : '' %>>Адрес панели без порта</option>
            <option value="panel" <%= subUrlMode === 'panel' ? 'selected' : '' %>>Адрес панели как есть, включая порт</option>
          </select>
          <small class="hint">Для твоего варианта обычно нужно: «Свой публичный адрес подписок» и адрес вида <code>https://amg.amored.ru</code>.</small>
        </div>

        <div class="field">
          <label>Публичный адрес подписок JSON/SUB</label>
          <input name="sub_public_url" value="<%= subPublicUrl || '' %>" placeholder="https://amg.amored.ru" />
          <small class="hint">Клиенты будут получать ссылки вида <code><%= publicJsonExample || '' %></code>. Адрес входа администратора на эти ссылки не влияет.</small>
        </div>

        <div class="field">
          <label>GitHub проекта для проверки обновлений</label>
          <input name="update_repo_url" value="<%= updateRepoUrl || 'https://github.com/dagmagnat/Nexus-Panel' %>" placeholder="https://github.com/dagmagnat/Nexus-Panel" />
          <small class="hint">По умолчанию используется твой репозиторий. Если кто-то сделает fork, ссылку можно заменить здесь.</small>
        </div>

        <div class="field">
          <label class="switch-row compact">
            <input type="checkbox" name="subscription_show_limits" value="1" <%= showSubscriptionLimits ? 'checked' : '' %> />
            <span><strong>Показывать расход ГБ и срок в подписках</strong><small>Отключение скрывает цифры от клиента, но заданные лимиты продолжают действовать. Пример при включении: LTE · 7/50 ГБ · 15 дн.</small></span>
          </label>
        </div>

        <div class="field">
          <label class="switch-row compact">
            <input type="checkbox" name="subscription_show_empty_limits" value="1" <%= subscriptionShowEmptyLimits ? 'checked' : '' %> />
            <span><strong>Показывать ∞ у безлимитных узлов</strong><small>Если выключено, у безлимитных клиентов в названии узла не будет «∞ · ∞ дн.» — останется только название региона.</small></span>
          </label>
        </div>

        <div class="field">
          <h3 style="margin:10px 0 0;">Доступ к админке</h3>
          <small class="hint">Для смены логина или пароля обязательно укажи текущий пароль.</small>
        </div>

        <div class="field half">
          <label>Логин администратора</label>
          <input name="admin_username" value="<%= adminUsername || '' %>" autocomplete="username" />
        </div>

        <div class="field half">
          <label>Текущий пароль</label>
          <input name="current_password" type="password" autocomplete="current-password" placeholder="Нужен только для смены логина/пароля" />
        </div>

        <div class="field half">
          <label>Новый пароль</label>
          <input name="new_password" type="password" autocomplete="new-password" placeholder="Минимум 8 символов" />
        </div>

        <div class="field half">
          <label>Повтор нового пароля</label>
          <input name="new_password_confirm" type="password" autocomplete="new-password" />
        </div>

        <div class="field">
          <label>Разрешённые IP для входа в админку</label>
          <textarea name="admin_allowed_ips" rows="4" placeholder="Оставь пустым, чтобы разрешить вход с любого IP"><%= adminAllowedIps || '' %></textarea>
          <small class="hint">Твой текущий IP: <strong><%= currentIp || 'не определён' %></strong>. Можно указать несколько IP через пробел, запятую или с новой строки. Будь осторожен: если указать неправильный IP, вход будет закрыт.</small>
        </div>
      </div>

      <div class="actions">
        <button type="submit">Сохранить</button>
      </div>
    </form>
  </section>

  <section class="card span-6 settings-sni-card" data-settings-key="sni">
    <h2><span class="section-icon" aria-hidden="true">🛡️</span>SNI-профили REALITY</h2>
    <p class="muted">Сохраняй часто используемые SNI, проверяй TLS-доступность и выбирай их потом в узлах. Это меняет только выдаваемую подписку, если в узле выбран профиль.</p>
    <form method="post" action="/settings/sni-profiles" class="form-grid sni-profile-form" data-floating-save-label="SNI-профиль">
      <div class="field half"><label>Название</label><input name="name" placeholder="VK Mobile" required /></div>
      <div class="field half sni-inline-field">
        <label>SNI</label>
        <div class="sni-input-row">
          <input name="sni" placeholder="m.vk.com" required />
          <button type="button" class="secondary sni-check-inline icon-btn" data-sni-check-button>🛡️ Проверить</button>
        </div>
        <div class="sni-check-result hidden" data-sni-check-result></div>
      </div>
      <div class="field"><label>Комментарий</label><input name="comment" placeholder="когда использовать этот SNI" /></div>
      <div class="actions sni-profile-actions">
        <button type="submit" class="icon-btn">💾 Сохранить</button>
        <button type="submit" name="check_now" value="1" class="secondary no-wrap icon-btn">🛡️ Сохранить и проверить</button>
      </div>
    </form>
    <div class="table-wrap compact-table" style="margin-top:14px;">
      <table>
        <thead><tr><th>Название</th><th>SNI</th><th>Статус</th><th>Комментарий</th><th></th></tr></thead>
        <tbody>
          <% (sniProfiles || []).forEach(profile => { %>
            <tr>
              <td data-label="Название"><strong><%= profile.name %></strong><% if (profile.is_builtin) { %><br><small>встроенный</small><% } %></td>
              <td data-label="SNI"><code><%= profile.sni %></code></td>
              <td data-label="Статус"><span class="status <%= profile.last_status === 'ok' ? 'ok' : (profile.last_status === 'error' ? 'off' : '') %>"><%= profile.last_status || 'не проверен' %></span></td>
              <td data-label="Комментарий"><small><%= profile.comment || '—' %></small></td>
              <td data-label="Действие" class="<%= profile.is_builtin ? 'sni-action-empty' : '' %>">
                <% if (!profile.is_builtin) { %>
                  <form method="post" action="/settings/sni-profiles/<%= profile.id %>/delete" onsubmit="return confirm('Удалить SNI-профиль?')"><button type="submit" class="danger small">Удалить</button></form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="card span-6 settings-backup-card" data-settings-key="backup">
    <h2><span class="section-icon" aria-hidden="true">💾</span>Резервная копия</h2>
    <div class="kv-list">
      <div class="kv-item">
        <strong>Скачать резервную копию</strong>
        <div class="muted">Сохраняет пользователей панели, настройки, узлы, клиентов и связи клиентов с узлами.</div>
        <div class="muted" style="margin-top:8px;">Имя файла теперь содержит домен или IP панели в конце: <code><%= backupFileExample %></code></div>
        <div class="actions" style="margin-top:12px;">
          <a class="button" href="/backup/download">Создать и скачать</a>
        </div>
      </div>
      <div class="kv-item">
        <strong>Восстановить из резервной копии</strong>
        <div class="muted">После восстановления текущая база будет заменена, а сессия сброшена.</div>
        <input id="backup-file" type="file" accept="application/json,.json" style="margin-top:12px;" />
        <div class="actions" style="margin-top:12px;">
          <button id="backup-restore-btn" type="button" onclick="window.restoreBackup && window.restoreBackup()">Загрузить резервную копию</button>
        </div>
        <div id="backup-restore-status" class="muted" style="margin-top:10px;"></div>
        <small class="hint">Важно: сюда загружается только JSON-бэкап, созданный кнопкой «Создать и скачать» в панели или кнопкой «💾 Бэкап» в Telegram-боте. Backup из команды <code>agg</code> — это tar.gz-архив папки проекта для восстановления сервера через SSH, он не восстанавливается через эту форму.</small>
      </div>
    </div>
  </section>

  <section class="card span-6" id="project-update-card" data-settings-key="updates">
    <h2><span class="section-icon" aria-hidden="true">🔄</span>Обновление проекта</h2>
    <div class="kv-list update-box compact-update-box">
      <div class="kv-item">
        <div class="update-version-row"><span><strong>Установлено</strong><small>Текущая версия панели</small></span><code id="upd-current-version"><%= projectUpdateStatus.currentVersion || '0.1.0' %></code></div>
        <div class="muted" id="upd-remote-line"><% if (projectUpdateStatus.remoteVersion) { %>GitHub version: <code><%= projectUpdateStatus.remoteVersion %></code> · <%= projectUpdateStatus.hasUpdate ? 'доступно обновление' : 'обновлений не найдено' %><% } else { %>Нажми «Проверить», чтобы получить последнюю версию с GitHub.<% } %></div>
        <div class="muted" id="upd-error-line"><% if (projectUpdateStatus.error) { %>Проверка GitHub не удалась: <%= projectUpdateStatus.error %><% } %></div>
        <ul class="muted" id="upd-notes"><% if (projectUpdateStatus.notes && projectUpdateStatus.notes.length) { projectUpdateStatus.notes.forEach(n => { %><li><%= n %></li><% }) } %></ul>
        <div class="muted" id="upd-runtime-line">Статус обновления: не запущено</div>
        <details class="update-technical-details">
          <summary>Технические сведения</summary>
          <div class="muted">Репозиторий: <code id="upd-repo"><%= projectUpdateStatus.repo || 'dagmagnat/Nexus-Panel' %></code></div>
          <div class="muted">Ветка: <code id="upd-branch"><%= projectUpdateStatus.branch %></code> · commit: <code id="upd-current-commit"><%= projectUpdateStatus.current %></code></div>
          <div class="muted" id="upd-archive-line"><% if (projectUpdateStatus.archiveUrl) { %>Архив: <code><%= projectUpdateStatus.archiveUrl %></code><% } %></div>
        </details>
      </div>
    </div>
    <div class="actions update-actions">
      <button type="button" class="secondary" onclick="checkProjectUpdate(this)">Проверить</button>
      <button type="button" class="btn-main" id="project-update-btn" onclick="startProjectUpdate(this)" disabled>Обновить</button>
      <a class="link-btn secondary" href="/backup/download" target="_blank">Скачать backup</a>
      <button type="button" class="secondary" onclick="copyText('agg update', this)">Скопировать agg</button>
    </div>
    <small class="hint">«Обновить» автоматически создаёт backup, заменяет только файлы проекта и перезапускает панель. Клиенты, настройки и база сохраняются.</small>
  </section>

  <div class="modal-backdrop" id="project-update-modal" style="display:none;">
    <div class="modal-card small-modal project-update-progress-card" data-update-state="queued">
      <button type="button" class="modal-close" onclick="closeProjectUpdateModal()">×</button>
      <div class="update-progress-icon"><span class="loader-ring"></span><span class="update-success-mark">✓</span><span class="update-error-mark">!</span></div>
      <h2>Обновление проекта</h2>
      <p id="project-update-modal-text" class="muted">Подготовка...</p>
      <div class="update-progress-track"><i id="project-update-progress-bar"></i></div>
      <div class="update-progress-steps" aria-label="Этапы обновления"><span data-update-step="queued">Подготовка</span><span data-update-step="downloading">Загрузка</span><span data-update-step="installing">Установка</span><span data-update-step="success">Готово</span></div>
      <details id="project-update-log-details" class="update-log-details" hidden><summary>Показать технические сведения</summary><pre id="project-update-log" class="mini-log"></pre></details>
    </div>
  </div>


  <section class="card span-6 settings-server-card" data-settings-key="server">
    <h2><span class="section-icon" aria-hidden="true">🖥️</span>Сервер и обслуживание</h2>
    <div class="kv-list">
      <div class="kv-item">
        <strong>Текущий запуск</strong>
        <div class="muted">Порт приложения: <code><%= runtimePort %></code></div>
        <div class="muted">Привязка портов к IP: <code><%= runtimeBindIp || 'не задана, все IP сервера' %></code></div>
        <div class="muted">Secure cookie: <code><%= runtimeSessionSecure ? 'включено' : 'выключено' %></code>, trust proxy: <code><%= runtimeTrustProxy ? 'включено' : 'выключено' %></code></div>
        <div class="muted" style="margin-top:8px;">Порт и режим Caddy меняются через <code>agg</code>, потому что после изменения нужен перезапуск контейнеров. В веб-панели можно безопасно менять публичный адрес подписок.</div>
      </div>

      <div class="kv-item">
        <strong>Команды на сервере</strong>
        <div class="command-row">
          <code>agg</code>
          <button type="button" class="secondary" onclick="copyText('agg update', this)">Копировать</button>
        </div>
        <div class="command-row">
          <code>cd <%= appDirHint %> &amp;&amp; docker compose logs --tail=100</code>
          <button type="button" class="secondary" onclick="copyText('cd <%= appDirHint %> && docker compose logs --tail=100', this)">Копировать</button>
        </div>
        <div class="command-row">
          <code>bash <%= appDirHint %>/uninstall.sh</code>
          <button type="button" class="secondary" onclick="copyText('bash <%= appDirHint %>/uninstall.sh', this)">Копировать</button>
        </div>
        <small class="hint">Удаление из веб-панели специально не запускается: контейнер не получает root-доступ к серверу и Docker socket, чтобы не снижать безопасность. Удаление доступно через <code>agg</code> или команду выше.</small>
      </div>

      <div class="kv-item">
        <strong>Какие ссылки сейчас будут выдаваться</strong>
        <div class="muted">Вход в панель: <code><%= panelLoginUrl || panelPublicUrl || '' %></code></div>
        <div class="muted">Вход с телефона/ярлыка: <code><%= panelMobileLoginUrl || panelLoginUrl || '' %></code></div>
        <div class="muted">JSON клиенту: <code><%= publicJsonExample || '' %></code></div>
        <div class="muted">SUB клиенту: <code><%= publicSubExample || '' %></code></div>
        <div class="muted">HAPP клиенту: <code><%= publicHappExample || '' %></code></div>
        <div class="command-row">
          <code><%= panelMobileLoginUrl || panelLoginUrl || '' %></code>
          <button type="button" class="secondary" onclick="copyText('<%= panelMobileLoginUrl || panelLoginUrl || '' %>', this)">Скопировать вход для телефона</button>
        </div>
        <div class="muted">Backup-каталог на сервере: <code><%= backupDirHint %></code></div>
      </div>
    </div>
  </section>

  <section class="card span-6 settings-security-card" data-settings-key="security">
    <h2><span class="section-icon" aria-hidden="true">🔒</span>Безопасность</h2>
    <form method="post" action="/settings/security" class="form-grid security-settings-form">
      <div class="field half">
        <label>Автовыход при бездействии, минут</label>
        <select name="admin_idle_timeout_minutes">
          <% [10, 15, 20, 30, 60, 120, 240, 1440].forEach(v => { %>
            <option value="<%= v %>" <%= Number(adminIdleTimeoutMinutes || 20) === v ? 'selected' : '' %>><%= v === 1440 ? '24 часа' : v + ' мин.' %></option>
          <% }) %>
        </select>
        <small class="hint">По умолчанию 20 минут. После этого панель попросит войти заново.</small>
      </div>
      <label class="field half switch-row compact">
        <input type="checkbox" name="admin_bind_session_to_ip" value="1" <%= adminBindSessionToIp ? 'checked' : '' %> />
        <span><strong>Выходить при смене IP</strong><small>Безопаснее для ПК. Для мобильного интернета может выбрасывать при смене сети.</small></span>
      </label>
      <div class="kv-list field full security-info-list">
        <div class="kv-item"><strong>Защита от перебора</strong><div class="muted">После 5 неверных попыток вход блокируется на 15 минут для пары IP + логин.</div></div>
        <div class="kv-item"><strong>Разделение входа и подписок</strong><div class="muted">Вход в админку работает по обычному адресу и защищён логином, паролем, сессией и ограничением попыток. JSON/SUB-ссылки клиентов можно выдавать с отдельного публичного адреса.</div></div>
      </div>
      <div class="actions field full"><button type="submit" class="btn-main">Сохранить безопасность</button></div>
    </form>
  </section>
</div>

<script>
async function copyText(value, button) {
  try {
    await navigator.clipboard.writeText(String(value || ''));
    if (button) {
      const old = button.textContent;
      button.textContent = 'Скопировано';
      setTimeout(() => { button.textContent = old; }, 1200);
    }
  } catch (err) {
    alert('Не удалось скопировать. Скопируй вручную.');
  }
}

const HAPP_LOYAL_GEOSITE_URL = 'https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat';
const HAPP_LOYAL_GEOIP_URL = 'https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat';

function syncHappGeoSourceFields() {
  const source = document.getElementById('happ-geodata-source')?.value || 'loyalsoldier';
  const geosite = document.getElementById('happ-geosite-url');
  const geoip = document.getElementById('happ-geoip-url');
  if (!geosite || !geoip) return;
  if (source === 'loyalsoldier') {
    geosite.value = HAPP_LOYAL_GEOSITE_URL;
    geoip.value = HAPP_LOYAL_GEOIP_URL;
    geosite.readOnly = true;
    geoip.readOnly = true;
  } else if (source === 'official') {
    geosite.value = '';
    geoip.value = '';
    geosite.readOnly = true;
    geoip.readOnly = true;
  } else {
    geosite.readOnly = false;
    geoip.readOnly = false;
  }
}

function setHappGeoPreset(kind) {
  const presets = {
    loyal: ['loyalsoldier', HAPP_LOYAL_GEOSITE_URL, HAPP_LOYAL_GEOIP_URL],
    ru: ['custom', 'https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/release/geosite.dat', 'https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/release/geoip.dat'],
    iran: ['custom', 'https://github.com/chocolate4u/Iran-v2ray-rules/releases/latest/download/geosite.dat', 'https://github.com/chocolate4u/Iran-v2ray-rules/releases/latest/download/geoip.dat']
  };
  const chosen = presets[kind];
  if (!chosen) return;
  const source = document.getElementById('happ-geodata-source');
  const geosite = document.getElementById('happ-geosite-url');
  const geoip = document.getElementById('happ-geoip-url');
  if (source) source.value = chosen[0];
  if (geosite) geosite.value = chosen[1];
  if (geoip) geoip.value = chosen[2];
  syncHappGeoSourceFields();
}

function initHappHelpPanel() {
  const panel = document.getElementById('happ-help-panel');
  const title = document.getElementById('happ-help-title');
  const text = document.getElementById('happ-help-text');
  if (!panel || !title || !text) return;
  const update = (el) => {
    const t = el.getAttribute('data-help-title') || 'Параметр';
    const body = el.getAttribute('data-help-text') || 'Описание не задано.';
    title.textContent = t;
    text.textContent = body;
    panel.classList.add('is-active');
  };
  document.querySelectorAll('.happ-help-source').forEach(el => {
    el.addEventListener('mouseenter', () => update(el));
    el.addEventListener('focusin', () => update(el));
    el.addEventListener('click', () => update(el));
  });
}

function initJsonNodePolicies() {
  document.querySelectorAll('[data-json-node-policy]').forEach(policy => {
    const toggle = policy.querySelector('[data-json-policy-toggle]');
    const picker = policy.querySelector('[data-json-node-picker]');
    const choices = [...policy.querySelectorAll('.json-node-picker-list input[type="checkbox"]')];
    const sync = () => { if (picker) picker.hidden = !toggle?.checked; };
    toggle?.addEventListener('change', sync);
    policy.querySelector('[data-json-select-all]')?.addEventListener('click', () => choices.forEach(choice => { choice.checked = true; }));
    policy.querySelector('[data-json-clear]')?.addEventListener('click', () => choices.forEach(choice => { choice.checked = false; }));
    policy.closest('form')?.addEventListener('submit', event => {
      if (toggle?.checked && !choices.some(choice => choice.checked)) {
        event.preventDefault();
        picker.hidden = false;
        choices[0]?.focus();
        alert(`Для «${policy.querySelector('strong')?.textContent || 'JSON-параметра'}» выбери хотя бы один узел.`);
      }
    });
    sync();
  });
}

document.addEventListener('DOMContentLoaded', () => {
  syncHappGeoSourceFields();
  initHappHelpPanel();
  initJsonNodePolicies();
});


let lastProjectUpdateStatus = null;
let projectUpdatePollTimer = null;

function renderProjectUpdateStatus(payload) {
  if (!payload || !payload.updateStatus) return;
  const u = payload.updateStatus;
  lastProjectUpdateStatus = u;
  const remoteLine = document.getElementById('upd-remote-line');
  const archiveLine = document.getElementById('upd-archive-line');
  const errorLine = document.getElementById('upd-error-line');
  const notes = document.getElementById('upd-notes');
  const runtimeLine = document.getElementById('upd-runtime-line');
  const updateBtn = document.getElementById('project-update-btn');
  if (remoteLine) {
    if (u.remoteVersion) remoteLine.innerHTML = `GitHub version: <code>${escapeHtml(u.remoteVersion)}</code> · ${u.hasUpdate ? 'доступно обновление' : 'обновлений не найдено'}`;
    else if (u.remote) remoteLine.innerHTML = `GitHub commit: <code>${escapeHtml(u.remote)}</code> · ${u.hasUpdate ? 'доступно обновление' : 'обновлений не найдено'}`;
    else remoteLine.textContent = 'GitHub проверен, версия не получена.';
  }
  if (archiveLine) archiveLine.innerHTML = u.archiveUrl ? `Архив: <code>${escapeHtml(u.archiveUrl)}</code>` : '';
  if (errorLine) errorLine.textContent = u.error ? `Проверка GitHub не удалась: ${u.error}` : '';
  if (notes) notes.innerHTML = Array.isArray(u.notes) ? u.notes.map(n => `<li>${escapeHtml(n)}</li>`).join('') : '';
  if (runtimeLine && payload.runtimeStatus) runtimeLine.textContent = `Статус обновления: ${payload.runtimeStatus.message || payload.runtimeStatus.status || 'не запущено'}`;
  if (updateBtn) updateBtn.disabled = !u.archiveUrl;
}

function escapeHtml(value) {
  return String(value || '').replace(/[&<>'"]/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[ch]));
}

async function checkProjectUpdate(button) {
  const old = button ? button.textContent : '';
  if (button) { button.disabled = true; button.textContent = 'Проверяю...'; }
  try {
    const response = await fetch('/settings/project-update/status.json?check=1', { headers: { 'Accept': 'application/json' } });
    const payload = await response.json();
    if (!response.ok || payload.ok === false) throw new Error(payload.error || 'Ошибка проверки обновления');
    renderProjectUpdateStatus(payload);
    document.getElementById('project-update-card')?.scrollIntoView({ block: 'center' });
  } catch (err) {
    alert(String(err.message || err));
  } finally {
    if (button) { button.disabled = false; button.textContent = old || 'Проверить'; }
  }
}

async function startProjectUpdate(button) {
  if (!confirm('Запустить обновление проекта? Будет создан backup, скачан архив GitHub и выполнено обновление без изменения настроек.')) return;
  const modal = document.getElementById('project-update-modal');
  const card = modal && modal.querySelector('.project-update-progress-card');
  const text = document.getElementById('project-update-modal-text');
  const log = document.getElementById('project-update-log');
  const details = document.getElementById('project-update-log-details');
  if (modal) modal.style.display = 'flex';
  if (card) card.dataset.updateState = 'queued';
  if (text) text.textContent = 'Отправляю запрос на обновление...';
  if (log) log.textContent = '';
  if (details) { details.hidden = true; details.open = false; }
  if (button) button.disabled = true;
  try {
    const response = await fetch('/settings/project-update/start.json', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ archive_url: lastProjectUpdateStatus && lastProjectUpdateStatus.archiveUrl })
    });
    const payload = await response.json();
    if (!response.ok || payload.ok === false) throw new Error(payload.error || 'Ошибка запуска обновления');
    pollProjectUpdateStatus(true);
  } catch (err) {
    if (card) card.dataset.updateState = 'failed';
    if (text) text.textContent = 'Ошибка запуска обновления';
    if (log) log.textContent = String(err.message || err);
    if (details) details.hidden = false;
    if (button) button.disabled = false;
  }
}

async function pollProjectUpdateStatus(forceModal) {
  try {
    const response = await fetch('/settings/project-update/status.json', { headers: { 'Accept': 'application/json' } });
    const payload = await response.json();
    if (payload && payload.ok) renderProjectUpdateStatus(payload);
    const st = payload.runtimeStatus || {};
    const state = String(st.status || 'idle');
    const safeState = ['queued', 'downloading', 'installing', 'success', 'failed', 'error'].includes(state) ? state : 'queued';
    const text = document.getElementById('project-update-modal-text');
    const log = document.getElementById('project-update-log');
    const details = document.getElementById('project-update-log-details');
    const card = document.querySelector('#project-update-modal .project-update-progress-card');
    if (forceModal && document.getElementById('project-update-modal')) document.getElementById('project-update-modal').style.display = 'flex';
    if (card) card.dataset.updateState = safeState;
    if (text) text.textContent = st.message || state;
    if (log) log.textContent = [st.updatedAt || '', st.error || '', st.logTail || ''].filter(Boolean).join('\n');
    if (details) details.hidden = !(['failed', 'error'].includes(state) || Boolean(st.error));
    if (['success'].includes(state)) {
      clearTimeout(projectUpdatePollTimer);
      if (text) text.textContent = 'Обновление успешно произведено. Страница перезагрузится...';
      setTimeout(() => { window.location.href = '/dashboard?message=' + encodeURIComponent('Обновление успешно произведено'); }, 3000);
      return;
    }
    if (['failed', 'error'].includes(state)) {
      clearTimeout(projectUpdatePollTimer);
      if (text) text.textContent = st.message || 'Обновление не завершено. Открой технические сведения.';
      document.getElementById('project-update-btn')?.removeAttribute('disabled');
      return;
    }
  } catch (_) {}
  projectUpdatePollTimer = setTimeout(() => pollProjectUpdateStatus(false), 3000);
}

function closeProjectUpdateModal() {
  const modal = document.getElementById('project-update-modal');
  if (modal) modal.style.display = 'none';
}

async function restoreBackup() {
  const input = document.getElementById('backup-file');
  const button = document.getElementById('backup-restore-btn');
  const status = document.getElementById('backup-restore-status');
  const file = input && input.files && input.files[0];
  if (!file) return alert('Выбери файл резервной копии');
  if (!/\.json$/i.test(file.name || '')) {
    return alert('Через панель можно восстановить только JSON-бэкап. tar.gz из agg восстанавливается через SSH.');
  }
  if (!confirm('Восстановить резервную копию? Текущие данные будут заменены, а сессия будет сброшена.')) return;

  try {
    if (button) button.disabled = true;
    if (status) status.textContent = 'Читаю файл резервной копии...';
    const text = (await file.text()).replace(/^\uFEFF/, '').trim();
    if (!text) throw new Error('Файл резервной копии пустой');

    // Быстрая проверка на стороне браузера, чтобы сразу показать понятную ошибку.
    JSON.parse(text);

    if (status) status.textContent = 'Загружаю резервную копию в панель...';
    const response = await fetch('/backup/restore', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json; charset=utf-8' },
      body: text,
      credentials: 'same-origin'
    });

    if (response.redirected) {
      window.location.href = response.url;
      return;
    }

    if (!response.ok) {
      const errorText = await response.text();
      throw new Error(errorText || 'Ошибка восстановления резервной копии');
    }

    if (status) status.textContent = 'Резервная копия восстановлена. Перехожу на страницу входа...';
    window.location.href = '/login';
  } catch (err) {
    alert(String(err.message || err));
    if (status) status.textContent = 'Ошибка: ' + String(err.message || err);
    if (button) button.disabled = false;
  }
}
window.restoreBackup = restoreBackup;

function settingsTransferStatus(message) {
  const target = document.getElementById('settings-transfer-status');
  if (target) target.textContent = String(message || '');
}

async function exportSettingsTransfer(button) {
  const passphrase = document.getElementById('settings-transfer-export-passphrase')?.value || '';
  const confirmPassphrase = document.getElementById('settings-transfer-export-confirm')?.value || '';
  if (passphrase.length < 12) return alert('Парольная фраза должна содержать минимум 12 символов.');
  if (passphrase !== confirmPassphrase) return alert('Парольные фразы не совпадают.');
  try {
    if (button) button.disabled = true;
    settingsTransferStatus('Шифрую и собираю настройки…');
    const response = await fetch('/settings/transfer/export', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ passphrase })
    });
    if (!response.ok) {
      const error = await response.json().catch(() => ({}));
      throw new Error(error.error || 'Не удалось экспортировать настройки');
    }
    const blob = await response.blob();
    const disposition = response.headers.get('Content-Disposition') || '';
    const encodedName = disposition.match(/filename\*=UTF-8''([^;]+)/i)?.[1];
    const fileName = encodedName ? decodeURIComponent(encodedName) : 'nexus-settings.nxsettings';
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = fileName;
    document.body.appendChild(link);
    link.click();
    link.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
    settingsTransferStatus('Настройки экспортированы. Сохрани файл и парольную фразу отдельно.');
  } catch (err) {
    settingsTransferStatus('Ошибка: ' + String(err.message || err));
  } finally {
    if (button) button.disabled = false;
  }
}

function formatSettingsTransferResult(result) {
  const counts = result.inspection?.counts || result.counts || {};
  const lines = [result.message || 'Файл настроек проверен'];
  lines.push(`Настроек панели: ${counts.appSettings || result.settingsUpserted || 0}`);
  lines.push(`Узлов: ${counts.nodes ?? ((result.nodesCreated || 0) + (result.nodesUpdated || 0))}`);
  lines.push(`Кэшей inbound: ${counts.nodeInboundCache ?? result.inboundCachesUpserted ?? 0}`);
  lines.push(`Редиректов: ${counts.redirectRules ?? ((result.redirectRulesCreated || 0) + (result.redirectRulesUpdated || 0))}`);
  lines.push(`SNI-профилей: ${counts.sniProfiles ?? ((result.sniProfilesCreated || 0) + (result.sniProfilesUpdated || 0))}`);
  if (result.backupPath) lines.push(`Резервная копия: ${result.backupPath}`);
  if (Array.isArray(result.warnings) && result.warnings.length) lines.push('', 'Предупреждения:', ...result.warnings.map(item => '- ' + item));
  if (result.dryRun) lines.push('', 'База не изменена: выполнен полный rollback.');
  return lines.join('\n');
}

async function importSettingsTransfer(button, dryRun) {
  const file = document.getElementById('settings-transfer-file')?.files?.[0];
  const passphrase = document.getElementById('settings-transfer-import-passphrase')?.value || '';
  if (!file) return alert('Выбери файл .nxsettings.');
  if (passphrase.length < 12) return alert('Парольная фраза должна содержать минимум 12 символов.');
  if (file.size > 50 * 1024 * 1024) return alert('Файл больше 50 МБ — используй agg settings import через SSH.');
  if (!dryRun && !confirm('Импортировать настройки? Клиенты и доступ администратора не изменятся; перед записью будет создан backup.')) return;
  try {
    if (button) button.disabled = true;
    settingsTransferStatus(dryRun ? 'Проверяю пакет без записи…' : 'Импортирую и перешифровываю секреты…');
    const bundle = await file.text();
    const response = await fetch('/settings/transfer/import', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ passphrase, bundle, dryRun })
    });
    const result = await response.json().catch(() => ({}));
    if (!response.ok || !result.ok) throw new Error(result.error || 'Операция настроек не выполнена');
    settingsTransferStatus(formatSettingsTransferResult(result));
    if (!dryRun) settingsTransferStatus(formatSettingsTransferResult(result) + '\n\nПерезапусти контейнер: cd /opt/3xui-aggregator && docker compose restart aggregator');
  } catch (err) {
    settingsTransferStatus('Ошибка: ' + String(err.message || err));
  } finally {
    if (button) button.disabled = false;
  }
}
window.exportSettingsTransfer = exportSettingsTransfer;
window.importSettingsTransfer = importSettingsTransfer;
</script>
<%- include('partials_footer') %>
