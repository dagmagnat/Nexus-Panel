<%
  const interfaceTheme = typeof panelInterfaceTheme === 'undefined' ? '' : panelInterfaceTheme;
  const graphiteTheme = interfaceTheme === 'graphite_blue';
  const coreuiTheme = interfaceTheme === 'coreui';
-%>
<!doctype html>
<html lang="ru"<% if (graphiteTheme) { %> data-interface-theme="graphite-blue"<% } else if (coreuiTheme) { %> data-interface-theme="coreui"<% } %>>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="nexus-workspace" content="<%= typeof workspaceId !== 'undefined' ? workspaceId : 'main' %>">
  <meta name="theme-color" content="<%= coreuiTheme ? '#edf0f5' : graphiteTheme ? '#15191f' : '#070b17' %>">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Nexus Panel' %> — Nexus Panel</title>
  <link rel="icon" type="image/png" sizes="16x16" href="/img/nexus-panel-tab-16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/img/nexus-panel-tab-32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3">
  <link rel="manifest" href="/site.webmanifest?v=272">
  <script>
  (function(){
    const { dataset } = document.documentElement;
    let mode = dataset.interfaceTheme === 'coreui' ? 'light' : 'dark';
    if (dataset.interfaceTheme !== 'graphite-blue') {
      try {
        const key = dataset.interfaceTheme === 'coreui' ? 'nexus.coreui.color-mode' : 'agg.color-theme.v1';
        const saved = localStorage.getItem(key);
        if (saved === 'light' || saved === 'dark') mode = saved;
      } catch (_) {}
    }
    dataset.colorMode = mode;
    dataset.colorTheme = mode;
  })();
  (function(){
    document.documentElement.classList.add('ui-order-preload');
    try {
      const page = <%- JSON.stringify(typeof activePage !== 'undefined' ? activePage : 'app') %>;
      const saved = JSON.parse(localStorage.getItem('agg.order.tabs.' + page + '.v1') || '[]');
      if (Array.isArray(saved) && saved[0]) document.documentElement.dataset.initialPageTab = String(saved[0]);
      const settings = JSON.parse(localStorage.getItem('agg.order.settings.tabs.v1') || '[]');
      if (Array.isArray(settings) && settings[0]) document.documentElement.dataset.initialSettingsTab = String(settings[0]);
    } catch (_) {}
  })();
  </script>
  <link rel="stylesheet" href="/css/spectrum-clear.css?v=277-20261121-node-visibility" />
  <link rel="stylesheet" href="/css/management-layout.css?v=1" />
  <script src="/js/management-layout.js?v=1" defer></script>
  <script src="/js/security.js?v=3"></script>
  <% if (graphiteTheme) { %><link rel="stylesheet" href="/css/graphite-blue.css?v=1" /><% } %>
  <% if (coreuiTheme) { %><link rel="stylesheet" href="/css/coreui.css?v=7" /><script src="/js/coreui-layout.js?v=1" defer></script><% } %>
  <link rel="stylesheet" href="/css/mobile-refinements.css?v=2.7.47" />
  <% if (typeof isDevelopment !== 'undefined' && isDevelopment) { %><script src="/js/dev-inspector.js?v=1" defer></script><% } %>
</head>
<%
  const NEXUS_ICONS = {
    dashboard: '<rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/>',
    nodes: '<rect x="3" y="4" width="18" height="6" rx="2"/><rect x="3" y="14" width="18" height="6" rx="2"/><path d="M7 7h.01M7 17h.01M11 7h7M11 17h7"/>',
    clients: '<circle cx="9" cy="8" r="3.2"/><path d="M3.5 20c.6-3.3 2.7-5 5.5-5s4.9 1.7 5.5 5M16 6.2a3 3 0 0 1 0 5.6M17 15.3c2 .8 3.2 2.4 3.5 4.7"/>',
    routing: '<circle cx="6" cy="18" r="2.4"/><circle cx="18" cy="6" r="2.4"/><path d="m8 16 8-8M6 6h6M6 6v6"/>',
    diagnostics: '<path d="M3 12h4l2.5 6L14 6l2.5 6H21"/>',
    telegram: '<path d="m21 3-7 18-3.7-7.4L3 10l18-7Z"/><path d="M10.3 13.6 21 3"/>',
    settings: '<path d="M20 7h-7.5M7.5 7H4M20 17h-3.5M11.5 17H4"/><circle cx="10" cy="7" r="2.5"/><circle cx="14" cy="17" r="2.5"/>',
    more: '<circle cx="5" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="19" cy="12" r="1.5"/>',
    moon: '<path d="M20 14a8 8 0 1 1-10-10 6.5 6.5 0 0 0 10 10Z"/>',
    sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
    logout: '<path d="M9 21H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3m6 13 4-4-4-4m4 4H9"/>',
    billing: '<rect x="3.5" y="6" width="17" height="12" rx="2"/><path d="M4 10h16M7 14.5h3"/>',
    access: '<path d="M12 3 5 6v5c0 4 2.8 7.7 7 10 4.2-2.3 7-6 7-10V6l-7-3Z"/><path d="m9.4 12 1.6 1.7 3.6-3.7"/>',
    preferences: '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 9h8M8 15h8"/><circle cx="10" cy="9" r="1.5"/><circle cx="14" cy="15" r="1.5"/>',
    search: '<circle cx="10.5" cy="10.5" r="5.8"/><path d="m15 15 4 4"/>',
    menu: '<path d="M4 7h16M4 12h16M4 17h16"/>'
  };
  function nexusIcon(name, cls) {
    return '<svg class="nexus-icon' + (cls ? ' ' + cls : '') + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + (NEXUS_ICONS[name] || '') + '</svg>';
  }
  const currentPath = typeof activePage !== 'undefined' ? activePage : '';
  const moreNavActive = ['more', 'appearance', 'subscription-billing', 'settings', 'access', 'preferences', 'diagnostics', 'telegram_bot', 'nexus_nodes'].includes(currentPath);
  const sectionLabels = {
    dashboard: 'Обзор', nodes: 'Инфраструктура', clients: 'Доступ',
    routing: 'Сеть', diagnostics: 'Обзор', telegram_bot: 'Интеграции',
    settings: 'Система', access: 'Система', preferences: 'Система', nexus_nodes: 'Инфраструктура', more: 'Nexus Panel'
  };
%>
<body class="nexus-spectrum theme-classic<%= typeof panelMobileClientCompact !== 'undefined' && panelMobileClientCompact ? ' mobile-client-compact' : '' %> page-<%= currentPath || 'app' %> clients-view-<%= typeof clientsViewMode !== 'undefined' ? clientsViewMode : 'modern' %> mobile-nav-<%= typeof panelMobileNavMode !== 'undefined' ? panelMobileNavMode : 'bottom' %> mobile-size-<%= typeof panelMobileUiScale !== 'undefined' ? panelMobileUiScale : 'compact' %>">
  <div class="spectrum-mobilebar">
    <button class="mobile-menu-toggle spectrum-icon-button" type="button" aria-label="Открыть меню" aria-controls="panelSidebar" aria-expanded="false"><%- nexusIcon('menu') %></button>
    <a class="spectrum-mobile-brand" href="/dashboard"><img src="/img/nexus-panel-mark.png" alt=""><span style="display:flex;flex-direction:column;min-width:0">Nexus</span></a>
    <div class="spectrum-mobile-title"><strong><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Панель' %></strong></div>
    <button type="button" class="theme-toggle spectrum-icon-button" data-theme-toggle aria-label="Переключить тему"><span data-theme-icon><%- nexusIcon('moon', 'theme-moon') %><%- nexusIcon('sun', 'theme-sun') %></span></button>
  </div>
  <div class="mobile-sidebar-backdrop" data-close-mobile-menu></div>

  <div class="spectrum-shell layout">
    <aside class="spectrum-sidebar sidebar" id="panelSidebar">
      <a class="spectrum-brand brand" href="/dashboard" aria-label="Nexus Panel — главная">
        <img src="/img/nexus-panel-mark.png" width="40" height="40" alt="">
        <span class="spectrum-brand-copy brand-text"><strong>Nexus Panel</strong></span>
      </a>

      <nav class="spectrum-nav side-nav" aria-label="Основная навигация">
        <div class="spectrum-nav-group">
          <span class="spectrum-nav-label">Основное</span>
          <a href="/dashboard" class="<%= currentPath === 'dashboard' ? 'active' : '' %>"><span class="nav-icon"><%- nexusIcon('dashboard') %></span><span>Дашборд</span></a>
          <a href="/nodes" class="<%= currentPath === 'nodes' ? 'active' : '' %>"><span class="nav-icon"><%- nexusIcon('nodes') %></span><span>Узлы</span></a>
          <% if (typeof nexusNodeEnabled !== 'undefined' && nexusNodeEnabled) { %><a href="/nexus-nodes" class="<%= currentPath === 'nexus_nodes' ? 'active' : '' %>"><span class="nav-icon"><%- nexusIcon('nodes') %></span><span>Nexus Node · эксперимент</span></a><% } %>
          <a href="/clients" class="<%= currentPath === 'clients' ? 'active' : '' %>"><span class="nav-icon"><%- nexusIcon('clients') %></span><span>Пользователи</span></a>
          <a href="/diagnostics" class="<%= currentPath === 'diagnostics' ? 'active' : '' %>"><span class="nav-icon"><%- nexusIcon('diagnostics') %></span><span>Диагностика</span></a>
        </div>
        <div class="spectrum-nav-group">
          <% if (coreuiTheme) { %><button type="button" class="coreui-group-toggle" data-coreui-group-toggle aria-expanded="true"><span>Сеть</span><span aria-hidden="true">⌄</span></button><% } else { %><span class="spectrum-nav-label">Сеть</span><% } %>
          <a href="/routing" class="<%= currentPath === 'routing' ? 'active' : '' %>"><span class="nav-icon"><%- nexusIcon('routing') %></span><span>Маршрутизация</span></a>
        </div>
        <div class="spectrum-nav-group">
          <% if (coreuiTheme) { %><button type="button" class="coreui-group-toggle" data-coreui-group-toggle aria-expanded="true"><span>Система</span><span aria-hidden="true">⌄</span></button><% } else { %><span class="spectrum-nav-label">Система</span><% } %>
          <a href="/telegram-bot" class="<%= currentPath === 'telegram_bot' ? 'active' : '' %>"><span class="nav-icon"><%- nexusIcon('telegram') %></span><span>Telegram</span></a>
          <a href="/subscription-billing" class="<%= currentPath === 'subscription-billing' ? 'active' : '' %>"><span class="nav-icon"><%- nexusIcon(coreuiTheme ? 'billing' : 'settings') %></span><span>Оплата</span></a>
          <% if (canOpenPanelSettings) { %>
          <a href="/settings" class="<%= ['settings','access','preferences'].includes(currentPath) ? 'active' : '' %>"><span class="nav-icon"><%- nexusIcon('settings') %></span><span>Настройки</span></a>
          <% } else { %>
          <a href="/access" class="<%= currentPath === 'access' ? 'active' : '' %>" <%- currentPath === 'access' ? 'aria-current="page"' : '' %>><span class="nav-icon"><%- nexusIcon(coreuiTheme ? 'access' : 'clients') %></span><span>Пользователи и доступ</span></a>
          <% if (canOpenPreferences) { %>
          <a href="/preferences" class="<%= currentPath === 'preferences' ? 'active' : '' %>" <%- currentPath === 'preferences' ? 'aria-current="page"' : '' %>><span class="nav-icon"><%- nexusIcon(coreuiTheme ? 'preferences' : 'settings') %></span><span>Профиль настроек</span></a>
          <% } %>
          <% } %>
        </div>
      </nav>

      <div class="spectrum-sidebar-footer">
        <button type="button" class="sidebar-order-button spectrum-order-button" data-open-order-modal>Настроить порядок</button>
        <div class="sidebar-user-card spectrum-user-card">
          <div class="sidebar-user-avatar"><%= String(typeof currentAdminUsername !== 'undefined' && currentAdminUsername ? currentAdminUsername : 'A').slice(0,1).toUpperCase() %></div>
          <a class="sidebar-user-meta" href="/preferences/appearance" title="Оформление аккаунта"><strong><%= typeof currentAdminUsername !== 'undefined' && currentAdminUsername ? currentAdminUsername : 'admin' %></strong><small>Панель управления</small></a>
          <form class="logout-form sidebar-logout" method="post" action="/logout"><button type="submit" class="spectrum-icon-button" title="Выйти"><%- nexusIcon('logout') %></button></form>
        </div>
      </div>
    </aside>

    <main class="spectrum-main main <%= typeof hidePageHeader !== 'undefined' && hidePageHeader ? 'main-compact-header' : '' %>">
      <% if (coreuiTheme) { %>
        <%- include('coreui_topbar', { icon: nexusIcon, username: typeof currentAdminUsername !== 'undefined' && currentAdminUsername ? currentAdminUsername : 'admin' }) %>
      <% } else { %>
      <header class="spectrum-pagebar topbar">
        <div class="spectrum-page-heading page-intro">
          <span class="spectrum-eyebrow"><%= sectionLabels[currentPath] || 'Nexus Panel' %></span>
          <h1><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Nexus Panel' %></h1>
          <% if (typeof pageSubtitle !== 'undefined' && pageSubtitle) { %><p class="subtitle"><%= pageSubtitle %></p><% } %>
        </div>
        <div class="spectrum-page-actions">
          <button type="button" class="theme-toggle spectrum-theme-button" data-theme-toggle aria-label="Переключить тему"><span data-theme-icon><%- nexusIcon('moon', 'theme-moon') %><%- nexusIcon('sun', 'theme-sun') %></span><span class="theme-label">Тема</span></button>
        </div>
      </header>
      <% } %>
      <div class="spectrum-page-content">
        <% if (coreuiTheme) { %>
          <div class="coreui-page-title">
            <h1><%= typeof pageTitle !== "undefined" ? pageTitle : "Nexus Panel" %></h1>
            <nav aria-label="Путь"><a href="/dashboard">Панель</a><span aria-hidden="true">/</span><span aria-current="page"><%= typeof pageTitle !== "undefined" ? pageTitle : "Nexus Panel" %></span></nav>
          </div>
        <% } %>

  <nav class="mobile-bottom-nav spectrum-bottom-nav" aria-label="Быстрая навигация">
    <a href="/dashboard" class="<%= currentPath === 'dashboard' ? 'active' : '' %>"><span class="bn-ico"><%- nexusIcon('dashboard') %></span><em>Главная</em></a>
    <a href="/clients" class="<%= currentPath === 'clients' ? 'active' : '' %>"><span class="bn-ico"><%- nexusIcon('clients') %></span><em>Пользователи</em></a>
    <a href="/nodes" class="<%= currentPath === 'nodes' ? 'active' : '' %>"><span class="bn-ico"><%- nexusIcon('nodes') %></span><em>Узлы</em></a>
    <a href="/routing" class="<%= currentPath === 'routing' ? 'active' : '' %>"><span class="bn-ico"><%- nexusIcon('routing') %></span><em>Маршруты</em></a>
    <a href="/more" class="<%= moreNavActive ? 'active' : '' %>"><span class="bn-ico"><%- nexusIcon('more') %></span><em>Ещё</em></a>
  </nav>
