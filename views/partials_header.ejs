<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="theme-color" content="#07173a">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Nexus Panel' %> — Nexus Panel</title>
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="192x192" href="/img/nexus-logo-192.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <script>
  (function(){
    try {
      const saved = localStorage.getItem('agg.color-theme.v1');
      const mode = saved === 'dark' ? 'dark' : 'light';
      document.documentElement.dataset.colorMode = mode;
      document.documentElement.dataset.colorTheme = mode;
    } catch (_) {
      document.documentElement.dataset.colorMode = 'light';
      document.documentElement.dataset.colorTheme = 'light';
    }
  })();
  (function(){
    // Не показываем старую первую вкладку до применения сохранённого порядка.
    document.documentElement.classList.add('ui-order-preload');
    try {
      const page = <%- JSON.stringify(typeof activePage !== 'undefined' ? activePage : 'app') %>;
      const key = 'agg.order.tabs.' + page + '.v1';
      const saved = JSON.parse(localStorage.getItem(key) || '[]');
      if (Array.isArray(saved) && saved[0]) document.documentElement.dataset.initialPageTab = String(saved[0]);
      const settings = JSON.parse(localStorage.getItem('agg.order.settings.tabs.v1') || '[]');
      if (Array.isArray(settings) && settings[0]) document.documentElement.dataset.initialSettingsTab = String(settings[0]);
    } catch (_) {}
  })();
  </script>
  <link rel="stylesheet" href="/css/style.css?v=171" />
  <link rel="stylesheet" href="/css/redesign.css?v=187" />
  <link rel="stylesheet" href="/css/stage87.css?v=4" />
  <link rel="stylesheet" href="/css/stage90.css?v=4" />
  <link rel="stylesheet" href="/css/stage91.css?v=1" />
  <link rel="stylesheet" href="/css/stage92.css?v=3" />
  <link rel="stylesheet" href="/css/stage94.css?v=1" />
  <link rel="stylesheet" href="/css/stage95.css?v=2" />
  <link rel="stylesheet" href="/css/stage97.css?v=1" />
  <link rel="stylesheet" href="/css/stage98.css?v=1" />
  <link rel="stylesheet" href="/css/stage102.css?v=1" />
  <link rel="stylesheet" href="/css/stage103.css?v=1" />
  <link rel="stylesheet" href="/css/nexus-ui.css?v=2" />
  <link rel="stylesheet" href="/css/branding.css?v=1" />
  <script src="/js/security.js?v=1"></script>
  <script>
    // Мобильное меню (drawer) — переключение
    (function() {
      document.addEventListener('click', function(e) {
        const toggle = e.target.closest('.mobile-menu-toggle');
        const backdrop = document.querySelector('.mobile-sidebar-backdrop');
        const sidebar = document.getElementById('panelSidebar');
        if (toggle) {
          document.body.classList.toggle('mobile-menu-open');
          toggle.setAttribute('aria-expanded', document.body.classList.contains('mobile-menu-open'));
          return;
        }
        if (backdrop && document.body.classList.contains('mobile-menu-open')) {
          document.body.classList.remove('mobile-menu-open');
          const t = document.querySelector('.mobile-menu-toggle');
          if (t) t.setAttribute('aria-expanded', 'false');
          return;
        }
        if (sidebar && sidebar.contains(e.target) && e.target.tagName === 'A') {
          document.body.classList.remove('mobile-menu-open');
          const t = document.querySelector('.mobile-menu-toggle');
          if (t) t.setAttribute('aria-expanded', 'false');
        }
      });
    })();
  </script>
  <% if (typeof isDevelopment !== 'undefined' && isDevelopment) { %><script src="/js/dev-inspector.js?v=1" defer></script><% } %>
</head>
<%
  const AGG_ICONS = {
    dashboard: '<rect x="3" y="3" width="7.2" height="7.2" rx="1.6"/><rect x="13.8" y="3" width="7.2" height="7.2" rx="1.6"/><rect x="3" y="13.8" width="7.2" height="7.2" rx="1.6"/><rect x="13.8" y="13.8" width="7.2" height="7.2" rx="1.6"/>',
    nodes: '<rect x="3" y="4" width="18" height="6.6" rx="2"/><rect x="3" y="13.4" width="18" height="6.6" rx="2"/><path d="M6.8 7.3h.01M6.8 16.7h.01"/>',
    clients: '<circle cx="9" cy="7.8" r="3.3"/><path d="M3.4 20c.6-3.3 2.9-5.1 5.6-5.1s5 1.8 5.6 5.1"/><path d="M15.4 5.4a3.3 3.3 0 0 1 0 4.8M17.6 15.3c1.7.9 2.7 2.5 3 4.7"/>',
    vpn: '<path d="M12 3l7 2.7v5.4c0 4.7-3 7.9-7 9.9-4-2-7-5.2-7-9.9V5.7L12 3z"/><rect x="9.6" y="10.6" width="4.8" height="4" rx="1"/><path d="M10.8 10.6V9.4a1.2 1.2 0 0 1 2.4 0v1.2"/>',
    routing: '<circle cx="6" cy="18" r="2.6"/><circle cx="18" cy="6" r="2.6"/><path d="M8.2 15.8 15.8 8.2"/>',
    redirects: '<path d="M18 8H5"/><path d="M8 5 5 8l3 3"/><path d="M6 16h13"/><path d="m16 13 3 3-3 3"/>',
    diagnostics: '<path d="M3 12h4l2.5 6L14 6l2.5 6H21"/>',
    telegram: '<path d="M21 3 10.4 13.6"/><path d="M21 3 14 21l-3.6-7.4L3 10z"/>',
    settings: '<path d="M20 7h-7.6M7.6 7H4"/><circle cx="10" cy="7" r="2.4"/><path d="M20 17h-3.6M11.6 17H4"/><circle cx="14" cy="17" r="2.4"/>',
    more: '<circle cx="5" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="19" cy="12" r="1.5"/>',
    shield: '<path d="M12 2.6 20 5.7v6c0 5.2-3.4 8.8-8 11-4.6-2.2-8-5.8-8-11v-6L12 2.6z"/><path d="m8.8 11.8 2.3 2.3 4.3-4.6"/>',
    moon: '<path d="M20 13.6A8 8 0 1 1 10.4 4 6.4 6.4 0 0 0 20 13.6z"/>',
    sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2.6v2M12 19.4v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2.6 12h2M19.4 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
    logout: '<path d="M9 21H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3"/><path d="m15 16 4-4-4-4"/><path d="M19 12H9"/>'
  };
  function aggIcon(name, cls) {
    const body = AGG_ICONS[name] || '';
    return '<svg class="agg-ico' + (cls ? ' ' + cls : '') + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + body + '</svg>';
  }
%>
<body data-redesign="stage87-ui-polish-light-mobile" class="redesign-stage52 <%= typeof panelInterfaceTheme !== 'undefined' && panelInterfaceTheme === 'mobile_lite' ? 'theme-classic mobile-lite-auto' : 'theme-classic' %> <%= typeof panelMobileClientCompact !== 'undefined' && panelMobileClientCompact ? 'mobile-client-compact' : '' %> clients-view-<%= typeof clientsViewMode !== 'undefined' ? clientsViewMode : 'modern' %> page-<%= typeof activePage !== 'undefined' ? activePage : 'app' %> mobile-nav-<%= typeof panelMobileNavMode !== 'undefined' ? panelMobileNavMode : 'bottom' %> mobile-size-<%= typeof panelMobileUiScale !== 'undefined' ? panelMobileUiScale : 'compact' %>">
  <% const currentPath = typeof activePage !== 'undefined' ? activePage : ''; %>
  <% const moreNavActive = ['more', 'settings', 'redirects', 'diagnostics', 'telegram_bot', 'vpn'].includes(currentPath); %>
  <div class="mobile-shellbar">
    <button class="mobile-menu-toggle" type="button" aria-label="Открыть меню" aria-controls="panelSidebar" aria-expanded="false">☰</button>
    <img class="mobile-brand-logo" src="/img/nexus-logo-192.png" alt="" aria-hidden="true">
    <div class="mobile-shell-title"><strong><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Панель' %></strong><span><%= typeof pageSubtitle !== 'undefined' && pageSubtitle ? pageSubtitle : '' %></span></div>
    <button type="button" class="theme-toggle theme-toggle-mobile" data-theme-toggle aria-label="Переключить тему" title="Тема: тёмная"><span data-theme-icon><%- aggIcon('moon', 'agg-ico-moon') %><%- aggIcon('sun', 'agg-ico-sun') %></span></button>
  </div>
  <div class="mobile-sidebar-backdrop" data-close-mobile-menu></div>
  <nav class="mobile-bottom-nav stage11-bottom-nav" aria-label="Быстрая навигация">
    <a href="/dashboard" class="<%= currentPath === 'dashboard' ? 'active' : '' %>"><span class="bn-ico"><%- aggIcon('dashboard') %></span><em>Дашборд</em></a>
    <a href="/clients" class="<%= currentPath === 'clients' ? 'active' : '' %>"><span class="bn-ico"><%- aggIcon('clients') %></span><em>Клиенты</em></a>
    <a href="/nodes" class="<%= currentPath === 'nodes' ? 'active' : '' %>"><span class="bn-ico"><%- aggIcon('nodes') %></span><em>Узлы</em></a>
    <a href="/routing" class="<%= currentPath === 'routing' ? 'active' : '' %>"><span class="bn-ico"><%- aggIcon('routing') %></span><em>Маршрут</em></a>
    <a href="/more" class="<%= moreNavActive ? 'active' : '' %>"><span class="bn-ico"><%- aggIcon('more') %></span><em>Ещё</em></a>
  </nav>
  <div class="layout">
    <aside class="sidebar" id="panelSidebar">
      <div class="brand desktop-modern-brand">
        <span class="brand-shield"><img src="/img/nexus-logo-192.png" alt="Логотип Nexus Panel"></span>
        <span class="brand-text"><strong>Nexus Panel</strong><small>Network control center</small></span>
        <button type="button" class="theme-toggle" data-theme-toggle aria-label="Переключить тему" title="Тема: тёмная"><span data-theme-icon><%- aggIcon('moon', 'agg-ico-moon') %><%- aggIcon('sun', 'agg-ico-sun') %></span></button>
      </div>
      <nav class="side-nav desktop-modern-nav">
        <a href="/dashboard" class="<%= currentPath === 'dashboard' ? 'active' : '' %>"><span class="nav-icon"><%- aggIcon('dashboard') %></span><span>Дашборд</span></a>
        <a href="/nodes" class="<%= currentPath === 'nodes' ? 'active' : '' %>"><span class="nav-icon"><%- aggIcon('nodes') %></span><span>Узлы</span></a>
        <a href="/clients" class="<%= currentPath === 'clients' ? 'active' : '' %>"><span class="nav-icon"><%- aggIcon('clients') %></span><span>Клиенты</span></a>
        <a href="/vpn" class="<%= currentPath === 'vpn' ? 'active' : '' %>"><span class="nav-icon"><%- aggIcon('vpn') %></span><span>VPN-сервисы</span></a>
        <a href="/routing" class="<%= currentPath === 'routing' ? 'active' : '' %>"><span class="nav-icon"><%- aggIcon('routing') %></span><span>Маршрутизация</span></a>
        <a href="/redirects" class="<%= currentPath === 'redirects' ? 'active' : '' %>"><span class="nav-icon"><%- aggIcon('redirects') %></span><span>Перенаправление</span></a>
        <a href="/diagnostics" class="<%= currentPath === 'diagnostics' ? 'active' : '' %>"><span class="nav-icon"><%- aggIcon('diagnostics') %></span><span>Диагностика</span></a>
        <a href="/telegram-bot" class="<%= currentPath === 'telegram_bot' ? 'active' : '' %>"><span class="nav-icon"><%- aggIcon('telegram') %></span><span>TG-бот</span></a>
        <a href="/settings" class="<%= currentPath === 'settings' ? 'active' : '' %>"><span class="nav-icon"><%- aggIcon('settings') %></span><span>Настройки</span></a>
      </nav>

      <button type="button" class="sidebar-order-button" data-open-order-modal>↕ Настроить порядок</button>

      <div class="sidebar-user-card" aria-label="Текущий пользователь">
        <div class="sidebar-user-avatar">◎</div>
        <div class="sidebar-user-meta">
          <strong><%= typeof currentAdminUsername !== 'undefined' && currentAdminUsername ? currentAdminUsername : 'admin' %></strong>
          <small>Администратор</small>
        </div>
      </div>
      <form class="logout-form sidebar-logout" method="post" action="/logout">
        <button type="submit"><span class="logout-icon"><%- aggIcon('logout') %></span> Выйти</button>
      </form>
    </aside>

    <main class="main <%= typeof hidePageHeader !== 'undefined' && hidePageHeader ? 'main-compact-header' : '' %>">
      <% if (!(typeof hidePageHeader !== 'undefined' && hidePageHeader)) { %>
        <div class="topbar">
          <div class="page-intro">
            <h1><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Nexus Panel' %></h1>
            <% if (typeof pageSubtitle !== 'undefined' && pageSubtitle) { %>
              <div class="subtitle"><%= pageSubtitle %></div>
            <% } %>
          </div>
        </div>
      <% } %>
