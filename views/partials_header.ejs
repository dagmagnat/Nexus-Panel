<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="theme-color" content="#070b17">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Nexus Panel' %> — Nexus Panel</title>
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="192x192" href="/img/nexus-logo-192.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest?v=210">
  <script>
  (function(){
    try {
      const saved = localStorage.getItem('agg.color-theme.v1');
      const mode = saved === 'light' ? 'light' : 'dark';
      document.documentElement.dataset.colorMode = mode;
      document.documentElement.dataset.colorTheme = mode;
    } catch (_) {
      document.documentElement.dataset.colorMode = 'dark';
      document.documentElement.dataset.colorTheme = 'dark';
    }
  })();
  (function(){
    document.documentElement.classList.add('ui-order-preload');
    try {
      const page = <%- JSON.stringify(typeof activePage !== 'undefined' ? activePage : 'app') %>;
      const saved = JSON.parse(localStorage.getItem('agg.order.tabs.' + page + '.v1') || '[]');
      if (Array.isArray(saved) && saved[0]) document.documentElement.dataset.initialPageTab = String(saved[0]);
      const settings = JSON.parse(localStorage.getItem('agg.order.settings.tabs.v1') || '[]');
      if (Array.isArray(settings) && settings[0]) document.documentElement.dataset.initialSettingsTab = String(settings[0]);
    } catch (_) {}
  })();
  </script>
  <link rel="stylesheet" href="/css/spectrum-clear.css?v=210" />
  <script src="/js/security.js?v=1"></script>
  <% if (typeof isDevelopment !== 'undefined' && isDevelopment) { %><script src="/js/dev-inspector.js?v=1" defer></script><% } %>
</head>
<%
  const NEXUS_ICONS = {
    dashboard: '<rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/>',
    nodes: '<rect x="3" y="4" width="18" height="6" rx="2"/><rect x="3" y="14" width="18" height="6" rx="2"/><path d="M7 7h.01M7 17h.01M11 7h7M11 17h7"/>',
    clients: '<circle cx="9" cy="8" r="3.2"/><path d="M3.5 20c.6-3.3 2.7-5 5.5-5s4.9 1.7 5.5 5M16 6.2a3 3 0 0 1 0 5.6M17 15.3c2 .8 3.2 2.4 3.5 4.7"/>',
    routing: '<circle cx="6" cy="18" r="2.4"/><circle cx="18" cy="6" r="2.4"/><path d="m8 16 8-8M6 6h6M6 6v6"/>',
    redirects: '<path d="M18 8H5m3-3L5 8l3 3M6 16h13m-3-3 3 3-3 3"/>',
    diagnostics: '<path d="M3 12h4l2.5 6L14 6l2.5 6H21"/>',
    telegram: '<path d="m21 3-7 18-3.7-7.4L3 10l18-7Z"/><path d="M10.3 13.6 21 3"/>',
    settings: '<path d="M20 7h-7.5M7.5 7H4M20 17h-3.5M11.5 17H4"/><circle cx="10" cy="7" r="2.5"/><circle cx="14" cy="17" r="2.5"/>',
    more: '<circle cx="5" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="19" cy="12" r="1.5"/>',
    moon: '<path d="M20 14a8 8 0 1 1-10-10 6.5 6.5 0 0 0 10 10Z"/>',
    sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
    logout: '<path d="M9 21H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3m6 13 4-4-4-4m4 4H9"/>',
    menu: '<path d="M4 7h16M4 12h16M4 17h16"/>'
  };
  function nexusIcon(name, cls) {
    return '<svg class="nexus-icon' + (cls ? ' ' + cls : '') + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + (NEXUS_ICONS[name] || '') + '</svg>';
  }
  const currentPath = typeof activePage !== 'undefined' ? activePage : '';
  const moreNavActive = ['more', 'settings', 'redirects', 'diagnostics', 'telegram_bot'].includes(currentPath);
  const sectionLabels = {
    dashboard: 'Обзор', nodes: 'Инфраструктура', clients: 'Доступ',
    routing: 'Сеть', redirects: 'Сеть', diagnostics: 'Система', telegram_bot: 'Интеграции',
    settings: 'Система', more: 'Nexus Panel'
  };
%>
<body class="nexus-spectrum theme-classic page-<%= currentPath || 'app' %> clients-view-<%= typeof clientsViewMode !== 'undefined' ? clientsViewMode : 'modern' %> mobile-nav-<%= typeof panelMobileNavMode !== 'undefined' ? panelMobileNavMode : 'bottom' %> mobile-size-<%= typeof panelMobileUiScale !== 'undefined' ? panelMobileUiScale : 'compact' %>">
  <div class="spectrum-mobilebar">
    <button class="mobile-menu-toggle spectrum-icon-button" type="button" aria-label="Открыть меню" aria-controls="panelSidebar" aria-expanded="false"><%- nexusIcon('menu') %></button>
    <a class="spectrum-mobile-brand" href="/dashboard"><img src="/img/nexus-logo-192.png" alt=""><span>Nexus</span></a>
    <div class="spectrum-mobile-title"><strong><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Панель' %></strong></div>
    <button type="button" class="theme-toggle spectrum-icon-button" data-theme-toggle aria-label="Переключить тему"><span data-theme-icon><%- nexusIcon('moon', 'theme-moon') %><%- nexusIcon('sun', 'theme-sun') %></span></button>
  </div>
  <div class="mobile-sidebar-backdrop" data-close-mobile-menu></div>

  <div class="spectrum-shell layout">
    <aside class="spectrum-sidebar sidebar" id="panelSidebar">
      <a class="spectrum-brand brand" href="/dashboard" aria-label="Nexus Panel — главная">
        <span class="spectrum-brand-mark brand-shield"><img src="/img/nexus-logo-192.png" alt=""></span>
        <span class="spectrum-brand-copy brand-text"><strong>Nexus Panel</strong><small>Spectrum Clear</small></span>
      </a>

      <nav class="spectrum-nav side-nav" aria-label="Основная навигация">
        <div class="spectrum-nav-group">
          <span class="spectrum-nav-label">Основное</span>
          <a href="/dashboard" class="<%= currentPath === 'dashboard' ? 'active' : '' %>"><span class="nav-icon"><%- nexusIcon('dashboard') %></span><span>Дашборд</span></a>
          <a href="/nodes" class="<%= currentPath === 'nodes' ? 'active' : '' %>"><span class="nav-icon"><%- nexusIcon('nodes') %></span><span>Узлы</span></a>
          <a href="/clients" class="<%= currentPath === 'clients' ? 'active' : '' %>"><span class="nav-icon"><%- nexusIcon('clients') %></span><span>Клиенты</span></a>
        </div>
        <div class="spectrum-nav-group">
          <span class="spectrum-nav-label">Сеть</span>
          <a href="/routing" class="<%= currentPath === 'routing' ? 'active' : '' %>"><span class="nav-icon"><%- nexusIcon('routing') %></span><span>Маршрутизация</span></a>
          <a href="/redirects" class="<%= currentPath === 'redirects' ? 'active' : '' %>"><span class="nav-icon"><%- nexusIcon('redirects') %></span><span>Перенаправление</span></a>
        </div>
        <div class="spectrum-nav-group">
          <span class="spectrum-nav-label">Система</span>
          <a href="/diagnostics" class="<%= currentPath === 'diagnostics' ? 'active' : '' %>"><span class="nav-icon"><%- nexusIcon('diagnostics') %></span><span>Диагностика</span></a>
          <a href="/telegram-bot" class="<%= currentPath === 'telegram_bot' ? 'active' : '' %>"><span class="nav-icon"><%- nexusIcon('telegram') %></span><span>Telegram</span></a>
          <a href="/settings" class="<%= currentPath === 'settings' ? 'active' : '' %>"><span class="nav-icon"><%- nexusIcon('settings') %></span><span>Настройки</span></a>
        </div>
      </nav>

      <div class="spectrum-sidebar-footer">
        <button type="button" class="sidebar-order-button spectrum-order-button" data-open-order-modal>Настроить порядок</button>
        <div class="sidebar-user-card spectrum-user-card">
          <div class="sidebar-user-avatar"><%= String(typeof currentAdminUsername !== 'undefined' && currentAdminUsername ? currentAdminUsername : 'A').slice(0,1).toUpperCase() %></div>
          <div class="sidebar-user-meta"><strong><%= typeof currentAdminUsername !== 'undefined' && currentAdminUsername ? currentAdminUsername : 'admin' %></strong><small>Администратор</small></div>
          <form class="logout-form sidebar-logout" method="post" action="/logout"><button type="submit" class="spectrum-icon-button" title="Выйти"><%- nexusIcon('logout') %></button></form>
        </div>
      </div>
    </aside>

    <main class="spectrum-main main <%= typeof hidePageHeader !== 'undefined' && hidePageHeader ? 'main-compact-header' : '' %>">
      <header class="spectrum-pagebar topbar">
        <div class="spectrum-page-heading page-intro">
          <span class="spectrum-eyebrow"><%= sectionLabels[currentPath] || 'Nexus Panel' %></span>
          <h1><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Nexus Panel' %></h1>
          <% if (typeof pageSubtitle !== 'undefined' && pageSubtitle) { %><p class="subtitle"><%= pageSubtitle %></p><% } %>
        </div>
        <div class="spectrum-page-actions">
          <% if (currentPath === 'clients') { %><button type="button" class="spectrum-quick-action" onclick="window.openModalById && openModalById('createClientModal')">Создать клиента</button><% } %>
          <button type="button" class="theme-toggle spectrum-theme-button" data-theme-toggle aria-label="Переключить тему"><span data-theme-icon><%- nexusIcon('moon', 'theme-moon') %><%- nexusIcon('sun', 'theme-sun') %></span><span class="theme-label">Тема</span></button>
        </div>
      </header>
      <div class="spectrum-page-content">

  <nav class="mobile-bottom-nav spectrum-bottom-nav" aria-label="Быстрая навигация">
    <a href="/dashboard" class="<%= currentPath === 'dashboard' ? 'active' : '' %>"><span class="bn-ico"><%- nexusIcon('dashboard') %></span><em>Главная</em></a>
    <a href="/clients" class="<%= currentPath === 'clients' ? 'active' : '' %>"><span class="bn-ico"><%- nexusIcon('clients') %></span><em>Клиенты</em></a>
    <a href="/nodes" class="<%= currentPath === 'nodes' ? 'active' : '' %>"><span class="bn-ico"><%- nexusIcon('nodes') %></span><em>Узлы</em></a>
    <a href="/routing" class="<%= currentPath === 'routing' ? 'active' : '' %>"><span class="bn-ico"><%- nexusIcon('routing') %></span><em>Маршруты</em></a>
    <a href="/more" class="<%= moreNavActive ? 'active' : '' %>"><span class="bn-ico"><%- nexusIcon('more') %></span><em>Ещё</em></a>
  </nav>
