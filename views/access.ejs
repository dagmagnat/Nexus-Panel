<%- include('partials_header', { pageTitle: 'Пользователи и доступ', pageSubtitle: 'Учётные записи сотрудников и права доступа', activePage: 'access' }) %>
<% if (message) { %><div class="alert ok"><%= message %></div><% } %>
<% if (error) { %><div class="alert err"><%= error %></div><% } %>
<% if (accessUser.is_owner) { %>
<section class="card">
  <h2>Создать пользователя</h2>
  <form method="post" action="/access/users" class="management-form" data-permission-form>
    <label>Логин<input name="username" autocomplete="off" minlength="3" maxlength="64" required></label>
    <label>Пароль<input name="password" type="password" autocomplete="new-password" minlength="12" required></label>
    <label>Набор прав<select data-role><option value="viewer">Просмотр клиентов и подписок</option><option value="operator">Оператор клиентов</option><option value="admin">Администратор панели</option></select></label>
    <div class="management-permissions"><% Object.entries(permissions).forEach(([key,label]) => { %><label class="management-check"><input type="checkbox" name="permissions" value="<%= key %>" <%= key === 'clients.read' ? 'checked' : '' %>> <span><%= label %></span></label><% }) %></div>
    <div class="management-form-actions"><p class="muted">Набор можно изменить галочками. Управление хостом, сертификатами, глобальными настройками и пользователями остаётся только у владельца.</p>
    <button class="btn" type="submit">Создать пользователя</button></div>
  </form>
</section>
<section class="card" style="margin-top:16px"><h2>Учётные записи</h2>
<% accounts.forEach(account => { %>
  <details style="margin:14px 0"><summary><%= account.username %> — <%= account.is_owner ? 'Главный администратор' : account.disabled ? 'Заблокирован' : 'Активен' %></summary>
  <% if (!account.is_owner) { %>
  <form method="post" action="/access/users/<%= account.id %>" class="management-form" data-member-form="<%= account.id %>">
    <label>Новый пароль (пусто — сохранить)<input type="password" name="password" minlength="12" autocomplete="new-password"></label>
    <label class="management-check"><input type="checkbox" name="disabled" value="1" <%= account.disabled ? 'checked' : '' %>> <span>Заблокировать пользователя</span></label>
    <div class="management-permissions"><% Object.entries(permissions).forEach(([key,label]) => { %><label class="management-check"><input type="checkbox" name="permissions" value="<%= key %>"> <span><%= label %></span></label><% }) %></div>
    <div class="management-form-actions"><p class="muted">Без галочек доступ к панели будет отозван. Любое сохранение отзывает старые сессии пользователя.</p>
    <button class="btn" type="submit">Сохранить права</button></div>
  </form><% } %></details>
<% }) %></section>
<section class="card" style="margin-top:16px"><h2>Журнал доступа</h2><% audit.forEach(row => { %><p><small><%= row.at %> · Пользователь <%= row.actor %> · <%= row.action %> · <%= row.target %></small></p><% }) %></section>
<script>
const accessMemberships = <%- JSON.stringify(memberships).replace(/</g,'\\u003c') %>;
document.querySelectorAll('[data-role]').forEach(select => select.addEventListener('change', () => {
  const allowed = select.value === 'admin' ? <%- JSON.stringify(Object.keys(permissions)) %> : select.value === 'operator' ? ['clients.read','clients.write'] : ['clients.read'];
  select.form.querySelectorAll('[name="permissions"]').forEach(box => box.checked = allowed.includes(box.value));
}));
document.querySelectorAll('[data-member-form]').forEach(form => {
  const refresh = () => {
    const row = accessMemberships.find(m => Number(m.user_id) === Number(form.dataset.memberForm) && m.workspace_id === 'main');
    const allowed = row ? JSON.parse(row.permissions) : [];
    form.querySelectorAll('[name="permissions"]').forEach(box => box.checked = allowed.includes(box.value));
  };
  refresh();
});
</script>
<% } %>
<%- include('partials_footer') %>
