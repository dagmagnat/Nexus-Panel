<% const cfg=billing.config, root='/account', csrf=typeof csrfToken==='string'?csrfToken:'', ws=typeof workspaceId==='string'?workspaceId:'main'; %>
<section data-tab-panel="devices" id="devices" aria-label="Устройства">
<div class="page-heading"><div><span class="eyebrow">ПОДКЛЮЧЁННЫЕ УСТРОЙСТВА</span><h1>Устройства<span class="heading-dot">.</span></h1></div></div>
<div class="card device-quota <%= full?'slots-full':'' %>"><div class="card-heading"><span><%= full?'Все места заняты':'Доступные места' %></span><strong><%= billing.devices.length %><small> из <%= limit||'∞' %></small></strong></div>
<div class="slot-track" aria-label="<%= account.deviceLimitText %>"><% for(let i=0;i<Math.min(limit||Math.max(3,billing.devices.length),20);i++){ %><i class="<%= i<billing.devices.length?'filled':'' %>"></i><% } %></div>
<% if(cfg.enabled&&limit>0&&limit<cfg.maxDevices){ %><a class="button secondary" href="#renew" data-add-device data-current-limit="<%= limit %>">Добавить устройства <span>от <%= cfg.deviceRub %> ₽/мес.</span><%- icon('arrow') %></a><% } %></div>
<h2 class="section-label">Ваши устройства</h2><div class="card device-list">
<% for(const d of billing.devices){ %><div class="device-row"><span class="device-symbol"><%- icon(/windows|mac|linux/i.test(d.os_name||'')?'monitor':'devices') %><small class="<%= /incy/i.test(d.app_name||'')?'incy-badge':'' %>"><%= d.app_name?d.app_name.slice(0,1).toUpperCase():'•' %></small></span><div class="device-info"><strong><%= d.device_model || d.os_name || d.app_name || 'Устройство' %></strong><small><%= [d.os_name,d.app_name].filter(Boolean).join(' · ') %></small><span><%= d.last_seen_at?'Обновление: '+d.last_seen_at:'Ожидает обновления' %></span></div><% if(cfg.selfService){ %><form method="post" action="<%= root %>/devices/<%= d.id %>/delete" data-confirm="Удалить привязку этого устройства и отозвать его отдельный AWG-доступ?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="_workspace" value="<%= ws %>"><button type="submit" class="icon-button delete-device" aria-label="Удалить устройство <%= d.device_model || d.os_name || d.id %>"><%- icon('trash') %></button></form><% } %></div><% }if(!billing.devices.length){ %><div class="empty-state"><%- icon('devices') %><h3>Здесь появятся ваши устройства</h3><p>Добавьте подписку в Happ или INCY и обновите её.</p><a href="#subscription" class="text-link">К подключению <%- icon('arrow') %></a></div><% } %></div>
<p class="page-note">Удаление освобождает место в подписке и отзывает отдельный AWG-доступ. Приложение с устройства не удаляется. При следующем обновлении оно может зарегистрироваться снова.</p>
<% if(cfg.selfService&&billing.devices.length){ %><form method="post" action="<%= root %>/devices/reset" data-confirm="Сбросить все привязки устройств и отозвать отдельные AWG-конфигурации?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="_workspace" value="<%= ws %>"><button class="reset-devices" type="submit"><%- icon('trash') %>Сбросить все привязки</button></form><% } %>
</section>

<section data-tab-panel="shop" id="renew" aria-label="Магазин">
<div class="page-heading"><div><span class="eyebrow">ВАШ ТАРИФ</span><h1>Магазин<span class="heading-dot">.</span></h1></div><span class="header-label">Неиспользованные дни сохранятся</span></div>
<% if(cfg.enabled){ %>
<form class="shop-layout" method="post" action="<%= root %>/order" id="renewal-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="_workspace" value="<%= ws %>">
<div class="shop-options"><div class="card shop-section"><div class="card-heading"><span class="tile-icon"><%- icon('calendar') %></span><div><h2>Подписка</h2><span>Выберите срок продления</span></div></div>
<div class="month-presets" role="group" aria-label="Быстрый выбор срока"><% for(const m of [1,3,6,12]){const q=billing.options.find(q=>q.months===m); %><button type="button" data-month="<%= m %>" class="<%= m===1?'selected':'' %>" aria-pressed="<%= m===1?'true':'false' %>"><strong><%= m %> <span>мес.</span></strong><% if(q&&q.discount){ %><small>−<%= q.discount %>%</small><% }else{ %><small><%= m*30 %> дней</small><% } %></button><% } %></div>
<label class="field-label" for="months">Или другой срок<select id="months" name="months"><% for(const q of billing.options){ %><option value="<%= q.months %>"><%= q.months %> мес. · <%= q.days %> дней<%= q.discount?' · −'+q.discount+'%':'' %></option><% } %></select></label></div>
<div class="card shop-section"><div class="card-heading"><span class="tile-icon"><%- icon('devices') %></span><div><h2>Устройства</h2><span><%= cfg.includedDevices %> включено в базовую цену</span></div></div>
<label class="field-label" for="device-count">Всего устройств<select id="device-count" name="devices"><% for(let i=cfg.includedDevices;i<=cfg.maxDevices;i++){ %><option value="<%= i %>" <%= i===cfg.includedDevices?'selected':'' %>><%= i %><%= i===cfg.includedDevices?' · включено':'' %></option><% } %></select></label><p class="hint">Каждое дополнительное устройство — <%= cfg.deviceRub %> ₽ в месяц. Новый лимит начнёт действовать после подтверждения оплаты.</p></div></div>
<div class="card checkout-card"><span class="eyebrow">ВАШ ВЫБОР</span><h2>Продление подписки</h2><div class="checkout-line"><span>Срок</span><strong id="quote-months">1 месяц</strong></div><div class="checkout-line"><span>Устройства</span><strong id="quote-devices"><%= cfg.includedDevices %></strong></div><div class="checkout-line"><span>Скидка</span><strong id="quote-discount">Без скидки</strong></div><div class="checkout-total"><small>К оплате</small><strong id="quote-total"><%= billing.options[0]?billing.money(billing.options[0].amount):'' %></strong><p id="quote-detail" class="hint"></p></div><button class="button primary" type="submit"><span><%= cfg.button %></span><%- icon('arrow') %></button><p class="checkout-note">Подписка продлится после проверки поступления перевода.</p></div>
</form>
<% }else{ %><div class="card empty-state"><%- icon('bag') %><h2>Продление подписки</h2><p>Для продления обратитесь в поддержку.</p><% if(help){ %><a class="button primary" href="<%= help %>" target="_blank" rel="noreferrer">Написать нам</a><% } %></div><% } %>
<% if(billing.orders.length){ %><h2 class="section-label">Ваши заказы</h2><% }for(const o of billing.orders){ %><article class="card portal-order" id="order-<%= o.id %>" tabindex="-1"><div class="order-heading"><div><span class="eyebrow">ЗАКАЗ <%= o.id.slice(0,8) %></span><h2><%= o.months %> мес. · <%= o.devices %> устр.</h2></div><strong><%= billing.money(o.amount) %></strong></div>
<% if(o.status==='confirmed'){ %><p class="confirmed-message"><%- icon('check') %>Оплата подтверждена. Подписка продлена.</p><% }else{ %><div class="payment-layout"><div><% if(cfg.bank){ %><div class="payment-recipient"><small>Банк получателя</small><strong><%= cfg.bank %></strong></div><% }if(cfg.phone){ %><div class="payment-recipient"><small>Телефон</small><strong><%= cfg.phone %></strong></div><button type="button" class="button secondary" data-payment-copy="<%= cfg.phone %>"><%- icon('copy') %>Копировать телефон</button><% }if(cfg.paymentUrl){ %><a class="button primary" href="<%= cfg.paymentUrl %>" rel="noreferrer"><%= /(?:^|\.)nspk\.ru$/.test(new URL(cfg.paymentUrl).hostname)?'Выбрать банк и открыть СБП':'Открыть ссылку банка' %><%- icon('arrow') %></a><% } %><button type="button" class="button secondary" data-payment-copy="<%= (o.amount/100).toFixed(2).replace('.',',') %>"><%- icon('copy') %>Сумма: <%= billing.money(o.amount) %></button></div><% if(billing.qr){ %><img class="bank-qr" src="<%= billing.qr %>" width="180" height="180" alt="QR-код банковской ссылки"><% } %></div>
<p class="hint">Проверьте получателя и введите <strong><%= billing.money(o.amount) %></strong>, если банк не подставил сумму. Если ссылка открыла только сайт банка получателя, переведите по СБП в своём приложении по телефону выше.</p>
<% if(o.status==='review'){ %><div class="notice">Перевод на проверке. Повторно переводить деньги не нужно.</div><% }else{ %><form method="post" action="<%= root %>/orders/<%= o.id %>/paid"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="_workspace" value="<%= ws %>"><button class="button secondary" type="submit">Я оплатил — отправить на проверку</button></form><% } } %></article><% } %>
</section>
<script type="application/json" id="billing-prices"><%- JSON.stringify({monthlyRub:cfg.monthlyRub,deviceRub:cfg.deviceRub,includedDevices:cfg.includedDevices,discount3:cfg.discount3,discount6:cfg.discount6,discount12:cfg.discount12}).replace(/</g,'\\u003c') %></script>
