<%
  const activeNodeTab = ['list', 'add', 'help'].includes(String(typeof nodeActiveTab !== 'undefined' ? nodeActiveTab : 'list'))
    ? String(typeof nodeActiveTab !== 'undefined' ? nodeActiveTab : 'list')
    : 'list';
  function flagEmojiFromCode(code) {
    const cc = String(code || '').trim().toUpperCase();
    if (!/^[A-Z]{2}$/.test(cc) || ['ZZ','XX'].includes(cc)) return '';
    return Array.from(cc).map(ch => String.fromCodePoint(0x1F1E6 + ch.charCodeAt(0) - 65)).join('');
  }
  function escapeFlagAttr(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }
  function nodeFallbackIcon(nodeType) {
    const kind = String(nodeType || '') === 'remnawave' ? 'remnawave' : '3xui';
    const label = kind === 'remnawave' ? 'Remnawave' : '3x-ui';
    const glyph = kind === 'remnawave'
      ? '<circle cx="12" cy="12" r="2.2"/><path d="M7.8 16.2a6 6 0 0 1 0-8.4M16.2 7.8a6 6 0 0 1 0 8.4M5 19a10 10 0 0 1 0-14M19 5a10 10 0 0 1 0 14"/>'
      : '<rect x="4" y="5" width="16" height="5.5" rx="1.6"/><rect x="4" y="13.5" width="16" height="5.5" rx="1.6"/><path d="M7 7.8h.01M7 16.2h.01"/>' ;
    return `<span class="flag-badge node-type-fallback node-type-${kind}" aria-label="${label}" title="${label}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${glyph}</svg></span>`;
  }
  function flagHtml(code, fallback, name, nodeType) {
    const rawCode = String(code || '').trim().toLowerCase();
    const flagValue = String(fallback || '').trim();
    const nameText = String(name || '').trim();
    const codeFromName = (typeof countryCodeByName === 'function') ? String(countryCodeByName(nameText) || '').trim().toLowerCase() : '';
    const code2 = (/^[a-z]{2}$/i.test(rawCode) ? rawCode : (/^[a-z]{2}$/i.test(flagValue) ? flagValue.toLowerCase() : codeFromName));
    if (code2 && !['zz','xx'].includes(code2)) {
      return `<img class="flag-badge flag-img" src="/flags/${code2}.svg" alt="${escapeFlagAttr(name || code2)}" loading="lazy" onerror="this.style.display='none'">`;
    }
    const emoji = (typeof countryFlagText === 'function')
      ? countryFlagText(code, flagValue, nameText)
      : ((flagValue && flagValue !== '🌐' && !/^[a-z]{2}$/i.test(flagValue)) ? flagValue : flagEmojiFromCode(code || flagValue));
    return emoji && emoji !== '🌐'
      ? `<span class="flag-badge emoji-fallback" aria-label="${escapeFlagAttr(String(code || '').toUpperCase())}">${emoji}</span>`
      : nodeFallbackIcon(nodeType);
  }
  function compactTransportLabel(label) {
    const raw = String(label || '').trim();
    if (!raw) return 'не загружено';
    return raw
      .replace(/^\s*\d+(?:[.,]\d+)?\s*(?:Б|КБ|МБ|ГБ|ТБ|ПБ|PB)\s*[·•|/-]\s*/i, '')
      .replace(/\s*\/\s*RAW/gi, '')
      .replace(/\s*\/\s*TCP/gi, '')
      .replace(/\s*\/\s*JSON/gi, '')
      .replace(/\s{2,}/g, ' ')
      .replace(/\s*\/\s*/g, ' / ')
      .trim() || raw;
  }
  function activityLabel(value) {
    const key = String(value || 'unknown').toLowerCase();
    return ({ online: 'В сети', offline: 'Не в сети', disabled: 'Отключён', unknown: 'Нет данных', checking: 'Проверяю' })[key] || 'Нет данных';
  }
%>

<%- include('partials_header', { pageTitle: 'Узлы', pageSubtitle: 'Добавление, проверка и управление 3x-ui и Remnawave', activePage: 'nodes', hidePageHeader: true }) %>

<% if (message) { %>
  <div class="alert ok"><%= message %></div>
<% } %>

<% if (error) { %>
  <div class="alert err"><%= error %></div>
<% } %>

<div class="desktop-page-tabs" data-page-tabs="nodes">
  <button type="button" class="<%= activeNodeTab === 'list' ? 'is-active' : '' %>" data-tab-target="list">Список узлов</button>
  <button type="button" class="<%= activeNodeTab === 'add' ? 'is-active' : '' %>" data-tab-target="add">Добавить узел</button>
  <button type="button" class="<%= activeNodeTab === 'help' ? 'is-active' : '' %>" data-tab-target="help">Подсказка</button>
</div>

<nav class="nodes-mobile-tabs" aria-label="Разделы узлов">
  <a href="/nodes?tab=list" class="<%= activeNodeTab === 'list' ? 'is-active' : '' %>">Список</a>
  <a href="/nodes?tab=add" class="<%= activeNodeTab === 'add' ? 'is-active' : '' %>">＋ Добавить узел</a>
  <a href="/nodes?tab=help" class="<%= activeNodeTab === 'help' ? 'is-active' : '' %>">Подсказка</a>
</nav>


<div class="grid">
  <section class="card span-12 tab-panel <%= activeNodeTab === 'add' ? 'is-active' : '' %>" data-tab-panel="add">
    <h2>Добавить узел</h2>
    <form method="post" action="/nodes" class="js-long-action auth-token-active" data-node-add-form data-loading-title="Добавляю узел" data-loading-text="Проверяю подключение, читаю параметры выбранного inbound и сохраняю узел.">
      <div class="form-grid">
        <div class="field">
          <label>Страна</label>
          <select name="country_code" required>
            <option value="">Выбери страну</option>
            <% countries.forEach(country => { %>
              <option value="<%= country.code %>"><%= country.name_ru %></option>
            <% }) %>
          </select>
        </div>

        <div class="field half">
          <label>Свой регион, если выбрано «Другое»</label>
          <input name="custom_country_name_ru" placeholder="например: Europe Auto, Private" />
          <small class="hint">Используется только для пункта «Другое / свой регион».</small>
        </div>
        <div class="field half">
          <label>Свой флаг / emoji</label>
          <input name="custom_country_flag" placeholder="🇪🇺 или 🌐" maxlength="8" />
        </div>

        <div class="field">
          <label>Доп. название узла</label>
          <input name="label_suffix" placeholder="например: 1, 2, Frankfurt, Hetzner" />
          <small class="hint">Например: Германия + 1 = Германия-1. Флаг и страна остаются от выбранной страны в подписке.</small>
        </div>

        <div class="field">
          <label>Тип узла</label>
          <select name="node_type" class="js-node-type-select">
            <option value="3xui" selected>3x-ui</option>
            <option value="remnawave">Remnawave Panel (API)</option>
          </select>
          <small class="hint" data-node-type-summary>Remnawave добавляется по URL панели и API Token. Агрегатор создаёт пользователей с тем же VLESS UUID, назначает Internal Squad и добавляет Remnawave-хосты в общую SUB/JSON подписку клиента.</small>
        </div>

        <div class="field" data-node-endpoint-field>
          <label data-node-endpoint-label>3x-ui Panel URL</label>
          <input name="panel_url" placeholder="https://panel.example.com:2053" required data-node-endpoint-input />
          <small class="hint" data-node-endpoint-hint>Адрес обычной панели 3x-ui, установленной на сервере.</small>
        </div>

        <div class="field js-node-3xui-only">
          <label>Panel Path</label>
          <input name="panel_path" placeholder="/qwerty123" />
        </div>

        <div class="field js-node-3xui-only">
          <label>Метод API 3x-ui</label>
          <select name="api_auth_mode" class="js-api-auth-mode" data-target="add-node-auth-fields">
            <option value="token" selected>API Token</option>
            <option value="password">3x-ui старый метод: логин и пароль</option>
          </select>
          <small class="hint">Для 3x-ui выбери новый API Token или старый способ с логином и паролем.</small>
        </div>

        <div id="add-node-auth-fields" class="auth-mode-fields field full">
          <div class="auth-password-fields form-grid hidden" style="display:none">
            <div class="field half">
              <label>Логин панели</label>
              <input name="username" placeholder="admin" data-required-when="password" />
            </div>

            <div class="field half">
              <label>Пароль панели</label>
              <input name="password" type="password" data-required-when="password" />
            </div>
          </div>

          <div class="auth-token-fields">
            <label data-node-token-label>API Token 3x-ui</label>
            <input name="api_token" type="password" placeholder="API Token удалённой панели 3x-ui" data-required-when="token" data-node-token-input />
            <small class="hint" data-node-token-hint>В 3x-ui v3.4.0 токен показывается только при создании и затем хранится в панели как хеш. Вставь сохранённый полный токен; агрегатор хранит его зашифрованно.</small>
          </div>
        </div>

        <div class="field full js-node-remnawave-only hidden" hidden style="display:none!important">
          <div class="alert ok" style="margin:0;">
            <strong>Подключение к Remnawave Panel.</strong> Укажи корень панели, например <code>https://rw.nl.amored.ru</code>, Bearer API Token и UUID рабочего Internal Squad. При создании клиента Aggregator использует тот же VLESS UUID, назначает squad и добавляет ссылки Remnawave в общую SUB/JSON подписку.
          </div>
        </div>

        <div class="field half js-node-remnawave-only hidden" hidden style="display:none!important">
          <label>Internal Squad UUID</label>
          <input name="remnawave_internal_squad_uuid" placeholder="UUID сквада bee1" data-remnawave-squad-input />
          <small class="hint">Обязательно: этот squad будет назначен каждому созданному пользователю, поэтому его видимые Hosts появятся в общей подписке Aggregator.</small>
        </div>

        <div class="field half js-node-remnawave-only hidden" hidden style="display:none!important">
          <label>Remnawave Node UUID</label>
          <input name="remnawave_node_uuid" placeholder="необязательно" />
          <small class="hint">Необязательно. Используется как справочная привязка к физической Node в Remnawave.</small>
        </div>

        <div class="field half js-node-remnawave-only hidden" hidden style="display:none!important">
          <label>Host UUID</label>
          <input name="remnawave_host_uuid" placeholder="необязательно" />
          <small class="hint">UUID конкретного Host. После сохранения Aggregator сможет выбирать именно его ссылку по адресу, порту, SNI и пути.</small>
        </div>

        <div class="field half js-node-remnawave-only hidden" hidden style="display:none!important">
          <label>Какие Hosts добавлять</label>
          <select name="remnawave_link_mode">
            <option value="first" selected>Один Host — первый подходящий</option>
            <option value="unique">Все уникальные Hosts</option>
            <option value="all">Все записи Remnawave без отбора</option>
          </select>
          <small class="hint">Рекомендуется «Один Host», если в Internal Squad включено несколько Hosts, но в Aggregator это один узел.</small>
        </div>

        <div class="field half js-node-remnawave-only hidden" hidden style="display:none!important">
          <label>Название в подписке</label>
          <select name="remnawave_remark_mode">
            <option value="aggregator" selected>Название узла Aggregator</option>
            <option value="provider">Оригинальное имя Host</option>
            <option value="combined">Aggregator + имя Host</option>
          </select>
        </div>

        <div class="field half js-node-remnawave-only hidden" hidden style="display:none!important">
          <label>Фильтр Host или адреса</label>
          <input name="remnawave_link_filter" placeholder="cdn.amored.ru, beet" />
          <small class="hint">Необязательно. Фильтрует ссылки по имени, адресу, SNI, Host и пути.</small>
        </div>

        <div class="field half js-node-remnawave-only hidden" hidden style="display:none!important">
          <label>Дополнительный X-Api-Key</label>
          <input name="remnawave_caddy_token" type="password" placeholder="только если панель защищена Caddy Auth" />
          <small class="hint">Не является Remnawave API Token. Оставь пустым при обычной установке Nginx.</small>
        </div>

        <div class="field half js-node-3xui-only">
          <label>Inbound ID</label>
          <input name="inbound_id" type="number" min="1" placeholder="1" required />
          <small class="hint">Перед сохранением Aggregator проверит этот ID, загрузит полный inbound и перенесёт его Protocol, Transport, Security, порт, путь и режим. Если ID не найден, узел не будет добавлен.</small>
        </div>

        <div class="field js-node-3xui-only js-node-3xui-editable-only">
          <label>SNI в подписках</label>
          <select name="sni_mode" data-sni-source>
            <option value="inbound" selected>Из 3x-ui inbound</option>
            <option value="profile">Выбрать SNI-профиль</option>
            <option value="manual">Ручной SNI</option>
          </select>
          <small class="hint">Если выбран профиль или ручной SNI, при добавлении узла агрегатор применит SNI и Target в 3x-ui inbound: target = SNI:443.</small>
        </div>
        <div class="field half js-node-3xui-only js-node-3xui-editable-only" data-sni-profile-field>
          <label>SNI-профиль</label>
          <select name="sni_profile_id">
            <option value="">Не выбран</option>
            <% (sniProfiles || []).forEach(profile => { %>
              <option value="<%= profile.id %>"><%= profile.name %> · <%= profile.sni %></option>
            <% }) %>
          </select>
        </div>
        <div class="field half js-node-3xui-only js-node-3xui-editable-only" data-sni-manual-field>
          <label>Ручной SNI</label>
          <input name="sni_override" placeholder="m.vk.com" />
        </div>
      </div>

      <label class="switch-row compact add-clients-switch js-node-client-sync-only">
        <input type="checkbox" name="create_existing_clients_on_node" value="1" />
        <span>
          <strong>Создать существующих клиентов в новом узле</strong>
          <small>После проверки создаст только отсутствующих пользователей. Для Remnawave сохранит тот же VLESS UUID, назначит указанный Internal Squad и не перезапишет пользователя с чужим UUID.</small>
        </span>
      </label>

      <label class="switch-row compact add-clients-switch js-node-client-sync-only">
        <input type="checkbox" name="import_clients_from_node" value="1" />
        <span>
          <strong>Импортировать клиентов из нового узла в агрегатор</strong>
          <small>Импортирует существующих пользователей в Aggregator и создаёт локальные связи. Для Remnawave читает <code>/api/users</code>, VLESS UUID, срок, лимит, squad-подписку и URL пользователя.</small>
        </span>
      </label>

      <div class="actions node-actions add-node-actions">
        <button type="submit" class="btn-main add-node-submit">Добавить узел</button>
      </div>
    </form>
  </section>

  <section class="card span-12 tab-panel <%= activeNodeTab === 'help' ? 'is-active' : '' %>" data-tab-panel="help">
    <h2>Подсказка</h2>
    <div class="kv-list">
      <div class="kv-item">
        <strong>Отключение узла</strong>
        <div class="muted">Если на узле техработы, нажми «Отключить». Узел останется в панели, но исчезнет из SUB/JSON подписок клиентов.</div>
      </div>
      <div class="kv-item">
        <strong>Доп. название</strong>
        <div class="muted">Используется в названии сервера внутри подписки: Германия-1, Германия-2, Финляндия Hetzner.</div>
      </div>
      <div class="kv-item">
        <strong>Тип подключения</strong>
        <div class="muted"><b>3x-ui</b> подключается по URL панели, Panel Path, API Token или логину/паролю и Inbound ID. <b>Remnawave Panel</b> подключается по корневому URL и Bearer API Token.</div>
      </div>
      <div class="kv-item">
        <strong>Inbound ID</strong>
        <div class="muted">Для каждого узла 3x-ui укажи inbound, в котором Aggregator будет создавать и обновлять клиентов. Для Remnawave вместо inbound используется Internal Squad.</div>
      </div>
    </div>
  </section>

  <section class="card span-12 tab-panel nodes-modern-card <%= activeNodeTab === 'list' ? 'is-active' : '' %>" data-tab-panel="list">
    <div class="nodes-modern-head">
      <div class="section-title-row nodes-order-title">
        <h2>Список узлов <span class="count-chip"><%= nodes.length %></span></h2>
        <span id="nodeOrderStatus" class="muted">Перетащи ⠿ на ПК или используй ↑/↓ на телефоне, чтобы изменить порядок в приложении</span>
      </div>
      <% if (nodes.length) { %>
        <div class="nodes-modern-toolbar" role="search">
          <label class="nodes-search-field" for="nodeSearchInput">
            <span aria-hidden="true">⌕</span>
            <input id="nodeSearchInput" type="search" placeholder="Поиск по названию, ID или URL..." autocomplete="off" />
          </label>
          <div class="nodes-filter-group" aria-label="Фильтры узлов">
            <label class="nodes-filter-field nodes-filter-type">
              <span>Тип</span>
              <select id="nodeTypeFilter">
                <option value="all">Все</option>
                <option value="3xui">3x-ui</option>
                <option value="remnawave">Remnawave</option>
              </select>
            </label>
            <label class="nodes-filter-field nodes-filter-state">
              <span>Статус</span>
              <select id="nodeStateFilter">
                <option value="all">Все</option>
                <option value="enabled">Включён</option>
                <option value="disabled">Отключён</option>
                <option value="online">online</option>
                <option value="offline">offline</option>
              </select>
            </label>
            <button type="button" class="secondary nodes-reset-filter" id="nodeResetFilters" title="Сбросить фильтры" aria-label="Сбросить фильтры"><span aria-hidden="true">↻</span></button>
          </div>
        </div>
      <% } %>
    </div>

    <% if (!nodes.length) { %>
      <p class="muted">Пока нет добавленных узлов.</p>
    <% } else { %>
      <div class="nodes-modern-layout" id="nodesModernLayout">
        <div class="nodes-list-panel">
          <div class="nodes-list-header">
            <span>ID</span>
            <span>Название</span>
            <span>Тип</span>
            <span>Транспорт</span>
            <span>Статус</span>
            <span>Активность</span>
          </div>
          <div id="nodesOrderBody" class="nodes-modern-list" data-page-size="<%= nodePageSize || 10 %>">
            <% nodes.forEach((node, idx) => {
              const suffix = (node.label_suffix || '').trim();
              const baseName = node.country_name_ru || node.name;
              const displayName = suffix
                ? (/^\d+$/.test(suffix) ? `${baseName}-${suffix}` : `${baseName} ${suffix}`)
                : baseName;
              const isEnabled = Number(node.enabled) === 1;
              const nodeType = String(node.node_type || '3xui');
              const isRemnawave = nodeType === 'remnawave';
              const nodeKind = isRemnawave ? 'remnawave' : '3xui';
              const nodeTypeLabel = node.node_type_label || (isRemnawave ? 'Remnawave Panel' : '3x-ui');
              const transportLabel = node.transport_label || 'не загружено';
              const transportCompact = compactTransportLabel(transportLabel);
              const transportRowText = isRemnawave ? 'Remnawave API' : transportCompact;
              const activityStatus = node.last_status || 'unknown';
              const searchText = [node.id, displayName, nodeTypeLabel, node.panel_url, node.panel_path, node.sub_base_url, node.inbound_id, transportLabel, activityStatus, node.last_error].join(' ').toLowerCase();
            %>
              <div
                class="node-list-row <%= idx === 0 ? 'is-selected' : '' %> <%= isEnabled ? '' : 'muted-row' %>"
                draggable="true"
                data-node-id="<%= node.id %>"
                data-node-type="<%= nodeKind %>"
                data-node-enabled="<%= isEnabled ? 'enabled' : 'disabled' %>"
                data-node-activity="<%= activityStatus %>"
                data-node-search="<%= searchText %>"
              >
                <button type="button" class="drag-handle" title="Перетащить узел" aria-label="Перетащить узел">⠿</button>
                <button type="button" class="node-row-select" data-select-node="<%= node.id %>" data-node-edit-url="/nodes/<%= node.id %>/edit" aria-label="Редактировать узел <%= displayName %>">
                  <span class="node-row-id"><%= node.id %></span>
                  <span class="node-row-name"><strong><%- flagHtml(node.country_code, node.country_flag, node.country_name_ru || node.name, node.node_type) %><span><%= displayName %></span></strong></span>
                  <span class="node-row-type"><%= nodeTypeLabel %></span>
                  <span class="transport-chip transport-chip-full" title="<%= transportRowText %>"><%= transportRowText %></span><span class="transport-chip transport-chip-mobile" title="<%= transportRowText %>"><%= transportRowText %></span>
                  <span class="badge <%= isEnabled ? 'online' : 'offline' %>"><%= isEnabled ? 'Включён' : 'Отключён' %></span>
                  <span class="node-row-activity" data-node-live-status="<%= node.id %>"><span class="badge <%= activityStatus %>" data-node-live-badge><%= activityLabel(activityStatus) %></span><span class="signal-bars" aria-hidden="true"><i></i><i></i><i></i></span></span>
                  <span class="node-row-error <%= node.last_error ? '' : 'hidden' %>" data-node-live-error="<%= node.id %>" title="<%= node.last_error ? humanizeError(node.last_error) : '' %>"><%= node.last_error ? humanizeError(node.last_error) : '' %></span>
                  <span class="node-row-chevron" aria-hidden="true">›</span>
                  <span class="node-mobile-edit-hint" aria-hidden="true">Изменить</span>
                </button>
                <div class="node-mobile-order-controls" aria-label="Изменить порядок узла">
                  <button type="button" class="secondary mobile-order-btn" data-mobile-move="up" title="Поднять выше">↑</button>
                  <button type="button" class="secondary mobile-order-btn" data-mobile-move="down" title="Опустить ниже">↓</button>
                </div>
              </div>
            <% }) %>
          </div>
          <div class="nodes-list-footer">
            <span>Показано <strong id="nodesPageRange">0–0</strong> из <strong id="visibleNodesCount"><%= nodes.length %></strong> узлов</span>
            <div class="nodes-pagination" id="nodesPagination" aria-label="Страницы узлов"></div>
          </div>
        </div>

        <aside class="nodes-detail-panel" id="nodesDetailPanel" aria-live="polite">
          <button type="button" class="nodes-detail-close" id="nodeDetailsClose" aria-label="Скрыть детали" onclick="event.preventDefault(); event.stopPropagation(); closeNodeDetailsPanel(event); return false;">×</button>
          <% nodes.forEach((node, idx) => {
            const suffix = (node.label_suffix || '').trim();
            const baseName = node.country_name_ru || node.name;
            const displayName = suffix
              ? (/^\d+$/.test(suffix) ? `${baseName}-${suffix}` : `${baseName} ${suffix}`)
              : baseName;
            const isEnabled = Number(node.enabled) === 1;
            const nodeType = String(node.node_type || '3xui');
            const isRemnawave = nodeType === 'remnawave';
            const nodeTypeLabel = node.node_type_label || (isRemnawave ? 'Remnawave Panel' : '3x-ui');
            const transportLabel = node.transport_label || 'не загружено';
            const transportCompact = compactTransportLabel(transportLabel);
            const activityStatus = node.last_status || 'unknown';
            const apiValue = node.panel_url || '-';
            const pathValue = isRemnawave ? (node.remnawave_internal_squad_uuid || '-') : (node.panel_path || '-');
            const inboundValue = isRemnawave ? '—' : (node.inbound_id || '-');
            const inboundSecurity = String(node.inbound_security || node.transport_security || 'none').toLowerCase();
            const inboundNetwork = String(node.inbound_network || node.transport_network || '').toLowerCase();
            const inboundHasSni = ['tls', 'reality'].includes(inboundSecurity);
          %>
            <article class="node-detail-card <%= idx === 0 ? 'is-active' : '' %>" data-detail-node-id="<%= node.id %>" <%= idx === 0 ? '' : 'hidden' %>>
              <div class="node-detail-title-row">
                <div class="node-detail-flag"><%- flagHtml(node.country_code, node.country_flag, node.country_name_ru || node.name, node.node_type) %></div>
                <div class="node-detail-title">
                  <div><strong><%= displayName %></strong> <span class="badge <%= isEnabled ? 'online' : 'offline' %>"><%= isEnabled ? 'Включён' : 'Отключён' %></span></div>
                  <small>ID: <%= node.id %> · Тип: <%= nodeTypeLabel %> · Транспорт: <%= transportCompact %></small>
                </div>
              </div>

              <div class="node-detail-kv">
                <div class="node-detail-kv-row">
                  <span>API / Panel URL</span>
                  <code><%= apiValue %></code>
                  <button type="button" class="copy-mini" data-copy-text="<%= apiValue %>" title="Копировать">⧉</button>
                </div>
                <div class="node-detail-kv-row">
                  <span><%= isRemnawave ? 'Internal Squad UUID' : 'Panel Path' %></span>
                  <code><%= pathValue %></code>
                  <button type="button" class="copy-mini" data-copy-text="<%= pathValue %>" title="Копировать">⧉</button>
                </div>
                <div class="node-detail-kv-row">
                  <span>Inbound ID</span>
                  <strong><%= inboundValue %></strong>
                </div>
                <% if (!isRemnawave && node.transport_loaded) { %>
                  <div class="node-detail-kv-row node-inbound-traffic-row">
                    <span>Потрачено в Inbound #<%= node.inbound_id %></span>
                    <strong><%= node.inbound_used_text || '0 Б' %></strong>
                    <small><%= node.inbound_download_text || '0 Б' %> / <%= node.inbound_upload_text || '0 Б' %> · скачано / отдано</small>
                  </div>
                <% } %>
                <% if (isRemnawave) { %>
                  <div class="node-detail-kv-row">
                    <span>Авторизация</span>
                    <strong>Bearer API Token</strong>
                  </div>
                  <div class="node-detail-kv-row">
                    <span>Node UUID</span>
                    <code><%= node.remnawave_node_uuid || 'не выбран' %></code>
                  </div>
                  <div class="node-detail-kv-row">
                    <span>Host UUID</span>
                    <code><%= node.remnawave_host_uuid || 'не выбран' %></code>
                  </div>
                  <div class="node-detail-kv-row">
                    <span>Hosts в подписке</span>
                    <strong><%= String(node.remnawave_link_mode || 'first') === 'all' ? 'Все' : (String(node.remnawave_link_mode || 'first') === 'unique' ? 'Все уникальные' : 'Один') %></strong>
                  </div>
                  <div class="node-detail-kv-row">
                    <span>Фильтр Remnawave</span>
                    <code><%= node.remnawave_link_filter || 'нет' %></code>
                  </div>
                <% } else if (node.transport_loaded) { %>
                  <% if (node.inbound_remark) { %>
                    <div class="node-detail-kv-row">
                      <span>Remark inbound</span>
                      <code><%= node.inbound_remark %></code>
                    </div>
                  <% } %>
                  <div class="node-detail-kv-row">
                    <span>Порт inbound</span>
                    <strong><%= node.inbound_port || '—' %></strong>
                  </div>
                  <div class="node-detail-kv-row">
                    <span>Protocol</span>
                    <strong><%= String(node.inbound_protocol || '').toUpperCase() || '—' %></strong>
                  </div>
                  <div class="node-detail-kv-row">
                    <span>Transport</span>
                    <strong><%= transportCompact %></strong>
                  </div>
                  <div class="node-detail-kv-row">
                    <span>Security</span>
                    <strong><%= inboundSecurity.toUpperCase() %></strong>
                  </div>
                  <% if (inboundNetwork === 'xhttp' && node.inbound_transport_mode) { %>
                    <div class="node-detail-kv-row">
                      <span>XHTTP mode</span>
                      <strong><%= node.inbound_transport_mode %></strong>
                    </div>
                  <% } else if (inboundNetwork === 'grpc' && node.inbound_transport_mode) { %>
                    <div class="node-detail-kv-row">
                      <span>gRPC mode</span>
                      <strong><%= node.inbound_transport_mode %></strong>
                    </div>
                  <% } %>
                  <% if (['ws', 'httpupgrade', 'xhttp'].includes(inboundNetwork) && node.inbound_transport_path) { %>
                    <div class="node-detail-kv-row">
                      <span>Путь транспорта</span>
                      <code><%= node.inbound_transport_path %></code>
                    </div>
                  <% } %>
                  <% if (['ws', 'httpupgrade', 'xhttp'].includes(inboundNetwork) && node.inbound_transport_host) { %>
                    <div class="node-detail-kv-row">
                      <span>Host транспорта</span>
                      <code><%= node.inbound_transport_host %></code>
                    </div>
                  <% } %>
                  <% if (inboundNetwork === 'grpc' && node.inbound_service_name) { %>
                    <div class="node-detail-kv-row">
                      <span>gRPC serviceName</span>
                      <code><%= node.inbound_service_name %></code>
                    </div>
                  <% } %>
                  <% if (inboundHasSni && node.inbound_sni) { %>
                    <div class="node-detail-kv-row">
                      <span>SNI / ServerName</span>
                      <code><%= node.inbound_sni %></code>
                    </div>
                  <% } %>
                  <% if (inboundHasSni && node.inbound_fingerprint) { %>
                    <div class="node-detail-kv-row">
                      <span>Fingerprint</span>
                      <code><%= node.inbound_fingerprint %></code>
                    </div>
                  <% } %>
                <% } else { %>
                  <div class="node-detail-kv-row danger-row">
                    <span>Параметры inbound</span>
                    <strong>не загружены</strong>
                  </div>
                <% } %>
                <% if (node.last_error) { %>
                  <div class="node-detail-kv-row danger-row">
                    <span>Ошибка</span>
                    <code><%= humanizeError(node.last_error) %></code>
                  </div>
                <% } %>
              </div>

              <div class="node-detail-section">
                <h3>Статус и активность</h3>
                <div class="node-status-grid">
                  <div><span>Статус</span><strong class="badge <%= isEnabled ? 'online' : 'offline' %>"><%= isEnabled ? 'Включён' : 'Отключён' %></strong></div>
                  <div><span>Активность</span><strong class="badge <%= activityStatus %>" data-node-detail-live-status="<%= node.id %>"><%= activityLabel(activityStatus) %></strong></div>
                </div>
              </div>

              <div class="node-detail-actions">
                <form method="post" action="/nodes/<%= node.id %>/check" class="inline-form node-detail-action-form js-long-action" data-loading-title="Проверяю узел" data-loading-text="Ожидание ответа ограничено коротким тайм-аутом. Недоступный узел не будет удерживать страницу 30 секунд." onclick="event.stopPropagation()">
                  <button type="submit" class="btn-main">Проверить</button>
                </form>
                <a href="/nodes/<%= node.id %>/edit" class="link-btn secondary node-detail-action-link" onclick="event.stopPropagation()">Изменить</a>
                <form method="post" action="/nodes/<%= node.id %>/create-missing-clients" class="inline-form node-detail-action-form js-long-action" data-loading-title="Добавляю отсутствующих клиентов" data-loading-text="На этот узел будут созданы только отсутствующие клиенты. Уже существующие записи не обновляются." onclick="event.stopPropagation()" onsubmit="return confirm('<%= isRemnawave ? 'Создать в Remnawave только отсутствующих пользователей Aggregator и назначить им настроенный Internal Squad?' : 'Создать на выбранном узле только отсутствующих клиентов агрегатора? Уже существующие клиенты будут пропущены.' %>')">
                  <button type="submit" class="secondary">Создать отсутствующих</button>
                </form>
                <form method="post" action="/nodes/<%= node.id %>/toggle" class="inline-form node-detail-action-form" onclick="event.stopPropagation()" onsubmit="return confirm('<%= isRemnawave ? (isEnabled ? 'Отключить подключение Remnawave?' : 'Включить подключение Remnawave?') : (isEnabled ? 'Отключить узел из подписок?' : 'Включить узел обратно в подписки?') %>')">
                  <% if (isEnabled) { %>
                    <button type="submit" class="danger">Отключить</button>
                  <% } else { %>
                    <button type="submit" class="secondary">Включить</button>
                  <% } %>
                </form>
              </div>
            </article>
          <% }) %>
        </aside>
      </div>
    <% } %>
  </section>
</div>

<div id="loadingModal" class="modal hidden loading-modal" aria-live="polite">
  <div class="modal-card loading-card">
    <div class="loader-ring"></div>
    <h2 id="loadingTitle">Загрузка</h2>
    <p class="muted" id="loadingText">Операция выполняется. Не закрывайте страницу.</p>
    <div class="node-add-progress" id="nodeAddProgress" hidden>
      <div class="node-add-progress-head"><strong id="nodeAddProgressLabel">Подготовка</strong><span id="nodeAddProgressPercent">0%</span></div>
      <div class="node-add-progress-track"><i id="nodeAddProgressBar"></i></div>
      <div class="node-add-progress-meta"><span id="nodeAddElapsed">Прошло: 0 сек.</span><span id="nodeAddEta">Осталось примерно: 1 мин.</span></div>
      <p class="node-add-warning">Не закрывайте эту вкладку. Проверка API и перенос клиентов выполняются последовательно.</p>
    </div>
  </div>
</div>

<script>

function setNodeOrderStatus(text, isError) {
  const el = document.getElementById('nodeOrderStatus');
  if (!el) return;
  el.textContent = text;
  el.classList.toggle('err-text', !!isError);
}
async function saveNodeOrder(order) {
  if (!order.length) return;
  setNodeOrderStatus('Сохраняю порядок...', false);
  const response = await fetch('/nodes/reorder', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
    body: JSON.stringify({ order })
  });
  const data = await response.json().catch(() => ({}));
  if (!response.ok || !data.ok) throw new Error(data.error || 'Не удалось сохранить порядок');
  setNodeOrderStatus('Порядок сохранён', false);
  refreshMobileOrderControls();
}

function getNodeRows() {
  return [...document.querySelectorAll('#nodesOrderBody .node-list-row')];
}

let nodeCurrentPage = 1;

function getNodePageSize() {
  const list = document.getElementById('nodesOrderBody');
  const n = Number(list?.dataset.pageSize || 10);
  return [10, 12, 15].includes(n) ? n : 10;
}

function getFilteredNodeRows() {
  return getNodeRows().filter(row => !row.classList.contains('hidden-by-filter'));
}

function renderNodePagination() {
  const rows = getFilteredNodeRows();
  const pageSize = getNodePageSize();
  const total = rows.length;
  const totalPages = Math.max(1, Math.ceil(total / pageSize));
  if (nodeCurrentPage > totalPages) nodeCurrentPage = totalPages;
  if (nodeCurrentPage < 1) nodeCurrentPage = 1;
  const start = total ? (nodeCurrentPage - 1) * pageSize : 0;
  const end = total ? Math.min(start + pageSize, total) : 0;
  getNodeRows().forEach(row => {
    row.classList.remove('hidden-by-page');
    row.style.removeProperty('display');
  });
  rows.forEach((row, index) => {
    const hide = index < start || index >= end;
    row.classList.toggle('hidden-by-page', hide);
    if (hide) row.style.setProperty('display', 'none', 'important');
    else row.style.removeProperty('display');
  });
  const range = document.getElementById('nodesPageRange');
  if (range) range.textContent = total ? `${start + 1}–${end}` : '0–0';
  const count = document.getElementById('visibleNodesCount');
  if (count) count.textContent = String(total);
  const pager = document.getElementById('nodesPagination');
  if (pager) {
    pager.innerHTML = '';
    if (totalPages > 1) {
      const mk = (label, page, active, disabled) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = active ? 'is-active' : '';
        b.textContent = label;
        b.disabled = !!disabled;
        b.addEventListener('click', () => { nodeCurrentPage = page; renderNodePagination(); ensureSelectedNodeOnVisiblePage(); });
        return b;
      };
      pager.appendChild(mk('‹', Math.max(1, nodeCurrentPage - 1), false, nodeCurrentPage === 1));
      for (let i = 1; i <= totalPages; i += 1) pager.appendChild(mk(String(i), i, i === nodeCurrentPage, false));
      pager.appendChild(mk('›', Math.min(totalPages, nodeCurrentPage + 1), false, nodeCurrentPage === totalPages));
    }
  }
  refreshMobileOrderControls();
}

function ensureSelectedNodeOnVisiblePage() {
  const selected = getNodeRows().find(row => row.classList.contains('is-selected'));
  if (selected && !selected.classList.contains('hidden-by-filter') && !selected.classList.contains('hidden-by-page')) return;
  const first = getNodeRows().find(row => !row.classList.contains('hidden-by-filter') && !row.classList.contains('hidden-by-page'));
  if (first) selectNodeDetails(first.dataset.nodeId, { openMobile: false });
}

function getDesktopNodeOrder() {
  return getNodeRows().map(row => Number(row.dataset.nodeId)).filter(Boolean);
}

function getMobileNodeOrder() {
  return getDesktopNodeOrder();
}

function refreshMobileOrderControls() {
  const rows = getNodeRows();
  rows.forEach((row, index) => {
    const up = row.querySelector('[data-mobile-move="up"]');
    const down = row.querySelector('[data-mobile-move="down"]');
    if (up) up.disabled = index === 0;
    if (down) down.disabled = index === rows.length - 1;
  });
}

function isMobileNodesLayout() {
  return window.matchMedia && window.matchMedia('(max-width: 900px)').matches;
}

function isNodeDrawerLayout() {
  return window.matchMedia && window.matchMedia('(max-width: 1120px)').matches;
}

function closeNodeDetailsPanel(event) {
  if (event) {
    event.preventDefault();
    event.stopPropagation();
  }
  const layout = document.getElementById('nodesModernLayout');
  if (!layout) return false;
  layout.classList.remove('mobile-details-open', 'detail-open');
  if (!isNodeDrawerLayout()) layout.classList.add('details-hidden');
  return false;
}
window.closeNodeDetailsPanel = closeNodeDetailsPanel;

function selectNodeDetails(id, opts) {
  const layout = document.getElementById('nodesModernLayout');
  const openMobile = !!(opts && opts.openMobile);
  if (layout) {
    layout.classList.remove('details-hidden');
    const shouldOpenDrawer = isNodeDrawerLayout() && openMobile;
    layout.classList.toggle('detail-open', shouldOpenDrawer);
    layout.classList.toggle('mobile-details-open', shouldOpenDrawer && isMobileNodesLayout());
  }
  document.querySelectorAll('.node-list-row').forEach(row => {
    row.classList.toggle('is-selected', String(row.dataset.nodeId) === String(id));
  });
  document.querySelectorAll('.node-detail-card').forEach(card => {
    const active = String(card.dataset.detailNodeId) === String(id);
    card.classList.toggle('is-active', active);
    card.hidden = !active;
    if (active) card.style.removeProperty('display');
    else card.style.setProperty('display', 'none', 'important');
  });
}

function selectFirstVisibleNode() {
  const first = getNodeRows().find(row => !row.classList.contains('hidden-by-filter') && !row.classList.contains('hidden-by-page'));
  if (first) selectNodeDetails(first.dataset.nodeId, { openMobile: false });
}

function updateVisibleNodesCount() {
  const count = getNodeRows().filter(row => !row.classList.contains('hidden-by-filter')).length;
  const list = document.getElementById('nodesOrderBody');
  if (list) list.classList.toggle('is-empty-filter', count === 0);
  renderNodePagination();
}

function applyNodeFilters() {
  const q = String(document.getElementById('nodeSearchInput')?.value || '').trim().toLowerCase();
  const type = String(document.getElementById('nodeTypeFilter')?.value || 'all');
  const state = String(document.getElementById('nodeStateFilter')?.value || 'all');
  let selectedStillVisible = false;
  getNodeRows().forEach(row => {
    const matchesText = !q || String(row.dataset.nodeSearch || '').includes(q);
    const matchesType = type === 'all' || row.dataset.nodeType === type;
    const matchesState = state === 'all'
      || row.dataset.nodeEnabled === state
      || row.dataset.nodeActivity === state;
    const visible = matchesText && matchesType && matchesState;
    row.classList.toggle('hidden-by-filter', !visible);
    if (visible && row.classList.contains('is-selected')) selectedStillVisible = true;
  });
  nodeCurrentPage = 1;
  updateVisibleNodesCount();
  ensureSelectedNodeOnVisiblePage();
  if (!selectedStillVisible) {
    const first = getNodeRows().find(row => !row.classList.contains('hidden-by-filter') && !row.classList.contains('hidden-by-page'));
    if (first) selectNodeDetails(first.dataset.nodeId, { openMobile: false });
    else {
      document.querySelectorAll('.node-detail-card').forEach(card => { card.hidden = true; card.classList.remove('is-active'); });
    }
  }
}

function initNodeDetailsPanel() {
  document.addEventListener('click', event => {
    const selector = event.target.closest('[data-select-node]');
    if (selector) {
      event.preventDefault();
      if (isMobileNodesLayout()) {
        const editUrl = selector.dataset.nodeEditUrl || `/nodes/${encodeURIComponent(selector.dataset.selectNode)}/edit`;
        window.location.assign(editUrl);
        return;
      }
      selectNodeDetails(selector.dataset.selectNode, { openMobile: true });
      return;
    }
    const copy = event.target.closest('[data-copy-text]');
    if (copy) {
      const text = copy.dataset.copyText || '';
      if (navigator.clipboard && text && text !== '-') {
        navigator.clipboard.writeText(text).then(() => {
          copy.classList.add('copied');
          setTimeout(() => copy.classList.remove('copied'), 900);
        }).catch(() => {});
      }
    }
  });
  const close = document.getElementById('nodeDetailsClose');
  if (close) close.addEventListener('click', closeNodeDetailsPanel);
  ['nodeSearchInput', 'nodeTypeFilter', 'nodeStateFilter'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('input', applyNodeFilters);
    if (el) el.addEventListener('change', applyNodeFilters);
  });
  const reset = document.getElementById('nodeResetFilters');
  if (reset) reset.addEventListener('click', () => {
    const search = document.getElementById('nodeSearchInput');
    const type = document.getElementById('nodeTypeFilter');
    const state = document.getElementById('nodeStateFilter');
    if (search) search.value = '';
    if (type) type.value = 'all';
    if (state) state.value = 'all';
    applyNodeFilters();
  });
  updateVisibleNodesCount();
}

function initNodeDragOrder() {
  const body = document.getElementById('nodesOrderBody');
  if (!body) return;
  let dragged = null;
  function bindRow(row) {
    row.addEventListener('dragstart', event => {
      if (event.target.closest('button:not(.drag-handle), a, input, select, textarea')) {
        event.preventDefault();
        return;
      }
      dragged = row;
      row.classList.add('dragging');
      setNodeOrderStatus('Перемести строку и отпусти мышь', false);
    });
    row.addEventListener('dragend', () => {
      row.classList.remove('dragging');
      dragged = null;
    });
  }
  getNodeRows().forEach(bindRow);
  body.addEventListener('dragover', event => {
    event.preventDefault();
    if (!dragged) return;
    const rows = getNodeRows().filter(row => row !== dragged && !row.classList.contains('hidden-by-filter') && !row.classList.contains('hidden-by-page'));
    const next = rows.find(row => event.clientY <= row.getBoundingClientRect().top + row.getBoundingClientRect().height / 2);
    body.insertBefore(dragged, next || null);
  });
  body.addEventListener('drop', async event => {
    event.preventDefault();
    try {
      await saveNodeOrder(getDesktopNodeOrder());
      refreshMobileOrderControls();
    } catch (err) {
      setNodeOrderStatus(err.message || String(err), true);
    }
  });
}

function initMobileNodeOrder() {
  const list = document.getElementById('nodesOrderBody');
  if (!list) return;
  refreshMobileOrderControls();
  list.addEventListener('click', async event => {
    const button = event.target.closest('[data-mobile-move]');
    if (!button || button.disabled) return;
    const row = button.closest('.node-list-row');
    if (!row) return;
    const direction = button.dataset.mobileMove;
    if (direction === 'up' && row.previousElementSibling) {
      list.insertBefore(row, row.previousElementSibling);
    } else if (direction === 'down' && row.nextElementSibling) {
      list.insertBefore(row.nextElementSibling, row);
    } else {
      return;
    }
    refreshMobileOrderControls();
    try {
      await saveNodeOrder(getMobileNodeOrder());
    } catch (err) {
      setNodeOrderStatus(err.message || String(err), true);
    }
  });
}
function showLoading(title, text) {
  const modal = document.getElementById('loadingModal');
  if (!modal) return;
  document.getElementById('loadingTitle').textContent = title || 'Загрузка';
  document.getElementById('loadingText').textContent = text || 'Операция выполняется. Не закрывайте страницу.';
  modal.classList.remove('hidden');
}

let nodeAddProgressTimer = null;
function startNodeAddProgress(form) {
  const box = document.getElementById('nodeAddProgress');
  const bar = document.getElementById('nodeAddProgressBar');
  const percent = document.getElementById('nodeAddProgressPercent');
  const label = document.getElementById('nodeAddProgressLabel');
  const elapsed = document.getElementById('nodeAddElapsed');
  const eta = document.getElementById('nodeAddEta');
  if (!box || !bar || !percent || !label || !elapsed || !eta) return;
  box.hidden = false;
  const syncClients = Boolean(form.querySelector('[name="create_existing_clients_on_node"]:checked') || form.querySelector('[name="import_clients_from_node"]:checked'));
  const estimateSeconds = syncClients ? 95 : 35;
  const started = Date.now();
  const stages = syncClients
    ? [[8, 'Проверяю адрес и API'], [28, 'Читаю параметры inbound'], [48, 'Сохраняю подключение'], [68, 'Сверяю существующих клиентов'], [88, 'Добавляю отсутствующих клиентов']]
    : [[10, 'Проверяю адрес и API'], [38, 'Читаю параметры inbound'], [66, 'Сохраняю подключение'], [88, 'Завершаю проверку']];
  const render = () => {
    const seconds = Math.max(0, Math.floor((Date.now() - started) / 1000));
    const ratio = Math.min(.92, seconds / estimateSeconds);
    const value = Math.max(3, Math.round(ratio * 100));
    const stage = stages.reduce((current, item) => value >= item[0] ? item : current, stages[0]);
    bar.style.width = value + '%';
    percent.textContent = value + '%';
    label.textContent = stage[1];
    elapsed.textContent = `Прошло: ${seconds} сек.`;
    eta.textContent = ratio >= .92 ? 'Завершаю — ответ сервера может занять ещё немного времени' : `Осталось примерно: ${Math.max(1, estimateSeconds - seconds)} сек.`;
  };
  render();
  if (nodeAddProgressTimer) window.clearInterval(nodeAddProgressTimer);
  nodeAddProgressTimer = window.setInterval(render, 1000);
  window.addEventListener('beforeunload', () => {
    if (nodeAddProgressTimer) window.clearInterval(nodeAddProgressTimer);
    bar.style.width = '100%';
    percent.textContent = '100%';
    label.textContent = 'Готово';
  }, { once: true });
}

let nodeStatusRefreshPending = false;
async function refreshNodeStatuses() {
  if (nodeStatusRefreshPending || document.hidden) return;
  nodeStatusRefreshPending = true;
  try {
    const response = await fetch('/dashboard/node-status.json', { headers: { Accept: 'application/json' } });
    const data = await response.json();
    if (!response.ok || !data.ok) throw new Error(data.error || 'Не удалось проверить узлы');
    (data.checks || []).forEach(check => {
      const state = ['online', 'offline', 'disabled'].includes(String(check.status)) ? String(check.status) : 'unknown';
      const label = check.statusLabel || ({ online: 'В сети', offline: 'Не в сети', disabled: 'Отключён', unknown: 'Нет данных' })[state] || 'Нет данных';
      document.querySelectorAll(`[data-node-live-status="${check.nodeId}"]`).forEach(container => {
        container.closest('.node-list-row')?.setAttribute('data-node-activity', state);
        const badge = container.querySelector('[data-node-live-badge]');
        if (badge) {
          badge.className = `badge ${state}`;
          badge.textContent = label;
          badge.title = check.error || (check.ms ? `${check.ms} мс` : '');
        }
      });
      document.querySelectorAll(`[data-node-live-error="${check.nodeId}"]`).forEach(errorEl => {
        const text = String(check.error || '').trim();
        errorEl.textContent = text;
        errorEl.title = text;
        errorEl.classList.toggle('hidden', !text || state === 'online' || state === 'disabled');
      });
      document.querySelectorAll(`[data-node-detail-live-status="${check.nodeId}"]`).forEach(badge => {
        badge.className = `badge ${state}`;
        badge.textContent = label;
        badge.title = check.error || (check.ms ? `${check.ms} мс` : '');
      });
    });
    if (typeof applyNodeFilters === 'function') applyNodeFilters();
  } catch (err) {
    console.warn('Автопроверка узлов:', err);
    if (typeof window.showNexusNotice === 'function') window.showNexusNotice(err, 'err');
  } finally {
    nodeStatusRefreshPending = false;
  }
}
document.addEventListener('DOMContentLoaded', () => {
  initNodeDragOrder();
  initMobileNodeOrder();
  initNodeDetailsPanel();
  document.querySelectorAll('form.js-long-action').forEach(form => {
    form.addEventListener('submit', () => {
      showLoading(form.dataset.loadingTitle, form.dataset.loadingText);
      if (form.matches('[data-node-add-form]')) startNodeAddProgress(form);
    });
  });
  window.setTimeout(refreshNodeStatuses, 1500);
  window.setInterval(refreshNodeStatuses, 60000);
});
</script>

