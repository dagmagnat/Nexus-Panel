<%- include('partials_header',{pageTitle:'Оплата',pageSubtitle:'Тарифы, скидки, реквизиты и заявки на продление',activePage:'subscription-billing'}) %>
<% if(message){ %><div class="alert ok"><%= message %></div><% } if(error){ %><div class="alert err"><%= error %></div><% } %>
<section class="card"><h2>Настройки оплаты</h2><p class="muted">Клиент переводит деньги по банковской ссылке или номеру телефона. Продление выполняется после вашего подтверждения поступления.</p>
<form method="post" action="/subscription-billing/settings" class="form-grid">
<label class="field"><span><input type="checkbox" name="enabled" value="1" <%= config.enabled?'checked':'' %>> Включить приём заявок на оплату</span></label>
<label class="field"><span><input type="checkbox" name="selfService" value="1" <%= config.selfService?'checked':'' %>> Разрешить клиенту удалять свои устройства</span></label>
<label class="field half">Название кнопки оплаты<input name="button" maxlength="25" value="<%= config.button %>" required><small>Название раздела оплаты в кабинете.</small></label>
<% for(const [key,label,type,min,max] of [['monthlyRub','Базовая цена за месяц, ₽','text','',''],['deviceRub','Дополнительное устройство за месяц, ₽','text','',''],['includedDevices','Устройств включено','number',1,200],['maxDevices','Максимум устройств для покупки','number',1,200],['discount3','Скидка от 3 месяцев, %','number',0,90],['discount6','Скидка от 6 месяцев, %','number',0,90],['discount12','Скидка на 12 месяцев, %','number',0,90]]){ %><label class="field half"><%= label %><input name="<%= key %>" type="<%= type %>" min="<%= min %>" max="<%= max %>" value="<%= config[key] %>"></label><% } %>
<p class="hint field">1 месяц = 30 дней. Дополнительные устройства оплачиваются каждый месяц. Скидка применяется к общей стоимости выбранного срока; скидки не суммируются, 0 — выключена.</p>
<label class="field half">Телефон получателя<input name="phone" inputmode="tel" value="<%= config.phone %>" maxlength="30"></label><label class="field half">Банк получателя<input name="bank" value="<%= config.bank %>" maxlength="100"></label>
<label class="field">Ссылка, извлечённая из банковского QR-кода<input name="paymentUrl" type="url" value="<%= config.paymentUrl %>" placeholder="https://…"><small>Используйте исходную HTTPS-ссылку вашего банка. Банк определяет выбор приложения и заполнение суммы. QR-код в кабинете создаётся по этой же ссылке. Без неё клиенту показываются реквизиты для ручного перевода.</small></label>
<div class="field"><h3>Кнопка в личном кабинете</h3><p class="hint">Бесплатная настройка сайта: после окончания подписки кнопка станет красной. Стандартная кнопка «Сайт» в Happ/INCY открывает этот кабинет; её внешний вид определяется приложением.</p></div>
<% for(const [key,label] of [['activeButtonText','Название при активной подписке'],['expiredButtonText','Название после окончания']]){ %><label class="field half"><%= label %><input name="<%= key %>" maxlength="25" required value="<%= config[key] %>"></label><% } %>
<% for(const [key,label] of [['activeColor','Цвет активной кнопки'],['expiredColor','Цвет кнопки после окончания'],['activeTextColor','Текст активной кнопки'],['expiredTextColor','Текст кнопки после окончания']]){ %><label class="field half"><%= label %><input type="color" name="<%= key %>" value="<%= config[key] %>"></label><% } %>
<div class="field" style="display:flex;gap:14px;flex-wrap:wrap"><% for(const prefix of ['active','expired']){ %><button type="button" data-button-preview="<%= prefix %>" style="flex:1;min-width:220px;background:<%= config[prefix+'Color'] %>;color:<%= config[prefix+'TextColor'] %>"><%= config[prefix+'ButtonText'] %></button><% } %></div>
<div class="field"><button type="submit">Сохранить</button></div></form></section>
<section class="card"><h2>Заявки клиентов</h2><p class="muted">Нажатие клиентом «Я оплатил» не подтверждает перевод. Проверьте поступление в банке. Повторное подтверждение заказа не добавляет срок повторно.</p><div style="overflow:auto"><table><thead><tr><th>Клиент</th><th>Срок / устройства</th><th>Сумма</th><th>Статус</th><th>Действие</th></tr></thead><tbody>
<% for(const o of orders){ %><tr><td><%= o.login %><small style="display:block"><%= o.created_at %></small></td><td><%= o.months %> мес. · <%= o.devices %> устр.</td><td><%= money(o.amount) %></td><td><%= ({new:'Создан',review:'На проверке',confirmed:'Подтверждён'})[o.status] || o.status %><% if(o.sync_error){ %><small style="display:block"><%= o.sync_error %></small><% } %></td><td><form method="post" action="/subscription-billing/orders/<%= o.id %>/confirm" onsubmit="return confirm('Проверьте поступление денег и сумму в банке. Подтвердить продление и выбранный лимит устройств?')"><button type="submit"><%= o.status==='confirmed'?'Повторить синхронизацию':'Подтвердить поступление' %></button></form></td></tr><% } if(!orders.length){ %><tr><td colspan="5">Заявок пока нет.</td></tr><% } %></tbody></table></div></section>
<script>document.querySelectorAll('[data-button-preview]').forEach(b=>{const p=b.dataset.buttonPreview,f=b.closest('form');function refresh(){b.textContent=f.elements[p+'ButtonText'].value;b.style.background=f.elements[p+'Color'].value;b.style.color=f.elements[p+'TextColor'].value;}for(const k of ['ButtonText','Color','TextColor'])f.elements[p+k].addEventListener('input',refresh);});</script>
<%- include('partials_footer') %>
