  .routing-form .form-grid { display:grid !important; grid-template-columns:repeat(2,minmax(0,1fr)) !important; gap:13px 14px; }
  .routing-form .form-grid > .field { grid-column:1 / -1 !important; min-width:0; }
  .routing-form .form-grid > .field.half { grid-column:span 1 !important; }
  .routing-form .mode-grid { display:grid !important; grid-template-columns:repeat(2,minmax(0,1fr)) !important; }
  .routing-form .dns-preset-grid { display:grid !important; grid-template-columns:repeat(3,minmax(0,1fr)) !important; }
  .routing-node-picker-head span { display:grid !important; grid-template-columns:repeat(2,minmax(112px,1fr)); }
  .routing-node-picker-head button { width:100%; min-height:34px; display:inline-flex; align-items:center; justify-content:center; }
  .geodata-catalog-card { position: static; top: auto; align-self: stretch; width: 100%; }
  .geodata-toolbar { display:flex; gap:8px; flex-wrap:wrap; align-items:center; margin:10px 0 12px; }
  .geodata-toolbar input { flex:1 1 220px; min-width:0; }
  .geodata-status { font-size:12px; color: var(--muted); margin: 6px 0 10px; }
  .geodata-lists { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .geodata-list-box { border:1px solid rgba(130,170,220,.2); border-radius:16px; background:rgba(8,23,42,.26); overflow:hidden; }
  .geodata-list-head { display:flex; justify-content:space-between; gap:8px; align-items:center; padding:10px 12px; border-bottom:1px solid rgba(130,170,220,.16); }
  .geodata-list-head strong { font-size:14px; }
  .geodata-list-head small { color:var(--muted); white-space:nowrap; }
  .geodata-scroll { max-height:420px; overflow:auto; padding:8px; }
  .geodata-row { display:grid; grid-template-columns:minmax(0,1fr) auto auto auto auto; gap:6px; align-items:center; padding:7px; border-radius:12px; }
  .geodata-row:hover { background:rgba(96,165,250,.12); }
  .geodata-token { font-family:ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size:12px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; cursor:pointer; }
  .geodata-mini { border:1px solid rgba(130,170,220,.25); background:rgba(15,38,70,.75); color:var(--text); border-radius:10px; padding:5px 7px; font-size:11px; cursor:pointer; }
  .geodata-mini:hover { border-color:rgba(96,165,250,.75); }
  .geodata-mini.copy-ok { border-color:rgba(52,211,153,.75); }
  .geodata-help { margin-top:10px; font-size:12px; color:var(--muted); line-height:1.45; }
  .routing-mobile-view-tabs { display:none; }
  @media (max-width: 1120px) {
    .routing-page-grid { grid-template-columns:minmax(0,1fr) !important; }
  }
  @media (max-width: 900px) {
    .routing-mobile-view-tabs {
      position:sticky;
      top:58px;
      z-index:45;
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:5px;
      margin:0 0 10px;
      padding:5px;
      background:color-mix(in srgb, var(--surface) 94%, transparent);
      border:1px solid var(--line);
      border-radius:13px;
      backdrop-filter:blur(18px);
    }
    .routing-mobile-view-tabs button { min-height:38px; padding:7px 9px; color:var(--muted); background:transparent; border:0; box-shadow:none; font-size:12px; }
    .routing-mobile-view-tabs button.is-active { color:#fff; background:var(--brand-gradient); }
    .routing-page-grid { display:block !important; width:100%; min-width:0; }
    .routing-page-grid > section { width:100%; min-width:0; margin:0 0 11px; }
    .routing-page-grid[data-mobile-view="editor"] > .routing-summary-card { display:none !important; }
    .routing-page-grid[data-mobile-view="summary"] > .routing-editor-card,
    .routing-page-grid[data-mobile-view="summary"] > .geodata-catalog-card { display:none !important; }
    .routing-page-grid[data-mobile-view="summary"] > .routing-summary-card { display:block !important; position:static !important; }
    .routing-form .form-grid,
    .routing-form .mode-grid,
    .routing-form .dns-preset-grid { grid-template-columns:minmax(0,1fr) !important; }
    .routing-form .form-grid > .field.half { grid-column:1 / -1 !important; }
    .geodata-catalog-card { position:static; }
    .geodata-lists { grid-template-columns:1fr; }
    .geodata-scroll { max-height:280px; }
    .routing-editor-card,
    .routing-summary-card,
    .geodata-catalog-card { padding:12px !important; overflow:hidden; }
    .routing-editor-card h2,
    .routing-summary-card h2,
    .geodata-catalog-card h2 { font-size:17px; }
    .routing-form { gap:12px !important; }
    .routing-form h3 { margin:2px 0 -3px; font-size:13px; }
    .routing-form .switch-row,
    .routing-form .preset-card { padding:9px; }
    .routing-form .hint,
    .routing-form small,
    .routing-editor-card > .muted,
    .geodata-help { font-size:10.5px; line-height:1.42; }
    .routing-form textarea { min-height:104px; font-size:12px; line-height:1.42; }
    .routing-preview { max-width:100%; overflow:auto; font-size:10.5px; }
    .routing-summary-card .kv-item { grid-template-columns:1fr; gap:5px; padding:10px 0; }
  }
</style>

<% if (message) { %><div class="alert ok"><%= message %></div><% } %>
<% if (error) { %><div class="alert err"><%= error %></div><% } %>
<% if (directDnsError) { %><div class="alert err">Отдельный DNS direct не применён: <%= directDnsError %> Пока используется основной DNS; исправь параметры и сохрани форму.</div><% } %>

<nav class="routing-mobile-view-tabs" aria-label="Раздел маршрутизации">
  <button type="button" class="is-active" data-routing-mobile-view="editor">Настройка</button>
  <button type="button" data-routing-mobile-view="summary">Текущий итог</button>
</nav>

<div class="grid routing-page-grid" data-mobile-view="editor">
  <section class="card span-6 routing-editor-card">
    <h2>Маршрутизация JSON</h2>
    <p class="muted">Правила встраиваются непосредственно в каждый выбранный JSON-конфиг. Отдельный Happ routing-профиль настраивается независимо в разделе «Подписки и приложения».</p>
    <p class="hint">Работает для выбранных узлов 3x-ui и Remnawave через JSON-ссылку Nexus. Обычные VLESS/SUB-ссылки не содержат эти правила. Профили и серверная маршрутизация Remnawave не изменяются.</p>
    <% if (nodes.some(n => n.inbound_protocol === 'amneziawg')) { %>
      <div class="alert" role="note"><strong>AmneziaWG использует отдельный движок.</strong> Эти правила Xray не переносятся в AWG-конфигурацию: исключения Domain/GeoSite, DNS и блокировка рекламы не применяются к ней через эту форму. AWG-узлы ниже недоступны для выбора. Одна подписка может содержать оба протокола, но их способы маршрутизации различаются.</div>
    <% } %>

    <form method="post" action="/routing" class="routing-form">
      <input type="hidden" name="routing_dns_controls" value="1" />
      <label class="switch-row">
        <input type="checkbox" name="routing_enabled" value="1" <%= routingEnabled ? 'checked' : '' %> />
        <span><strong>Использовать маршрутизацию</strong><small>Если выключить, Nexus не добавляет свои правила; маршрут определяется конфигурацией и режимом приложения.</small></span>
      </label>

      <div class="section-title-row">
        <h3>Правила по списку</h3>
        <button type="button" class="btn-secondary" id="routing-add-rule">+ Добавить правило</button>
      </div>
      <p class="hint">У каждого правила свои узлы, список и DNS. Узел можно выбрать в одном правиле. Автовыбор с узлами из разных правил использует общую схему маршрутизации.</p>
      <input type="hidden" name="routing_groups" id="routing-groups-payload" />
      <% const emptyRule = { mode: 'node-selective', nodeIds: [], domains: [], ips: [], directDnsEnabled: false, directDnsPreset: 'doh_yandex', directDnsCustom: '' }; %>
      <div class="routing-mode-assignments" id="routing-rule-list">
      <% [...routingGroups, emptyRule].forEach((rule, index) => {
        const template = index === routingGroups.length;
        if (template) { %></div><template id="routing-rule-template"><% } %>
        <section class="routing-mode-assignment is-enabled" data-routing-mode-card>
          <div class="routing-node-picker-head routing-rule-heading">
            <strong data-routing-rule-title>Правило <%= index + 1 %></strong>
            <button type="button" class="btn-secondary" data-routing-remove-rule aria-label="Убрать правило <%= index + 1 %>">Убрать</button>
          </div>
          <div class="routing-mode-node-picker">
            <fieldset class="routing-rule-modes">
              <legend>Что направлять через VPN</legend>
              <label><input type="radio" name="rule-mode-<%= index %>" value="node-selective" <%= rule.mode === 'node-selective' ? 'checked' : '' %> /> Только по списку</label>
              <label><input type="radio" name="rule-mode-<%= index %>" value="proxy-except" <%= rule.mode === 'proxy-except' ? 'checked' : '' %> /> Всё, кроме списка</label>
            </fieldset>
            <p class="hint" data-routing-mode-help></p>
            <div class="routing-node-picker-head"><strong>Узлы правила</strong><span><button type="button" data-routing-select-all>Все доступные</button><button type="button" data-routing-clear>Снять</button></span></div>
            <div class="routing-node-checkboxes">
              <% nodes.forEach(n => { const unavailable = n.inbound_protocol === 'amneziawg'; %>
                <label data-routing-node-option data-routing-unsupported="<%= unavailable ? '1' : '0' %>">
                  <input type="checkbox" value="<%= n.id %>" <%= unavailable ? 'disabled' : (rule.nodeIds.includes(Number(n.id)) ? 'checked' : '') %> />
                  <span><%- flagHtml(n.country_code, n.country_flag, n.country_name_ru || n.name) %><strong><%= n.name %><%= n.label_suffix && !String(n.name).includes(n.label_suffix) ? ' · ' + n.label_suffix : '' %></strong><small><%= unavailable ? 'AmneziaWG' : n.transport_label || '' %><%= Number(n.enabled) === 0 ? ' · отключён' : '' %></small></span>
                </label>
              <% }) %>
            </div>
            <div class="routing-mode-rules">
              <div class="form-grid">
                <label class="field half"><span>Домены / GeoSite</span><textarea data-rule-domains rows="5" placeholder="domain:example.ru&#10;geosite:category-ru"><%= rule.domains.join(String.fromCharCode(10)) %></textarea></label>
                <label class="field half"><span>IP / CIDR / GeoIP</span><textarea data-rule-ips rows="5" placeholder="geoip:ru&#10;192.0.2.0/24"><%= rule.ips.join(String.fromCharCode(10)) %></textarea></label>
              </div>
              <label class="switch-row routing-rule-dns-toggle">
                <input type="checkbox" data-rule-dns-enabled <%= rule.directDnsEnabled ? 'checked' : '' %> />
                <span><strong>Отдельный DNS для доменов списка</strong><small>У доменов и GeoSite из этого списка приоритет над основным DNS. Записи IP и GeoIP влияют на маршрут.</small></span>
              </label>
              <div class="form-grid" data-rule-dns-fields <%= rule.directDnsEnabled ? '' : 'hidden' %>>
                <label class="field half"><span>Набор DNS</span>
                  <select data-rule-dns-preset>
                    <% [['doh_yandex','Яндекс DoH'], ['yandex','Яндекс · UDP/53'], ['cloudflare','Cloudflare · UDP/53'], ['google','Google · UDP/53'], ['manual','Только вручную']].forEach(([value,label]) => { %>
                      <option value="<%= value %>" <%= rule.directDnsPreset === value ? 'selected' : '' %>><%= label %></option>
                    <% }) %>
                  </select>
                </label>
                <label class="field half"><span>Ручные DNS</span><textarea data-rule-dns-custom rows="3" placeholder="77.88.8.8&#10;https://common.dot.dns.yandex.net/dns-query"><%= rule.directDnsCustom %></textarea></label>
              </div>
            </div>
          </div>
        </section>
        <% if (template) { %></template><% }
      }) %>

      <section class="routing-mode-rules routing-mode-rules-proxy" id="routing-force-proxy">
        <h3>Всегда через VPN · общий список</h3>
        <p class="hint">Общий список для всех узлов с правилами. Эти домены и IP идут через VPN даже при совпадении с исключением. Блокировки проверяются первыми. Чтобы список действовал только на части узлов, внесите его в конкретное правило выше.</p>
        <div class="form-grid">
          <div class="field half"><label for="force-proxy-domains">Домены / GeoSite → всегда через VPN</label><textarea id="force-proxy-domains" name="custom_domains" rows="6" placeholder="domain:example.ru&#10;full:service.example.ru"><%= customDomainsText %></textarea><small class="hint">По одному в строке. <code>domain:example.ru</code> включает поддомены, <code>full:</code> — точное имя. Также поддерживаются <code>geosite:</code>, <code>regexp:</code> и <code>keyword:</code>.</small></div>
          <div class="field half"><label for="force-proxy-ips">IP / CIDR / GeoIP → всегда через VPN</label><textarea id="force-proxy-ips" name="custom_ips" rows="6" placeholder="203.0.113.10/32&#10;203.0.113.0/24&#10;2001:db8::/32"><%= customIpsText %></textarea><small class="hint">IPv4/IPv6, подсеть CIDR или <code>geoip:</code>, по одному в строке. IP-правило не определяет DNS по имени; если известен домен, добавьте и его. Сохраните и обновите JSON-подписку в приложении.</small></div>
        </div>
      </section>

      <h3>Блокировка рекламы</h3>
      <label class="switch-row">
        <input type="checkbox" name="adblock_enabled" value="1" <%= adBlockEnabled ? 'checked' : '' %> />
        <span><strong>Включить блокировку рекламы</strong><small>Опция выключена по умолчанию. Широкие рекламные списки могут задевать служебные домены, уведомления и CDN мобильных приложений.</small></span>
      </label>
      <div class="form-grid">
        <div class="field half">
          <label>Блокировать domain / geosite</label>
          <textarea name="adblock_domains" rows="6" placeholder="geosite:category-ads-all&#10;domain:ads.example.com"><%= adBlockDomainsText || '' %></textarea>
          <small class="hint">Можно удалить, изменить или добавить свои правила. Поддерживается <code>geosite:</code>, <code>domain:</code>, <code>regexp:</code>, <code>keyword:</code>, <code>full:</code>.</small>
        </div>
        <div class="field half">
          <label>Блокировать ip / geoip</label>
          <textarea name="adblock_ips" rows="6" placeholder="geoip:private&#10;1.2.3.0/24"><%= adBlockIpsText || '' %></textarea>
          <small class="hint">Обычно достаточно domain/geosite. IP/geoip блокировку добавляй только если точно знаешь, что нужно заблокировать.</small>
        </div>
      </div>

      <h3>GeoSite / GeoIP источники</h3>
      <div class="alert ok" style="margin-top:12px;">Источник выбирается отдельно: универсальный <strong>Loyalsoldier</strong>, обновляемые российские списки <strong>runetfreedom</strong>, локальные данные клиента или свои URL. Эти данные используются обычной JSON-маршрутизацией; отдельный Happ-профиль получает их только при ручном включении.</div>
      <div class="form-grid">
        <div class="field">
          <label>Основной источник GeoData</label>
          <select name="geodata_source" id="geodata-source" onchange="syncGeoSourceFields()">
            <option value="official" <%= geodataSource === 'official' ? 'selected' : '' %>>Официальный / локальный источник клиента</option>
            <option value="loyalsoldier" <%= geodataSource === 'loyalsoldier' ? 'selected' : '' %>>Loyalsoldier / V2Ray rules dat</option>
            <option value="russia" <%= geodataSource === 'russia' ? 'selected' : '' %>>Russia rules / runetfreedom</option>
            <option value="custom" <%= geodataSource === 'custom' ? 'selected' : '' %>>Свои URL</option>
          </select>
          <small class="hint">Russia rules обновляется автором каждые 6 часов и содержит <code>ru-blocked</code>, <code>ru-blocked-community</code>, <code>ru-whitelist</code> и другие российские категории. Кнопка обновления справочника ниже принудительно перечитывает актуальные списки.</small>
        </div>
        <div class="field half">
          <label>GeoSite URL</label>
          <input id="geosite-url" name="geosite_url" value="<%= geositeUrl || '' %>" placeholder="Необязательно: ссылка на geosite.dat" />
          <small class="hint">Файл доменных списков geosite.dat.</small>
        </div>
        <div class="field half">
          <label>GeoIP URL</label>
          <input id="geoip-url" name="geoip_url" value="<%= geoipUrl || '' %>" placeholder="Необязательно: ссылка на geoip.dat" />
          <small class="hint">Файл IP-списков geoip.dat.</small>
        </div>
      </div>
      <div class="field">
        <label>Дополнительные ссылки / заметки</label>
        <textarea name="geodata_urls" rows="3" placeholder="Необязательно. Можно вставить дополнительные ссылки или заметки."><%= geodataUrlsText %></textarea>
        <small class="hint">Здесь можно хранить дополнительные ссылки/заметки. Для клиентской маршрутизации через провайдера важно, чтобы сам клиент понимал выбранные GeoData. Для серверной маршрутизации Xray эти же URL нужно добавлять в оригинальную 3x-ui отдельно.</small>
      </div>
      <div class="alert ok" style="margin-top:12px;">
        <strong>Обычный JSON работает независимо от Happ routing.</strong> Текущий отдельный Happ-профиль: <%= happRoutingProfileEnabled ? 'включён' : 'выключен' %>. Изменить его можно в <a href="/settings#happ-control-app">«Настройки → Подписки и приложения»</a>.
      </div>

      <div class="preset-grid dns-preset-grid">
        <button type="button" class="btn-secondary" onclick="setGeoPreset('loyal')">Loyalsoldier / Happ</button>
        <button type="button" class="btn-secondary" onclick="setGeoPreset('ru')">Russia rules</button>
        <button type="button" class="btn-secondary" onclick="setGeoPreset('iran')">Iran rules</button>
      </div>

      <h3>Распознавание доменов · проверка совместимости</h3>
      <label class="switch-row">
        <input type="checkbox" name="sniffing_route_only" value="1" <%= sniffingRouteOnly ? 'checked' : '' %> />
        <span><strong>routeOnly — только выбирать маршрут, не подменять адрес</strong><small>Включено: Xray распознаёт домен для правил, но сохраняет исходный адрес назначения. Выключено: sniffing также может заменить адрес распознанным доменом. Для сравнения обнови JSON и переподключись. Это не проверка доступности сервера и не переключатель всего трафика на direct.</small></span>
      </label>
      <p class="hint">Применяется к включённому sniffing только в JSON выбранных для маршрутизации узлов, в том числе обычных и каскадных. Не меняет серверный inbound, URI/SUB и отдельный Happ routing-профиль.</p>

      <h3>Основной DNS для JSON-подписки</h3>
      <p class="hint">Используется для доменов без отдельного DNS в правиле. Включённый DNS списка имеет приоритет для совпавших доменов. Эти настройки применяются к DNS-запросам, которые обрабатывает клиент.</p>
      <div class="form-grid">
        <div class="field half">
          <label>Готовый набор DNS</label>
          <select name="dns_preset">
            <option value="cloudflare-google" <%= dnsPreset === 'cloudflare-google' ? 'selected' : '' %>>Cloudflare + Google</option>
            <option value="cloudflare" <%= dnsPreset === 'cloudflare' ? 'selected' : '' %>>Cloudflare</option>
            <option value="google" <%= dnsPreset === 'google' ? 'selected' : '' %>>Google</option>
            <option value="quad9" <%= dnsPreset === 'quad9' ? 'selected' : '' %>>Quad9</option>
            <option value="yandex" <%= dnsPreset === 'yandex' ? 'selected' : '' %>>Yandex DNS</option>
            <option value="doh_cloudflare" <%= dnsPreset === 'doh_cloudflare' ? 'selected' : '' %>>Cloudflare DoH</option>
            <option value="doh_google" <%= dnsPreset === 'doh_google' ? 'selected' : '' %>>Google DoH</option>
            <option value="manual" <%= dnsPreset === 'manual' ? 'selected' : '' %>>Только вручную</option>
          </select>
        </div>
        <div class="field half">
          <label>Ручные DNS / DoH / DoT</label>
          <textarea name="dns_custom" rows="4" placeholder="1.1.1.1&#10;https://cloudflare-dns.com/dns-query&#10;tls://dns.google"><%= dnsCustomText || '' %></textarea>
        </div>
      </div>

      <div class="actions">
        <button type="submit">Сохранить и применить</button>
      </div>
    </form>
  </section>

  <section class="card span-6 routing-summary-card">
    <h2>Текущий итог</h2>
    <div class="alert"><strong>routeOnly:</strong> <%= sniffingRouteOnly ? 'Включён · адрес не подменяется' : 'Выключен · прежнее поведение sniffing' %></div>
    <div class="kv-list">
      <div class="kv-item">
        <strong>JSON-ссылка</strong>
        <div class="muted"><code><%= jsonUrlExample %></code></div>
      </div>
      <div class="kv-item">
        <strong>Правила и узлы</strong>
        <% routingGroups.forEach((rule, index) => { %>
          <div class="muted"><b><%= index + 1 %>. <%= rule.mode === 'proxy-except' ? 'Всё, кроме списка' : 'Только по списку' %></b>
            <div><%= nodes.filter(node => rule.nodeIds.includes(Number(node.id))).map(node => node.name).join(', ') || 'Нет доступных узлов' %></div>
            <div>Позиций в списке: <%= rule.domains.length + rule.ips.length %> · DNS: <%= rule.directDnsEnabled ? 'отдельный' : 'основной' %></div>
          </div>
        <% }) %>
      </div>
      <div class="kv-item">
        <strong>Happ routing-профиль</strong>
        <div class="muted"><%= happRoutingProfileEnabled ? 'Включён отдельно · header routing + body link' : 'Выключен · на обычный JSON не влияет' %></div>
        <div class="muted"><code><%= happRoutingJsonExample %></code></div>
      </div>
      <div class="kv-item">
        <strong>0. Сначала блокировка рекламы</strong>
        <% if (blockDomains.length || blockIps.length) { %>
          <% if (blockDomains.length) { %><pre class="routing-preview"><%= blockDomains.join('\n') %></pre><% } %>
          <% if (blockIps.length) { %><pre class="routing-preview"><%= blockIps.join('\n') %></pre><% } %>
        <% } else { %>
          <div class="muted">Блокировка рекламы выключена или список пуст.</div>
        <% } %>
      </div>
      <div class="kv-item">
        <strong>1. Сначала через proxy / VPN</strong>
        <% if (proxyDomains.length || proxyIps.length) { %>
          <% if (proxyDomains.length) { %><pre class="routing-preview"><%= proxyDomains.join('\n') %></pre><% } %>
          <% if (proxyIps.length) { %><pre class="routing-preview"><%= proxyIps.join('\n') %></pre><% } %>
        <% } else { %>
          <div class="muted">Нет приоритетных правил VPN.</div>
        <% } %>
      </div>
      <div class="kv-item">
        <strong>Всё остальное</strong>
        <div class="muted">За пределами списка трафик идёт напрямую в режиме «Только по списку» и через VPN в режиме «Всё, кроме списка».</div>
      </div>
    </div>
  </section>

  <section class="card span-12 geodata-catalog-card">
    <h2>Справочник GeoSite / GeoIP</h2>
    <p class="muted">Компактный список тегов из источников Happ / Loyalsoldier. Найдите категорию и добавьте её в правило, в общий список VPN или в блокировку.</p>
    <div class="geodata-toolbar">
      <label>Куда добавить запись <select id="routing-catalog-target"><option value="">Всегда через VPN</option></select></label>
      <input id="geodata-search" type="search" placeholder="Поиск: mail, meta, viber, ru, telegram..." oninput="renderGeodataCatalog()" />
      <button type="button" class="btn-secondary" onclick="loadGeodataCatalog(true)">Обновить список</button>
    </div>
    <div id="geodata-status" class="geodata-status">Загружаю справочник...</div>
    <div class="geodata-lists">
      <div class="geodata-list-box">
        <div class="geodata-list-head"><strong>GeoSite</strong><small id="geosite-count">0</small></div>
        <div id="geosite-list" class="geodata-scroll"></div>
      </div>
      <div class="geodata-list-box">
        <div class="geodata-list-head"><strong>GeoIP</strong><small id="geoip-count">0</small></div>
        <div id="geoip-list" class="geodata-scroll"></div>
      </div>
    </div>
    <div class="geodata-help">
      Справочник помогает найти теги из Loyalsoldier/V2Ray lists. Нажми VPN/DIRECT, чтобы добавить правило в нужный список, или скопируй вручную. Блокировка рекламы добавляется отдельным списком выше.
    </div>
  </section>
</div>

<script>
let geodataCatalog = { geosite: [], geoip: [], notes: [] };
const LOYAL_GEOSITE_URL = 'https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat';
const LOYAL_GEOIP_URL = 'https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat';
const RUSSIA_GEOSITE_URL = 'https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/release/geosite.dat';
const RUSSIA_GEOIP_URL = 'https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/release/geoip.dat';

function routingRuleCards() {
  return [...document.querySelectorAll('#routing-rule-list [data-routing-mode-card]')];
}
function syncRoutingModeAssignments() {
  const cards = routingRuleCards();
  const owners = new Map();
  const catalog = document.getElementById('routing-catalog-target');
  const selected = catalog?.value || '';
  catalog?.replaceChildren(new Option('Всегда через VPN', ''));

  cards.forEach((card, index) => {
    const title = `Правило ${index + 1}`;
    card.querySelector('[data-routing-rule-title]').textContent = title;
    card.querySelector('[data-routing-remove-rule]').setAttribute('aria-label', `Убрать правило ${index + 1}`);
    catalog?.add(new Option(title, String(index + 1)));
    const except = card.querySelector('input[type="radio"]:checked')?.value === 'proxy-except';
    const customDns = card.querySelector('[data-rule-dns-enabled]').checked;
    const routeHelp = except ? 'Список идёт напрямую, остальной трафик — через VPN.' : 'Список идёт через VPN, остальной трафик — напрямую.';
    const dnsHelp = customDns ? (except ? 'DNS списка тоже идёт напрямую.' : 'DNS списка тоже идёт через VPN.') : 'Используется основной DNS.';
    card.querySelector('[data-routing-mode-help]').textContent = `${routeHelp} ${dnsHelp}`;
    card.querySelector('[data-rule-dns-fields]').hidden = !customDns;
    card.querySelectorAll('[data-routing-node-option] input:checked').forEach(input => owners.set(input.value, card));
  });
  if (catalog && Number(selected) <= cards.length) catalog.value = selected;
  cards.forEach(card => {
    card.querySelectorAll('[data-routing-node-option]').forEach(option => {
      const input = option.querySelector('input');
      const owner = owners.get(input.value);
      const unsupported = option.dataset.routingUnsupported === '1';
      input.disabled = unsupported || (!!owner && owner !== card);
      option.classList.toggle('is-unavailable', input.disabled);
      option.title = unsupported ? 'Маршрутизация Xray недоступна для AmneziaWG' : (input.disabled ? 'Узел выбран в другом правиле' : '');
    });
  });
  const add = document.getElementById('routing-add-rule');
  if (add) add.disabled = cards.length >= 30;
}

function initRoutingModeAssignments() {
  const form = document.querySelector('.routing-form');
  const list = document.getElementById('routing-rule-list');
  if (!form || !list) return;
  let sequence = routingRuleCards().length;
  const addRule = () => {
    if (routingRuleCards().length >= 30) return;
    const fragment = document.getElementById('routing-rule-template').content.cloneNode(true);
    fragment.querySelectorAll('input[type="radio"]').forEach(input => { input.name = `rule-mode-${sequence}`; });
    sequence++;
    const card = fragment.firstElementChild;
    list.append(fragment);
    syncRoutingModeAssignments();
    card.querySelector('input[type="radio"]:checked')?.focus();
  };
  document.getElementById('routing-add-rule').addEventListener('click', addRule);
  list.addEventListener('change', syncRoutingModeAssignments);
  list.addEventListener('click', event => {
    const card = event.target.closest('[data-routing-mode-card]');
    if (!card) return;
    if (event.target.closest('[data-routing-remove-rule]')) {
      card.remove();
      document.getElementById('routing-catalog-target').value = '';
    } else if (event.target.closest('[data-routing-select-all]')) {
      card.querySelectorAll('[data-routing-node-option] input:not(:disabled)').forEach(input => { input.checked = true; });
    } else if (event.target.closest('[data-routing-clear]')) {
      card.querySelectorAll('[data-routing-node-option] input').forEach(input => { input.checked = false; });
    } else return;
    syncRoutingModeAssignments();
  });
  form.addEventListener('submit', event => {
    const cards = routingRuleCards();
    const rules = cards.map(card => ({
      mode: card.querySelector('input[type="radio"]:checked')?.value,
      nodeIds: [...card.querySelectorAll('[data-routing-node-option] input:checked:not(:disabled)')].map(input => Number(input.value)),
      domains: card.querySelector('[data-rule-domains]').value,
      ips: card.querySelector('[data-rule-ips]').value,
      directDnsEnabled: card.querySelector('[data-rule-dns-enabled]').checked,
      directDnsPreset: card.querySelector('[data-rule-dns-preset]').value,
      directDnsCustom: card.querySelector('[data-rule-dns-custom]').value
    }));
    const invalid = rules.findIndex(rule => !rule.nodeIds.length);
    if (invalid !== -1 || (!rules.length && form.querySelector('[name="routing_enabled"]').checked)) {
      event.preventDefault();
      alert(invalid !== -1 ? 'Выберите узлы для каждого правила или уберите пустое правило.' : 'Добавьте хотя бы одно правило.');
      cards[invalid]?.scrollIntoView({ block:'center' });
      return;
    }
    document.getElementById('routing-groups-payload').value = JSON.stringify(rules);
  });
  syncRoutingModeAssignments();
}

function syncGeoSourceFields() {
  const source = document.getElementById('geodata-source')?.value || 'loyalsoldier';
  const geosite = document.getElementById('geosite-url');
  const geoip = document.getElementById('geoip-url');
  if (!geosite || !geoip) return;
  if (source === 'loyalsoldier') {
    geosite.value = LOYAL_GEOSITE_URL;
    geoip.value = LOYAL_GEOIP_URL;
    geosite.readOnly = true;
    geoip.readOnly = true;
  } else if (source === 'russia') {
    geosite.value = RUSSIA_GEOSITE_URL;
    geoip.value = RUSSIA_GEOIP_URL;
    geosite.readOnly = true;
    geoip.readOnly = true;
  } else if (source === 'official') {
    geosite.value = '';
    geoip.value = '';
    geosite.readOnly = true;
    geoip.readOnly = true;
  } else {
    geosite.readOnly = false;
    geoip.readOnly = false;
  }
}


function setGeoPreset(kind) {
  const presets = {
    loyal: ['loyalsoldier', LOYAL_GEOSITE_URL, LOYAL_GEOIP_URL],
    ru: ['russia', RUSSIA_GEOSITE_URL, RUSSIA_GEOIP_URL],
    iran: ['custom', 'https://github.com/chocolate4u/Iran-v2ray-rules/releases/latest/download/geosite.dat', 'https://github.com/chocolate4u/Iran-v2ray-rules/releases/latest/download/geoip.dat']
  };
  const chosen = presets[kind];
  if (!chosen) return;
  const source = document.getElementById('geodata-source');
  const geosite = document.querySelector('input[name="geosite_url"]');
  const geoip = document.querySelector('input[name="geoip_url"]');
  if (source) source.value = chosen[0];
  if (geosite) geosite.value = chosen[1];
  if (geoip) geoip.value = chosen[2];
  syncGeoSourceFields();
}

function appendRoutingLine(textareaName, value) {
  const area = typeof textareaName === 'string' ? document.querySelector(`textarea[name="${textareaName}"]`) : textareaName;
  if (!area || !value) return;
  const lines = area.value.split(/\n+/).map(v => v.trim()).filter(Boolean);
  if (!lines.includes(value)) lines.push(value);
  area.value = lines.join('\n');
  area.dispatchEvent(new Event('input', { bubbles: true }));
  area.dispatchEvent(new Event('change', { bubbles: true }));
  area.focus();
  area.scrollTop = area.scrollHeight;
}

async function copyGeodataToken(value, button) {
  try {
    await navigator.clipboard.writeText(value);
    if (button) {
      button.classList.add('copy-ok');
      const old = button.textContent;
      button.textContent = 'OK';
      setTimeout(() => { button.classList.remove('copy-ok'); button.textContent = old; }, 900);
    }
  } catch (_) {
    window.prompt('Скопируй строку:', value);
  }
}

function makeGeoRow(item, kind) {
  const row = document.createElement('div');
  row.className = 'geodata-row';
  const value = item.value || `${kind}:${item.tag}`;

  const token = document.createElement('div');
  token.className = 'geodata-token';
  token.title = 'Нажми, чтобы скопировать';
  token.textContent = value;
  token.onclick = () => copyGeodataToken(value, null);
  row.appendChild(token);

  const copy = document.createElement('button');
  copy.type = 'button';
  copy.className = 'geodata-mini';
  copy.textContent = 'copy';
  copy.onclick = () => copyGeodataToken(value, copy);
  row.appendChild(copy);

  const vpn = document.createElement('button');
  vpn.type = 'button';
  vpn.className = 'geodata-mini';
  vpn.textContent = 'VPN';
  vpn.onclick = () => appendRoutingLine(kind === 'geosite' ? 'custom_domains' : 'custom_ips', value);
  row.appendChild(vpn);

  const direct = document.createElement('button');
  direct.type = 'button';
  direct.className = 'geodata-mini';
  direct.textContent = 'В правило';
  direct.onclick = () => {
    const index = Number(document.getElementById('routing-catalog-target').value) - 1;
    const card = routingRuleCards()[index];
    if (!card) { alert('Выберите правило в списке над справочником.'); return; }
    appendRoutingLine(card.querySelector(kind === 'geosite' ? '[data-rule-domains]' : '[data-rule-ips]'), value);
  };
  row.appendChild(direct);

  const block = document.createElement('button');
  block.type = 'button';
  block.className = 'geodata-mini';
  block.textContent = 'BLOCK';
  block.onclick = () => appendRoutingLine(kind === 'geosite' ? 'adblock_domains' : 'adblock_ips', value);
  row.appendChild(block);

  return row;
}

function renderGeoList(kind) {
  const box = document.getElementById(kind === 'geosite' ? 'geosite-list' : 'geoip-list');
  const counter = document.getElementById(kind === 'geosite' ? 'geosite-count' : 'geoip-count');
  if (!box) return;
  const q = (document.getElementById('geodata-search')?.value || '').trim().toLowerCase();
  const items = (geodataCatalog[kind] || []).filter(item => {
    const value = String(item.value || item.tag || '').toLowerCase();
    return !q || value.includes(q);
  });
  if (counter) counter.textContent = `${items.length}/${(geodataCatalog[kind] || []).length}`;
  box.innerHTML = '';
  items.slice(0, 300).forEach(item => box.appendChild(makeGeoRow(item, kind)));
  if (items.length > 300) {
    const tail = document.createElement('div');
    tail.className = 'geodata-status';
    tail.textContent = `Показаны первые 300. Уточни поиск, чтобы сузить список.`;
    box.appendChild(tail);
  }
  if (!items.length) {
    const empty = document.createElement('div');
    empty.className = 'muted';
    empty.style.padding = '12px';
    empty.textContent = 'Ничего не найдено.';
    box.appendChild(empty);
  }
}

function renderGeodataCatalog() {
  renderGeoList('geosite');
  renderGeoList('geoip');
}

async function loadGeodataCatalog(refresh) {
  const status = document.getElementById('geodata-status');
  if (status) status.textContent = refresh ? 'Обновляю список с GitHub...' : 'Загружаю справочник...';
  try {
    const resp = await fetch('/routing/geodata-index' + (refresh ? '?refresh=1' : ''), { cache: 'no-store' });
    const data = await resp.json();
    geodataCatalog = data || { geosite: [], geoip: [], notes: [] };
    renderGeodataCatalog();
    const updated = data.updatedAt ? new Date(data.updatedAt).toLocaleString() : '';
    if (status) status.textContent = `${data.source || 'catalog'}${data.cached ? ' · cache' : ''}${updated ? ' · ' + updated : ''}`;
  } catch (err) {
    if (status) status.textContent = 'Не удалось загрузить справочник: ' + (err && err.message ? err.message : err);
  }
}

function setupRoutingMobileViews() {
  const tabs = document.querySelector('.routing-mobile-view-tabs');
  const grid = document.querySelector('.routing-page-grid');
  if (!tabs || !grid) return;
  tabs.addEventListener('click', event => {
    const button = event.target.closest('[data-routing-mobile-view]');
    if (!button) return;
    const view = button.dataset.routingMobileView === 'summary' ? 'summary' : 'editor';
    grid.dataset.mobileView = view;
    tabs.querySelectorAll('[data-routing-mobile-view]').forEach(item => item.classList.toggle('is-active', item === button));
    if (window.matchMedia('(max-width: 900px)').matches) tabs.scrollIntoView({ block: 'start', behavior: 'smooth' });
  });
}

document.addEventListener('DOMContentLoaded', () => {
  setupRoutingMobileViews();
  initRoutingModeAssignments();
  loadGeodataCatalog(false);
});
</script>
<%- include('partials_footer') %>
