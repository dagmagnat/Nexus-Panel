  .routing-rule-modes label { display:flex; align-items:center; gap:6px; cursor:pointer; }
  #routing-rule-list > .routing-mode-assignment > .routing-rule-heading {
    display:grid; grid-template-columns:minmax(max-content, 1fr) auto; align-items:center;
    gap:8px 12px; margin:0 14px 8px; padding:8px 0;
    border-bottom:1px solid var(--line);
  }
  #routing-rule-list [data-routing-rule-title] {
    justify-self:start; white-space:nowrap; font-size:14px;
    padding:4px 8px; border-radius:7px; background:var(--surface-strong);
  }
  #routing-rule-list > .routing-mode-assignment > .routing-rule-heading > button {
    width:auto; min-width:0; min-height:36px; padding:4px 12px; white-space:nowrap; justify-self:end;
