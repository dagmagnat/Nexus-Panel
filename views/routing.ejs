    padding:0; color:var(--text); font-weight:650;
  }
  #routing-rule-list .routing-rule-modes input {
    flex:none; margin:0;
  }
  #routing-rule-list [data-routing-mode-help] {
    margin:0 0 12px; padding:9px 11px;
    border-inline-start:3px solid var(--blue); border-radius:6px;
    background:var(--info-soft);
    color:var(--text); font-size:12px; line-height:1.5;
  }
  #routing-rule-list .routing-rule-dns-toggle { margin-top:12px; }
  #routing-rule-list [data-rule-dns-fields] {
    margin-block-start:12px !important; gap:12px 18px !important;
  }
  #routing-rule-list [data-rule-dns-fields] > label { display:grid; align-content:start; gap:6px; }
  @media (max-width:640px) {
    #routing-rule-list > .routing-mode-assignment > .routing-rule-heading > button { min-height:44px; }
  }
  [data-rule-dns-fields][hidden] { display:none !important; }
  .routing-page-grid { display:grid !important; grid-template-columns:minmax(0,3fr) minmax(360px,2fr) !important; align-items:start; }
